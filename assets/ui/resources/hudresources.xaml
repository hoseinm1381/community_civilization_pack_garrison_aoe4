    <Style x:Key="AbilityProgressBarStyle" TargetType="{x:Type esControls:CircularProgressBar}">
        <Setter Property="EndAngle" Value="270" />
        <Setter Property="InnerRadius" Value="0.1" />
        <Setter Property="MinHeight" Value="4" />
        <Setter Property="MinWidth" Value="4" />
        <Setter Property="StartAngle" Value="-90" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type esControls:CircularProgressBar}">
                    <Border ClipToBounds="True">
                        <Canvas Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}"
                                MinWidth="{TemplateBinding MinWidth}"
                                MinHeight="{TemplateBinding MinHeight}">
                            <esControls:Ring x:Name="PART_Indicator"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                             Fill="{StaticResource AbilityActiveBrush}"
                                             InnerRadius="{TemplateBinding InnerRadius}"
                                             OuterRadius="{Binding ActualWidth, RelativeSource={RelativeSource Mode=TemplatedParent}, Converter={StaticResource MultiplyOperator}, ConverterParameter=0.825}"
                                             StartAngle="{TemplateBinding StartAngle}"
                                             Stretch="None">
                                <Canvas.Left>
                                    <MultiBinding Converter="{StaticResource MultiLerpOffset}">
                                        <Binding>
                                            <Binding.Source>
                                                <sys:Double>2</sys:Double>
                                            </Binding.Source>
                                        </Binding>
                                        <Binding Path="ActualWidth" RelativeSource="{RelativeSource Mode=TemplatedParent}" />
                                        <Binding Path="OuterRadius" RelativeSource="{RelativeSource Self}" />
                                    </MultiBinding>
                                </Canvas.Left>
                                <Canvas.Top>
                                    <MultiBinding Converter="{StaticResource MultiLerpOffset}">
                                        <Binding>
                                            <Binding.Source>
                                                <sys:Double>2</sys:Double>
                                            </Binding.Source>
                                        </Binding>
                                        <Binding Path="ActualWidth" RelativeSource="{RelativeSource Mode=TemplatedParent}" />
                                        <Binding Path="OuterRadius" RelativeSource="{RelativeSource Self}" />
                                    </MultiBinding>
                                </Canvas.Top>
                            </esControls:Ring>
                        </Canvas>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

