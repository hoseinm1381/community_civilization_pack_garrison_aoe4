    <Style x:Key="FireAttackIndicator" TargetType="{x:Type esControls:CircularProgressBar}">
        <Setter Property="Foreground" Value="{StaticResource BurnIndicator1Brush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type esControls:CircularProgressBar}">
                    <Grid Width="90" Height="90">
                        <Ellipse Width="60" Height="60"
                                 HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Offset="0" Color="{DynamicResource TertiaryColorLight}" />
                                    <GradientStop Offset="1" Color="{DynamicResource TertiaryColorDark}" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>

                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <esControls:Ring EndAngle="270"
                                             Fill="{DynamicResource TertiaryColorLightBrush}"
                                             InnerRadius="21" OuterRadius="25"
                                             StartAngle="-90" Stretch="None" />

                            <esControls:Ring Name="PART_Indicator"
                                             EndAngle="270"
                                             Fill="{TemplateBinding Foreground}"
                                             InnerRadius="21" OuterRadius="25"
                                             StartAngle="0" Stretch="None" />
                        </Grid>

                        <Image Width="24"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Source="/WPFGUI;component/icons/races/common/abilities/on_fire_off.png" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Value, RelativeSource={RelativeSource Self}, Converter={StaticResource GreaterCompare}, ConverterParameter=0.25}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource BurnIndicator2Brush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Value, RelativeSource={RelativeSource Self}, Converter={StaticResource GreaterCompare}, ConverterParameter=0.5}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource BurnIndicator3Brush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Value, RelativeSource={RelativeSource Self}, Converter={StaticResource GreaterCompare}, ConverterParameter=0.75}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource BurnIndicator4Brush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="BuildingOnFireIndicator" TargetType="{x:Type esControls:CircularProgressBar}">
        <Setter Property="Invert" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type esControls:CircularProgressBar}">
                    <Grid Width="90" Height="90">
                        <Ellipse x:Name="OnFireGlow"
                                 Width="90" Height="90"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Opacity="0">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Offset="0.5" Color="{StaticResource BurnIndicator4Color}" />
                                    <GradientStop Offset="1" Color="{StaticResource BurnIndicator4TransparentColor}" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>

                        <Ellipse Width="60" Height="60"
                                 HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Offset="0" Color="{DynamicResource TertiaryColorLight}" />
                                    <GradientStop Offset="1" Color="{DynamicResource TertiaryColorDark}" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>

                        <esControls:Ring HorizontalAlignment="Center" VerticalAlignment="Center"
                                         EndAngle="270"
                                         Fill="{StaticResource BurnIndicator4Brush}"
                                         InnerRadius="21" OuterRadius="25"
                                         StartAngle="-90" Stretch="None" />

                        <Image x:Name="OnFireIcon"
                               Width="24"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Source="/WPFGUI;component/icons/races/common/abilities/on_fire_on.png" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsVisible, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="FireIndicatorAnim">
                                    <!--  Animation designed on a cycle of 3 sec, but speed up  -->
                                    <Storyboard SpeedRatio="1.5">
                                        <DoubleAnimationUsingKeyFrames RepeatBehavior="Forever"
                                                                       Storyboard.TargetName="OnFireGlow" Storyboard.TargetProperty="(UIElement.Opacity)">
                                            <EasingDoubleKeyFrame KeyTime="0" Value="1" />
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.25" Value="1" />
                                            <EasingDoubleKeyFrame KeyTime="0:0:1" Value="0" />
                                            <EasingDoubleKeyFrame KeyTime="0:0:2" Value="0" />
                                            <EasingDoubleKeyFrame KeyTime="0:0:2.75" Value="1" />
                                            <EasingDoubleKeyFrame KeyTime="0:0:3" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="FireIndicatorAnim" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <!--  Values are inverted, so 1 means empty :)  -->
        <Setter Property="Value" Value="1" />
    </Style>

