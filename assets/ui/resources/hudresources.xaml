                        AudioAttachedProperty.PreviewMouseLeftButtonUpSound is empty string to prevent sfx conflict
                        with vizier panel show/hide sfx
                    -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!--  Vizier Points  -->
                        <Image Width="{StaticResource OttomanVizierPointIconSize}"
                               Margin="{StaticResource SmallMarginLeft}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Source="/WPFGUI;component/icons/vizier_point_active.png" />
