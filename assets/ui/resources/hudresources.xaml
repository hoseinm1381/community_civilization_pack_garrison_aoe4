    <LinearGradientBrush x:Key="HUDButtonDarkBrush" StartPoint="0,0" EndPoint="0,1">
        <LinearGradientBrush.GradientStops>
            <GradientStop Offset="0" Color="{DynamicResource SecondaryColorDark}" />
            <GradientStop Offset="1" Color="{DynamicResource SecondaryColorExtraDark}" />
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HUDButtonBrush" StartPoint="0,0" EndPoint="0,1">
        <LinearGradientBrush.GradientStops>
            <GradientStop Offset="0" Color="{DynamicResource SecondaryColor}" />
            <GradientStop Offset="1" Color="{DynamicResource SecondaryColorDark}" />
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>

    <Style x:Key="HUDButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="OverridesDefaultStyle" Value="true" />
        <Setter Property="SnapsToDevicePixels" Value="true" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Rectangle Name="Disabled"
                                   Effect="{StaticResource DropShadowButtonStyle}"
                                   Fill="{StaticResource HUDButtonDarkBrush}" />
                        <Rectangle Name="Enabled"
                                   Fill="{StaticResource HUDButtonBrush}"
                                   Visibility="Collapsed" />
                        <Rectangle Name="MouseOver"
                                   Fill="{StaticResource ButtonHighlightBrush}"
                                   Visibility="Collapsed" />
                        <Rectangle Name="Highlight"
                                   Fill="#FF93BED7" Visibility="Collapsed" />

                        <ContentControl Name="Border" Template="{DynamicResource TexturedSecondaryDarkSingleBorder}">
                            <ContentPresenter Name="Content"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              Opacity="0.7" />
                        </ContentControl>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="true">
                            <Setter TargetName="Content" Property="Opacity" Value="1" />
                            <Setter TargetName="Border" Property="Template" Value="{DynamicResource TexturedSecondarySingleBorder}" />
                            <Setter TargetName="Enabled" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="true">
                            <Setter TargetName="MouseOver" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="true">
                            <Setter TargetName="Border" Property="Template" Value="{DynamicResource TexturedSecondaryLightSingleBorder}" />
                            <Setter TargetName="Highlight" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="esUtility:AudioAttachedProperty.PreviewMouseLeftButtonUpSound" Value="sfx_ui_hud_inGame_button_play" />
    </Style>

    <Style x:Key="HUDWidgetTooltipStyle"
           BasedOn="{StaticResource FlowControl}"
           TargetType="ToolTip">
        <Setter Property="DataContext">
            <Setter.Value>
                <Binding Path="PlacementTarget.DataContext" RelativeSource="{RelativeSource Self}" />
            </Setter.Value>
        </Setter>
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Placement" Value="Top" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <ContentControl Style="{StaticResource HUDTooltipBorderStyle}">
                        <ContentPresenter />
                    </ContentControl>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DynastyTooltipStyle"
           BasedOn="{StaticResource FlowControl}"
           TargetType="ToolTip">
        <Setter Property="Effect" Value="{StaticResource DynastyTooltipDropShadowEffect}" />
        <Setter Property="HasDropShadow" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="true" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <ContentControl x:Name="Border"
                                    MaxWidth="{TemplateBinding MaxWidth}"
                                    Margin="0,0,4,4" Padding="20"
                                    Style="{StaticResource HUDTooltipBorderStyle}">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Top" />
                    </ContentControl>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="TextElement.FontSize" Value="20" />
    </Style>

    <!--  Might need to split this into a different datatemplate for both squads and buildings as they have different colored backgrounds  -->
    <DataTemplate x:Key="DynastyTooltip">
        <Grid MaxWidth="{StaticResource HUDTooltipMaxWidthSmall}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="{StaticResource HUDTooltipGutterWidthGridLength}" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Image Grid.Row="0" Grid.Column="0"
                   Width="{StaticResource HUDCommandCardIconSize}"
                   Height="{StaticResource HUDCommandCardIconSize}"
                   HorizontalAlignment="Left" VerticalAlignment="Top"
                   Source="{Binding [icon]}" />

            <StackPanel Grid.Row="2" Grid.Column="0"
                        HorizontalAlignment="Left"
                        Orientation="Vertical">
                <!--  resources  -->
                <ItemsControl ItemsSource="{Binding [cost]}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Visibility="{Binding [cost], Converter={StaticResource GreaterCompare}, ConverterParameter=0}">
                                <Image Width="26" Height="20"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Source="{Binding [icon]}"
                                       Stretch="UniformToFill" />

                                <TextBlock Margin="5,0,0,0" VerticalAlignment="Center"
                                           Style="{StaticResource nHUDBaseHeavyTextBlockStyle}"
                                           Text="{Binding [cost], Converter={StaticResource CastToIntOperator}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!--  production time  -->
                <StackPanel Margin="5,0,0,0"
                            Orientation="Horizontal"
                            Visibility="{Binding [productionTime], Converter={StaticResource InequalityCompare}, ConverterParameter=0}">
                    <Image Width="18" Height="18"
                           VerticalAlignment="Center"
                           Source="/WPFGUI;component/icons/shared/elapsed_time_icon.png" />
                    <!--  ProductionTimeTotal  -->
                    <TextBlock Margin="7,0,0,0" VerticalAlignment="Center"
                               Style="{StaticResource nHUDBaseHeavyTextBlockStyle}"
                               Text="{Binding [productionTime], Converter={StaticResource TimeFormat}}"
                               Visibility="{Binding [productionTime], Converter={StaticResource NumberToVis}}" />
                    <!--  infinity symbol: visible if ProductionTimeTotal < 0  -->
                    <TextBlock Margin="7,0,0,0" VerticalAlignment="Center"
                               Style="{StaticResource nHUDBaseHeavyTextBlockStyle}"
                               Text="{esUtility:LocString $11168149}"
                               Visibility="{Binding [productionTime], Converter={StaticResource LessCompare}, ConverterParameter=0}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="0" Grid.Column="2"
                        Orientation="Vertical">
                <esControls:Marquee MarqueeType="ScrollToLeft" Speed="60">
                    <TextBlock Style="{StaticResource nHUDTitleTextBlockStyle}" Text="{Binding [name]}" />
                </esControls:Marquee>
                <esControls:Marquee MarqueeType="ScrollToLeft" Speed="60">
                    <TextBlock x:Name="MarqueeContent"
                               Style="{StaticResource nHUDSubtitleTextBlockStyle}"
                               Text="{Binding [extra]}" />
                </esControls:Marquee>
            </StackPanel>

            <TextBlock Grid.Row="2" Grid.Column="2"
                       HorizontalAlignment="Left"
                       Style="{StaticResource nHUDBodyTextBlockStyle}"
                       Text="{Binding [help]}"
                       TextWrapping="Wrap" />
        </Grid>
    </DataTemplate>

    <Style x:Key="DynastiesLockUnlockedTooltip"
           BasedOn="{StaticResource FlowControl}"
           TargetType="ToolTip">
        <Setter Property="Effect" Value="{StaticResource DynastyTooltipDropShadowEffect}" />
        <Setter Property="HasDropShadow" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="true" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <ContentControl Width="{TemplateBinding Width}"
                                    Height="{TemplateBinding Height}"
                                    MaxWidth="{StaticResource HUDTooltipMaxWidthSmall}"
                                    Margin="0,0,4,4"
                                    Style="{StaticResource HUDTooltipBorderStyle}">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Top" />
                    </ContentControl>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="TextElement.FontSize" Value="20" />
