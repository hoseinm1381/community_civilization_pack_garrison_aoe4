    <Style x:Key="HUDCommandCardButtonStyle" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="true" />
        <Setter Property="SnapsToDevicePixels" Value="true" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Name="HUDCommandCardButton">
                        <Grid>
                            <Border Name="Bg"
                                    Background="{DynamicResource ButtonBgBrush}"
                                    Visibility="Visible">
                                <Border Background="{DynamicResource ButtonBgHighlightBrush}" />
                            </Border>

                            <Rectangle Name="Highlight"
                                       Fill="{DynamicResource ButtonHighlightBrush}"
                                       Visibility="Collapsed" />

                            <ContentPresenter Name="Content"
                                              HorizontalAlignment="Left" VerticalAlignment="Top" />

                            <Border Name="Rollover"
                                    BorderThickness="1" Visibility="Collapsed">
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="1,0">
                                        <GradientStop Offset="0" Color="#FFDB88" />
                                        <GradientStop Offset="0.6" Color="#11FFDB88" />
                                        <GradientStop Offset="1" Color="#00FFDB88" />
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                                <!--
                                <Rectangle Fill="{DynamicResource ButtonRolloverBrush}" Visibility="Collapsed" />
                                -->
                            </Border>


                            <Image Name="PartiallyActiveBorder"
                                   Opacity="0.5" SnapsToDevicePixels="True"
                                   Source="/WPFGUI;component/icons/buttons/button_indeterminate.png" Stretch="UniformToFill">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Active}" Value="True" />
                                                    <Condition Binding="{Binding IsActiveHomogeneous}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <MultiDataTrigger.Setters>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger.Setters>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>

                            <esControls:RangeInterpolator Name="ToggleButtonInterpolator"
                                                          Interpolation="0" IsTabStop="False" />

                            <Decorator Name="ToggleBarTravelProxy"
                                       Margin="0,0,6,0" HorizontalAlignment="Stretch" />

                            <Rectangle Name="ToggleBar"
                                       Width="6"
                                       HorizontalAlignment="Left"
                                       SnapsToDevicePixels="True"
                                       Stroke="{StaticResource GoldGradientColorBrush}"
                                       StrokeThickness="2" Visibility="Collapsed">
                                <Rectangle.Style>
                                    <Style TargetType="Rectangle">
                                        <Setter Property="Fill" Value="{StaticResource GoldGradientColorBrush}" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Active}" Value="True" />
                                                    <Condition Binding="{Binding IsActiveHomogeneous}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <MultiDataTrigger.Setters>
                                                    <Setter Property="Fill" Value="{StaticResource TransparentBackgroundBrush}" />
                                                </MultiDataTrigger.Setters>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Rectangle.Style>
                                <Rectangle.RenderTransform>
                                    <TranslateTransform>
                                        <TranslateTransform.X>
                                            <MultiBinding Converter="{StaticResource MultiMultiplyOperator}">
                                                <Binding ElementName="ToggleButtonInterpolator" Path="Interpolation" />
                                                <Binding ElementName="ToggleBarTravelProxy" Path="ActualWidth" />
                                            </MultiBinding>
                                        </TranslateTransform.X>
                                    </TranslateTransform>
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="true">
                            <Setter TargetName="Rollover" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <DataTrigger Binding="{Binding HasInsufficientResources}" Value="true">
                            <Setter TargetName="Content" Property="Opacity" Value="0.2" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding ProductionVisibility, FallbackValue=Collapsed}" Value="{x:Static Visibility.Visible}" />
                                <Condition Binding="{Binding Available}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Content" Property="Opacity" Value="0.2" />
                        </MultiDataTrigger>
                        <DataTrigger Binding="{Binding HasInsufficientUpgrades}" Value="true">
                            <Setter TargetName="Content" Property="Opacity" Value="0.2" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding DoesNotMeetStateModelRequirements}" Value="true">
                            <Setter TargetName="Content" Property="Opacity" Value="0.2" />
                        </DataTrigger>
                        <Trigger Property="IsPressed" Value="true">
                            <Setter TargetName="Rollover" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Highlight" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="false">
                            <Setter TargetName="Content" Property="Opacity" Value="0.3" />
                            <Setter TargetName="Highlight" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Rollover" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <DataTrigger Value="true">
                            <Setter TargetName="Content" Property="Opacity" Value="1" />
                            <Setter TargetName="Highlight" Property="Visibility" Value="Visible" />
                            <DataTrigger.Binding>
                                <MultiBinding Converter="{StaticResource MultiLogicalAnd}" ConverterParameter="true">
                                    <Binding Mode="OneWay" Path="Toggled" />
                                    <Binding Mode="OneWay" Path="Active" />
                                </MultiBinding>
                            </DataTrigger.Binding>
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard TargetProperty="Opacity" TargetName="Rollover">
                                        <DoubleAnimation To="0" Duration="0:0:0" />
                                        <DoubleAnimation AccelerationRatio=".1"
                                                         To="2.0" Duration="0:0:0.25" />
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard>
                                    <Storyboard TargetProperty="Interpolation" TargetName="ToggleButtonInterpolator">
                                        <DoubleAnimation AccelerationRatio=".1"
                                                         To="1" Duration="0:0:0.25" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard TargetProperty="Interpolation" TargetName="ToggleButtonInterpolator">
                                        <DoubleAnimation AccelerationRatio=".1"
                                                         To="0" Duration="0:0:0.25" />
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard>
                                    <Storyboard TargetProperty="Opacity" TargetName="Rollover">
                                        <DoubleAnimation To="1.0" Duration="0:0:0" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Toggled, Mode=OneWay}" Value="true">
                            <Setter TargetName="ToggleBar" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsCurrent}" Value="true">
                            <Setter TargetName="Highlight" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <Style x:Key="HUDUniqueUnitButtonStyle" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="true" />
        <Setter Property="SnapsToDevicePixels" Value="true" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Name="HUDCommandCardButton">
                        <Grid>
                            <Rectangle Margin="1,1,-1,-1" Fill="#88000000" />
                            <Rectangle Name="Base" Fill="#33505050" />
                            <ContentPresenter Name="Content"
                                              HorizontalAlignment="Left" VerticalAlignment="Top" />

                            <Image Name="RolloverGlow"
                                   Width="{StaticResource HUDCommandCardIconSize}"
                                   Height="{StaticResource HUDCommandCardIconSize}"
                                   esEffects:BrushExtensions.BlendMode="Add" Opacity="0.5"
                                   Source="/WPFGUI;component/icons/buttons/button_rollover_glow.png" Stretch="Fill"
                                   Visibility="Collapsed" />
                            <!--
                                Adding a transparent rectangle here, since without it, the Additive Blend Effects cause an issue with rendering where the Opacity Mask edge fade on the GBQ will
                                cause the bottom row to turn white and semi transparent when this template is visible, blocking the mouse from entering here with an object will prevent this
                                For a more in depth test case, refer to BlendModeBugTest.xaml, you can run this test in game (not in the xaml app) to see the issue.
                            -->
                            <Rectangle Width="{StaticResource HUDCommandCardIconSize}"
                                       Height="{StaticResource HUDCommandCardIconSize}"
                                       Fill="Transparent" Stretch="UniformToFill" />
                            <Border Name="Rollover"
                                    BorderThickness="1" Visibility="Collapsed">
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="1,0">
                                        <GradientStop Offset="0" Color="#FFDB88" />
                                        <GradientStop Offset="0.6" Color="#11FFDB88" />
                                        <GradientStop Offset="1" Color="#00FFDB88" />
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                            </Border>
                            <Rectangle Name="Highlight"
                                       Fill="{StaticResource ButtonHighlightBrush}"
                                       Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="true">
                            <Setter TargetName="Rollover" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RolloverGlow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="true">
                            <Setter TargetName="Highlight" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="false">
                            <Setter TargetName="Highlight" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Rollover" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="esUtility:AudioAttachedProperty.PreviewMouseLeftButtonUpSound" Value="sfx_ui_hud_inGame_button_unitButton_play" />
    </Style>

