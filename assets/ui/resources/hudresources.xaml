                                                       Width="16" Height="44"
                                                       Margin="3,1,0,0" HorizontalAlignment="Right"
                                                       VerticalAlignment="Center">
                                                <Rectangle.Fill>
                                                    <ImageBrush ImageSource="/WPFGUI;component/images/backgrounds/dynasties/dynasty_decorative_outline_left.png" Stretch="Uniform"
                                                                TileMode="None" Viewport="0,0,16,44"
                                                                ViewportUnits="Absolute" />
                                                </Rectangle.Fill>
                                            </Rectangle>

                                            <Rectangle Grid.Column="1"
                                                       Height="44"
                                                       Margin="0,1,0,0" VerticalAlignment="Center">
                                                <Rectangle.Fill>
                                                    <ImageBrush ImageSource="/WPFGUI;component/images/backgrounds/dynasties/dynasty_decorative_outline_middle.png" Stretch="Uniform"
                                                                TileMode="Tile" Viewport="0,0,4,44"
                                                                ViewportUnits="Absolute" />
                                                </Rectangle.Fill>
                                            </Rectangle>

                                            <Rectangle Grid.Column="2"
                                                       Width="16" Height="44"
                                                       Margin="0,1,3,0" HorizontalAlignment="Left"
                                                       VerticalAlignment="Center">
                                                <Rectangle.Fill>
                                                    <ImageBrush ImageSource="/WPFGUI;component/images/backgrounds/dynasties/dynasty_decorative_outline_right.png" Stretch="Uniform"
                                                                TileMode="None" Viewport="0,0,16,44"
                                                                ViewportUnits="Absolute" />
                                                </Rectangle.Fill>
                                            </Rectangle>
                                        </Grid>

                                        <Image x:Name="TheSymbol"
                                               Grid.ColumnSpan="3"
                                               Width="34" Height="34"
                                               Source="{Binding [current_dynasty][icon]}" />
                                    </Grid>

                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="true">
                                            <Setter TargetName="TheSymbol" Property="Source" Value="{Binding [current_dynasty][active_icon]}" />
                                            <Setter TargetName="Highlight" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="true">
                                            <Setter TargetName="TheSymbol" Property="Source" Value="{Binding [current_dynasty][active_icon]}" />
                                            <Setter TargetName="Highlight" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding [is_dropdown_visible]}" Value="true">
                                            <Setter TargetName="TheSymbol" Property="Source" Value="{Binding [current_dynasty][active_icon]}" />
                                        </DataTrigger>
                                        <Trigger Property="IsEnabled" Value="false">
                                            <Setter TargetName="ButtonGroup" Property="Opacity" Value="{StaticResource ButtonDisabledOpacity}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
