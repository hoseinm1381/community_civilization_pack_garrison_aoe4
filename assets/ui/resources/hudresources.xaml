                                                           Fill="{StaticResource HUDButtonBrush}"
                                                           Opacity="0">
                                                    <Rectangle.Style>
                                                        <Style TargetType="{x:Type Rectangle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding LocalPlayer.StateModel.Int[mengan_mouke_active_count_jin]}" Value="0">
