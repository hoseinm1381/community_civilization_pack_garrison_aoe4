    <Style x:Key="KickerTemplateStyle" TargetType="FrameworkElement">
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TranslateTransform Y="0" />
            </Setter.Value>
        </Setter>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />

        <Style.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <!--  animations must start with a reset since containers are recycled  -->
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(FrameworkElement.RenderTransform).(TranslateTransform.Y)">
                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                            <EasingDoubleKeyFrame EasingFunction="{StaticResource CubicEaseOut}"
                                                  KeyTime="0"
                                                  Value="8" />
                            <EasingDoubleKeyFrame EasingFunction="{StaticResource CubicEaseOut}"
                                                  KeyTime="0:0:1"
                                                  Value="-24" />
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)">
                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                            <EasingDoubleKeyFrame EasingFunction="{StaticResource QuinticEaseOut}"
                                                  KeyTime="0"
                                                  Value="0" />
                            <EasingDoubleKeyFrame EasingFunction="{StaticResource QuinticEaseOut}"
                                                  KeyTime="0:0:1"
                                                  Value="1" />
                            <EasingDoubleKeyFrame KeyTime="0:0:1.2" Value="1" />
                            <EasingDoubleKeyFrame KeyTime="0:0:1.4" Value="0" />
                        </DoubleAnimationUsingKeyFrames>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Style.Triggers>
    </Style>


