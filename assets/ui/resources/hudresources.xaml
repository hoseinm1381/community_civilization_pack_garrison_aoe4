    <RadialGradientBrush x:Key="CasterUpgradeIconBackgroundBrush" Center="0.5,0" GradientOrigin="0.5,0">
        <RadialGradientBrush.GradientStops>
            <GradientStop Offset="0" Color="#4EA394" />
            <GradientStop Offset="1" Color="#2E7E69" />
        </RadialGradientBrush.GradientStops>
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="CasterUnitIconBackgroundBrush" Center="0.5,0" GradientOrigin="0.5,0">
        <RadialGradientBrush.GradientStops>
            <GradientStop Offset="0" Color="#A16E52" />
            <GradientStop Offset="1" Color="#754227" />
        </RadialGradientBrush.GradientStops>
    </RadialGradientBrush>

    <Style x:Key="CasterProductionInfoIconBackgroundStyle" TargetType="Panel">
        <Setter Property="Background" Value="{StaticResource CasterUpgradeIconBackgroundBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsUpgrade}" Value="False">
                <Setter Property="Background" Value="{StaticResource CasterUnitIconBackgroundBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <DataTemplate x:Key="CasterProductionInfoToolTipContentTemplate" DataType="{x:Type casterModel:CasterProductionInfoModel}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  See ProductionToolTip.xaml  -->
            <StackPanel>
                <DockPanel Width="40" Height="40"
                           Style="{StaticResource CasterProductionInfoIconBackgroundStyle}">
                    <Image Width="32" Height="32"
                           Source="{Binding Icon}"
                           Stretch="Fill" />
                </DockPanel>

                <!--  resources  -->
                <ItemsControl Grid.Row="1"
                              Margin="0,10,0,0" VerticalAlignment="Top"
                              ItemsSource="{Binding ResourceCost}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Image Width="{StaticResource HUDResourceIconSize}"
                                       Height="{StaticResource HUDResourceIconSize}"
                                       VerticalAlignment="Center"
                                       Source="{Binding Icon}" />
                                <TextBlock VerticalAlignment="Center"
                                           Style="{StaticResource nHUDBaseHeavyTextBlockStyle}"
                                           Text="{Binding Amount, Converter={StaticResource CastToIntOperator}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Orientation="Horizontal" Visibility="{Binding CompletionTime, Converter={StaticResource InequalityCompare}, ConverterParameter=0}">
                    <Image Width="{StaticResource HUDResourceIconSize}"
                           Height="{StaticResource HUDResourceIconSize}"
                           VerticalAlignment="Center"
                           Source="../../icons/common/time_to_build.png" />
                    <!--  ProductionTimeTotal  -->
                    <TextBlock VerticalAlignment="Center"
                               Style="{StaticResource nHUDBaseHeavyTextBlockStyle}"
                               Text="{Binding CompletionTime, Converter={StaticResource TimeFormat}}"
                               Visibility="{Binding CompletionTime, Converter={StaticResource GreaterCompare}, ConverterParameter=0}" />
                    <!--  infinity symbol: visible if CompletionTime < 0  -->
                    <TextBlock VerticalAlignment="Center"
                               Style="{StaticResource nHUDBaseHeavyTextBlockStyle}"
                               Text="{esUtility:LocString $11168149}"
                               Visibility="{Binding CompletionTime, Converter={StaticResource LEqualCompare}, ConverterParameter=0}" />
                </StackPanel>

                <!--  Population Cost  -->
                <Grid Margin="6,0,0,4" Visibility="{Binding PopulationCost, Converter={StaticResource GreaterCompare}, ConverterParameter=1, FallbackValue=Collapsed}">
                    <StackPanel Orientation="Horizontal">
                        <Image Width="20" Height="23"
                               VerticalAlignment="Center"
                               Source="/WPFGUI;component/icons/resources/resource_popcap.png" />
                        <TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
                                   Style="{StaticResource nHUDBaseHeavyTextBlockStyle}"
                                   Text="{Binding PopulationCost, Converter={StaticResource CastToIntOperator}}" />
                    </StackPanel>
                </Grid>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="20,0,0,0">
                <!--  see SharedTooltipInformation template  -->
                <!--  title text  -->
                <TextBlock Style="{StaticResource nHUDTitleTextBlockStyle}" Text="{Binding Title}" />
                <!--  extra text  -->
                <esControls:Marquee Margin="{StaticResource SmallMarginBottom}"
                                    MarqueeType="ScrollToLeft" Speed="60">
                    <TextBlock VerticalAlignment="Top"
                               Style="{StaticResource nHUDSubtitleTextBlockStyle}"
                               Text="{Binding SubTitle}"
                               Visibility="{Binding SubTitle, Converter={StaticResource NotNullOrEmptyStringToVis}}" />
                </esControls:Marquee>
                <!--  Unique to civ  -->
                <StackPanel Margin="{StaticResource SmallMarginTop}"
                            Orientation="Horizontal"
                            Visibility="{Binding UniqueToRace, Converter={StaticResource NotNullOrEmptyStringToVis}, FallbackValue=Collapsed}">
                    <Image HorizontalAlignment="Left" VerticalAlignment="Center"
                           Style="{StaticResource UniqueToCivIcon}" />
                    <!--  $11164295: Unique to %1RACE_NAME%  -->
                    <TextBlock VerticalAlignment="Center"
                               Style="{StaticResource nHUDBodyTextBlockStyle}"
                               Text="{Binding UniqueToRace, Converter={StaticResource LocalizedStringConverter}, ConverterParameter=$11164295}" />
                </StackPanel>
                <!--  description  -->
                <TextBlock Margin="0,18,0,0"
                           Style="{StaticResource nHUDBodyTextBlockStyle}"
                           Text="{Binding Description}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <Style x:Key="CasterProductionInfoToolTip" TargetType="{x:Type FrameworkElement}">
        <Setter Property="ToolTip">
            <Setter.Value>
                <ToolTip DataContext="{Binding PlacementTarget.DataContext.ProductionInfo, RelativeSource={RelativeSource Self}}"
                         HasDropShadow="False" OverridesDefaultStyle="True"
                         Placement="Mouse">
                    <ToolTip.Template>
                        <ControlTemplate TargetType="ToolTip">
                            <!--  See HUDTooltipBorderStyle  -->
                            <Grid MaxWidth="{StaticResource HUDTooltipMaxWidthSmall}">
                                <Rectangle Margin="1,1,0,0" Fill="#88000000" />
                                <Rectangle Margin="0,0,1,1" Fill="{StaticResource CasterTertiaryColorGradientVerticalBrush}" />
                                <ContentControl Margin="18"
                                                Content="{Binding}"
                                                ContentTemplate="{StaticResource CasterProductionInfoToolTipContentTemplate}"
                                                IsTabStop="False"
                                                Style="{StaticResource FlowControl}" />
                            </Grid>
                        </ControlTemplate>
                    </ToolTip.Template>
                </ToolTip>
            </Setter.Value>
        </Setter>
        <Setter Property="ToolTipService.InitialShowDelay" Value="500" />
        <Setter Property="ToolTipService.ShowDuration" Value="86400000" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
    </Style>

    <!--  Brawl Mode Datatemplates  -->
    <sys:Double x:Key="BrawlPlayerColumnWidth">210</sys:Double>
    <sys:Double x:Key="BrawlStatColumnWidth">70</sys:Double>
    <sys:Double x:Key="BrawlStatRowHeight">30</sys:Double>

    <Style x:Key="HUDStatViewerItemContainerStyle" TargetType="ListViewItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Border HorizontalAlignment="Left" Background="{TemplateBinding Background}">
                        <GridViewRowPresenter MinHeight="28"
                                              Columns="{TemplateBinding GridView.ColumnCollection}"
                                              Content="{TemplateBinding Content}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
