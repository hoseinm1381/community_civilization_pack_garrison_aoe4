                                            <Setter Property="VerticalOffset" Value="-17" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LocalPlayer.AbbasidHouseOfWisdomEntity, Converter={StaticResource NotNullConverter}}" Value="True">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ToolTip">
                                                                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource GoldenAgeDataTemplate}" />
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToolTip.Style>
