    <DataTemplate x:Key="ChineseDynasties">
        <Grid Margin="0,0,0,245" HorizontalAlignment="Left"
              VerticalAlignment="Bottom">
            <Grid.Visibility>
                <MultiBinding Converter="{StaticResource MultiLogicalOr}">
                    <Binding Path="[is_ui_visible]" />
                    <Binding Converter="{StaticResource IsEqualConverter}"
                             ConverterParameter="{StaticResource ChineseRaceID}"
                             FallbackValue="{x:Static Visibility.Visible}"
                             Path="LocalPlayer.RaceID"
                             Source="{x:Static model:HUDModel.Instance}" />
                    <Binding Converter="{StaticResource IsEqualConverter}"
                             ConverterParameter="{StaticResource HistoricChineseRaceID}"
                             FallbackValue="{x:Static Visibility.Visible}"
                             Path="LocalPlayer.RaceID"
                             Source="{x:Static model:HUDModel.Instance}" />
                    <Binding Converter="{StaticResource IsEqualConverter}"
                             ConverterParameter="{StaticResource SongDynastyRaceID}"
                             FallbackValue="{x:Static Visibility.Visible}"
                             Path="LocalPlayer.RaceID"
                             Source="{x:Static model:HUDModel.Instance}" />
                </MultiBinding>
            </Grid.Visibility>
            <Grid.RowDefinitions>
                <RowDefinition Height="320" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ItemsControl Grid.Row="0"
                          Margin="15,0,0,13" VerticalAlignment="Top"
                          AlternationCount="4" IsTabStop="False"
                          ItemsSource="{Binding [dynasties]}"
                          Visibility="{Binding [is_dropdown_visible], Converter={StaticResource BoolToVis}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Button IsEnabled="{Binding [unlocked]}"
                                    IsTabStop="False"
                                    Style="{StaticResource DynastiesCardStyle}">
                                <Grid>
                                    <Image Width="{StaticResource DynastyCardWidth}"
                                           Height="{StaticResource DynastyCardHeight}"
                                           Source="{Binding [locked_bg]}"
                                           Visibility="{Binding [active], Converter={StaticResource InvBoolToVis}}" />

                                    <Grid Visibility="{Binding [active], Converter={StaticResource BoolToVis}}">
                                        <Image Width="{StaticResource DynastyCardWidth}"
                                               Height="{StaticResource DynastyCardHeight}"
                                               Style="{DynamicResource ActiveDynastyBackgroundStyle}" />

                                        <Image Name="DynastyCardPlateOutlineImage"
                                               Width="{StaticResource DynastyCardWidth}"
                                               Height="{StaticResource DynastyCardHeight}"
                                               Opacity="0.6"
                                               Source="{Binding [gold_outline]}" />

                                        <Rectangle Width="{Binding ActualWidth, ElementName=DynastyCardPlateOutlineImage}"
                                                   Height="{Binding ActualHeight, ElementName=DynastyCardPlateOutlineImage}"
                                                   Opacity="0.9">
                                            <Rectangle.Style>
                                                <Style TargetType="Rectangle">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding LocalPlayer.RaceID, Converter={StaticResource IsEqualConverter}, ConverterParameter={StaticResource ChineseRaceID}, Source={x:Static model:HUDModel.Instance}, FallbackValue={x:Static Visibility.Collapsed}}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding [dynasty]}" Value="tang">
                                                            <Setter Property="Fill" Value="{esUtility:Shader {StaticResource TangDynastyCardPlate}}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding [dynasty]}" Value="song">
                                                            <Setter Property="Fill" Value="{esUtility:Shader {StaticResource SongDynastyCardPlate}}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding [dynasty]}" Value="yuan">
                                                            <Setter Property="Fill" Value="{esUtility:Shader {StaticResource YuanDynastyCardPlate}}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding [dynasty]}" Value="ming">
                                                            <Setter Property="Fill" Value="{esUtility:Shader {StaticResource MingDynastyCardPlate}}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Rectangle.Style>
                                        </Rectangle>

                                        <Rectangle Width="{Binding ActualWidth, ElementName=DynastyCardPlateOutlineImage}"
                                                   Height="{Binding ActualHeight, ElementName=DynastyCardPlateOutlineImage}"
                                                   Opacity="0.9">
                                            <Rectangle.Style>
                                                <Style TargetType="Rectangle">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding LocalPlayer.RaceID, Converter={StaticResource IsEqualConverter}, ConverterParameter={StaticResource HistoricChineseRaceID}, Source={x:Static model:HUDModel.Instance}, FallbackValue={x:Static Visibility.Collapsed}}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding [dynasty]}" Value="tang">
                                                            <Setter Property="Fill" Value="{esUtility:Shader {StaticResource HistoricTangDynastyCardPlate}}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding [dynasty]}" Value="song">
                                                            <Setter Property="Fill" Value="{esUtility:Shader {StaticResource HistoricSongDynastyCardPlate}}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding [dynasty]}" Value="yuan">
                                                            <Setter Property="Fill" Value="{esUtility:Shader {StaticResource HistoricYuanDynastyCardPlate}}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding [dynasty]}" Value="ming">
                                                            <Setter Property="Fill" Value="{esUtility:Shader {StaticResource HistoricMingDynastyCardPlate}}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Rectangle.Style>
                                        </Rectangle>
                                    </Grid>

                                    <Grid Margin="24">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="48" />
                                        </Grid.RowDefinitions>

                                        <!--  dynasty name and lock icon  -->
                                        <Grid Grid.Row="0" Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!--  dynasty name  -->
                                            <TextBlock Grid.Column="0"
                                                       esControls:TextBlockExtensions.AutoToolTip="True"
                                                       Text="{Binding [upgrade][name]}"
                                                       TextTrimming="CharacterEllipsis" ToolTipService.InitialShowDelay="0"
                                                       ToolTipService.ShowDuration="86400000" ToolTipService.ShowOnDisabled="True">
                                                <TextBlock.Style>
                                                    <Style BasedOn="{StaticResource nHUDTitleAltTextBlockStyle}" TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding [active]}" Value="true">
                                                                <Setter Property="Foreground" Value="{DynamicResource ActiveDynastyPanelTextColor}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                                <TextBlock.ToolTip>
                                                    <ToolTip MaxWidth="{StaticResource HUDTooltipMaxWidthSmall}" Style="{StaticResource HUDBaseAutoTooltipStyle}" />
                                                </TextBlock.ToolTip>
                                            </TextBlock>

                                            <!--  lock icon  -->
                                            <Image Grid.Column="1"
                                                   Width="24" Height="24"
                                                   Margin="0,0,-8,0"
                                                   ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="86400000"
                                                   ToolTipService.ShowOnDisabled="True"
                                                   Visibility="{Binding [active], Converter={StaticResource InvBoolToVis}}">
                                                <Image.Style>
                                                    <Style TargetType="{x:Type Image}">
                                                        <Setter Property="Source" Value="/WPFGUI;component/icons/races/chinese/dynasties/locked.png" />
                                                        <Setter Property="ToolTip">
                                                            <Setter.Value>
                                                                <ToolTip Style="{StaticResource DynastiesLockUnlockedTooltip}">
                                                                    <TextBlock Style="{StaticResource nHUDBaseTextBlockStyle}"
                                                                               Text="{esUtility:LocString $11170437}"
                                                                               TextWrapping="Wrap" />
                                                                </ToolTip>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding [unlocked]}" Value="True">
                                                                <Setter Property="Source" Value="/WPFGUI;component/icons/races/chinese/dynasties/unlocked.png" />
                                                                <Setter Property="ToolTip">
                                                                    <Setter.Value>
                                                                        <ToolTip Style="{StaticResource DynastiesLockUnlockedTooltip}">
                                                                            <TextBlock Style="{StaticResource nHUDBaseTextBlockStyle}"
                                                                                       Text="{esUtility:LocString $11170438}"
                                                                                       TextWrapping="Wrap" />
                                                                        </ToolTip>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>
                                        </Grid>

                                        <!--  Bonuses  -->
                                        <TextBlock Grid.Row="1"
                                                   Margin="0,0,0,2"
                                                   esControls:TextBlockExtensions.AutoToolTip="True"
                                                   Text="{esUtility:LocString $11170336}"
                                                   TextTrimming="CharacterEllipsis" ToolTipService.InitialShowDelay="0"
                                                   ToolTipService.ShowDuration="86400000" ToolTipService.ShowOnDisabled="True">
                                            <TextBlock.Style>
                                                <Style BasedOn="{StaticResource nHUDTitleSmallTextBlockStyle}" TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryColorLightBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding [active]}" Value="true">
                                                            <Setter Property="Foreground" Value="{DynamicResource ActiveDynastyPanelSubTitleTextColor}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                            <TextBlock.ToolTip>
                                                <ToolTip MaxWidth="{StaticResource HUDTooltipMaxWidthSmall}" Style="{StaticResource HUDBaseAutoTooltipStyle}" />
                                            </TextBlock.ToolTip>
                                        </TextBlock>

                                        <!--  Help text  -->
                                        <TextBlock Grid.Row="2"
                                                   esControls:TextBlockExtensions.AutoToolTip="True"
                                                   Text="{Binding [upgrade][help]}"
                                                   TextTrimming="CharacterEllipsis" TextWrapping="Wrap"
                                                   ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="86400000"
                                                   ToolTipService.ShowOnDisabled="True">
                                            <TextBlock.Style>
                                                <Style BasedOn="{StaticResource nHUDBodyTextBlockStyle}" TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding [active]}" Value="true">
                                                            <Setter Property="Foreground" Value="{DynamicResource ActiveDynastyDescriptionTextColor}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                            <TextBlock.ToolTip>
                                                <ToolTip MaxWidth="{StaticResource HUDTooltipMaxWidthSmall}" Style="{StaticResource HUDBaseAutoTooltipStyle}" />
                                            </TextBlock.ToolTip>
                                        </TextBlock>

                                        <!--  special squad and building  -->
                                        <StackPanel Grid.Row="3"
                                                    Margin="0,8,0,12"
                                                    Orientation="Horizontal">
                                            <Image Width="48" Height="48"
                                                   Margin="0,0,8,0"
                                                   Source="{Binding [squad][icon]}"
                                                   ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="86400000"
                                                   ToolTipService.ShowOnDisabled="True">
                                                <Image.Visibility>
                                                    <MultiBinding Converter="{StaticResource MultiLogicalAnd}" FallbackValue="{x:Static Visibility.Collapsed}">
                                                        <Binding Converter="{StaticResource NotNullOrEmptyStringToVis}"
                                                                 FallbackValue="{x:Static Visibility.Collapsed}"
                                                                 Path="[squad][icon]" />
                                                        <Binding Converter="{StaticResource IsNotEqualVisibilityConverter}"
                                                                 ConverterParameter="{StaticResource HistoricChineseRaceID}"
                                                                 FallbackValue="{x:Static Visibility.Collapsed}"
                                                                 Path="LocalPlayer.RaceID"
                                                                 Source="{x:Static model:HUDModel.Instance}" />
                                                    </MultiBinding>
                                                </Image.Visibility>
                                                <Image.ToolTip>
                                                    <ToolTip Content="{Binding Path=PlacementTarget.DataContext[squad], RelativeSource={RelativeSource Self}}"
                                                             ContentTemplate="{StaticResource DynastyTooltip}"
                                                             Style="{StaticResource DynastyTooltipStyle}" />
                                                </Image.ToolTip>
                                            </Image>
                                            <Image Width="48" Height="48"
                                                   Margin="0,0,8,0"
                                                   Source="{Binding [building][icon]}"
                                                   ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="86400000"
                                                   ToolTipService.ShowOnDisabled="True"
                                                   Visibility="{Binding [building][icon], Converter={StaticResource NotNullOrEmptyStringToVis}, FallbackValue=Collapsed}">
                                                <Image.ToolTip>
                                                    <ToolTip Content="{Binding Path=PlacementTarget.DataContext[building], RelativeSource={RelativeSource Self}}"
                                                             ContentTemplate="{StaticResource DynastyTooltip}"
                                                             Style="{StaticResource DynastyTooltipStyle}" />
                                                </Image.ToolTip>
                                            </Image>
                                        </StackPanel>

                                        <!--  Requires  -->
                                        <TextBlock Grid.Row="4"
                                                   Margin="0,0,0,6"
                                                   esControls:TextBlockExtensions.AutoToolTip="True"
                                                   Text="{esUtility:LocString $11170337}"
                                                   TextTrimming="CharacterEllipsis" ToolTipService.InitialShowDelay="0"
                                                   ToolTipService.ShowDuration="86400000" ToolTipService.ShowOnDisabled="True">
                                            <TextBlock.Style>
                                                <Style BasedOn="{StaticResource nHUDBaseHeavyTextBlockStyle}" TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryColorLightBrush}" />
