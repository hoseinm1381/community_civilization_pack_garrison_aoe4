                                        <Style TargetType="{x:Type Image}">
                                            <Setter Property="Source" Value="{Binding [icon]}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding [active]}" Value="True">
                                                    <Setter Property="Source" Value="{Binding [active_icon]}" />
                                                </DataTrigger>
                                            </Style.Triggers>
