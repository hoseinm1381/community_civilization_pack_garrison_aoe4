                                                    <Border Background="{DynamicResource ButtonBgEconomicColorBrush}">
                                                        <Border Background="{DynamicResource ButtonBgLightEconomicColorBrush}" />
                                                    </Border>
                                                    <Image Margin="{StaticResource HUDIconMargin}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Source="/WPFGUI;component/icons/vizier_point.png" />
                                                </Grid>
                                            </DataTemplate>
                                        </ContentControl.ContentTemplate>
