    <ControlTemplate x:Key="IdleVillagersIcon" TargetType="Control">
        <ControlTemplate.Resources>
            <Storyboard x:Key="ZAnimate1"
                        RepeatBehavior="Forever"
                        Storyboard.TargetName="Z1" Duration="0:0:1.2">
                <!--  Z1  -->
                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1"
                                 To="0" />
                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" From="0.5"
                                 To="1" />
                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" From="0.5"
                                 To="1" />
                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TransformGroup.Children)[1].(TranslateTransform.Y)" From="-10"
                                 To="-15" />
                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="RenderTransform.(TransformGroup.Children)[1].(TranslateTransform.X)">
                    <DiscreteDoubleKeyFrame KeyTime="0" Value="-2" />
                    <SplineDoubleKeyFrame KeySpline="0.3,0,0.5,0" KeyTime="0:0:1"
                                          Value="8" />
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
            <!--  Z2  -->
            <Storyboard x:Key="ZAnimate2"
                        BeginTime="0:0:0.6" RepeatBehavior="Forever"
                        Storyboard.TargetName="Z2" Duration="0:0:1.2">
                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1"
                                 To="0" />
                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" From="0.5"
                                 To="1" />
                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" From="0.5"
                                 To="1" />
                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TransformGroup.Children)[1].(TranslateTransform.Y)" From="-10"
                                 To="-15" />
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Z2" Storyboard.TargetProperty="RenderTransform.(TransformGroup.Children)[1].(TranslateTransform.X)">
                    <DiscreteDoubleKeyFrame KeyTime="0" Value="-2" />
                    <SplineDoubleKeyFrame KeySpline="0.3,0,0.5,0" KeyTime="0:0:1"
                                          Value="8" />
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
        </ControlTemplate.Resources>
        <Grid x:Name="MyGrid" Visibility="Hidden">
            <!--  Size of villager while 1 or more inactives  -->
            <Image Width="16"
                   VerticalAlignment="Center"
                   Source="/WPFGUI;component/icons/resources/resource_idle_villager_no_z.png" />
            <Image x:Name="Z1"
                   Width="11" Height="9"
                   Opacity="0" RenderTransformOrigin="0,1"
                   Source="/WPFGUI;component/icons/resources/resource_idle_villager_z.png">
                <Image.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform />
                        <TranslateTransform />
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>
            <Image x:Name="Z2"
                   Width="11" Height="9"
                   Opacity="0" RenderTransformOrigin="0,1"
                   Source="/WPFGUI;component/icons/resources/resource_idle_villager_z.png">
                <Image.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform />
                        <TranslateTransform />
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>
        </Grid>
        <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding LocalPlayer.NumIdleVillagers, Converter={StaticResource GreaterCompare}, ConverterParameter=0}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard Name="ZAnimate1" Storyboard="{StaticResource ZAnimate1}" />
                    <BeginStoryboard Name="ZAnimate2" Storyboard="{StaticResource ZAnimate2}" />
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="ZAnimate1" />
                    <StopStoryboard BeginStoryboardName="ZAnimate2" />
                </DataTrigger.ExitActions>
                <Setter TargetName="MyGrid" Property="Visibility" Value="Visible" />
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <DataTemplate x:Key="GlobalBuildQueueUpgradeButtonTemplate" DataType="{x:Type model:GUCProductionModel}">
        <Grid Width="{StaticResource HUDBuildQueueIconSize}"
              Height="{StaticResource HUDBuildQueueIconSize}"
              DataContext="{Binding DataContext, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Button}}}">
            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource IssuableIconPresenter}" />
            <Canvas>
                <ProgressBar Canvas.Bottom="0"
                             Width="{StaticResource HUDBuildQueueIconSize}"
                             Height="6"
                             Template="{StaticResource ConstructionProgressBar}"
                             Value="{Binding Progress, Mode=OneWay}" />

                <!--  Glow red when production of upgrade is blocked by earlier spawn production in producer queue halted  -->
                <Rectangle Width="{StaticResource HUDBuildQueueIconSize}" Height="{StaticResource HUDBuildQueueIconSize}">
                    <Rectangle.Style>
                        <Style TargetType="{x:Type Rectangle}">
                            <Setter Property="Fill">
                                <Setter.Value>
                                    <RadialGradientBrush>
                                        <GradientStop Offset="0.6" Color="#40c93527" />
                                        <GradientStop Offset="1" Color="#c93527" />
                                    </RadialGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding BlockedByEarlierProduction}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard Name="Pulse">
                                            <Storyboard AutoReverse="True" RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1"
                                                                 To="0.5" Duration="0:0:0.5" />
                                                <DoubleAnimation Storyboard.TargetProperty="Fill.(GradientBrush.GradientStops)[0].(GradientStop.Offset)" From="0.3"
                                                                 To="0.7" Duration="0:0:0.5" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="Pulse" />
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Rectangle.Style>
                </Rectangle>

                <!--
                    Warning indicator when production of upgrade is blocked by earlier spawn production in producer queue
                    BlockedByEarlierProduction actually includes self since there were issues with MultiLogicalAnd/IsBlocked/BlockedByEarlierProduction
                -->
                <Image Canvas.Top="0" Canvas.Right="0"
                       Width="{StaticResource HUDProductionWarningIconSize}"
                       Height="{StaticResource HUDProductionWarningIconSize}"
                       Source="pack://application:,,,/WPFGUI;component/icons/production_warning.png"
                       Visibility="{Binding BlockedByEarlierProduction, Converter={StaticResource BoolToVis}}" />
            </Canvas>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="GlobalBuildQueueStackButtonTemplate" DataType="{x:Type model:ProductionTileStackModel}">
        <Grid Width="{StaticResource HUDBuildQueueIconSize}"
              Height="{StaticResource HUDBuildQueueIconSize}"
              DataContext="{Binding DataContext, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Button}}}">
            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource IssuableIconPresenter}" />
            <Canvas>
                <!--  spawn productions in guc have no progress bar  -->

                <!--  Glow red when production halted on a tile in stack  -->
                <Rectangle Width="{StaticResource HUDBuildQueueIconSize}" Height="{StaticResource HUDBuildQueueIconSize}">
                    <Rectangle.Style>
                        <Style TargetType="{x:Type Rectangle}">
                            <Setter Property="Fill">
                                <Setter.Value>
                                    <RadialGradientBrush>
                                        <GradientStop Offset="0.6" Color="#40c93527" />
                                        <GradientStop Offset="1" Color="#c93527" />
                                    </RadialGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding BlockedByEarlierProduction}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard Name="Pulse">
                                            <Storyboard AutoReverse="True" RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1"
                                                                 To="0.5" Duration="0:0:0.5" />
                                                <DoubleAnimation Storyboard.TargetProperty="Fill.(GradientBrush.GradientStops)[0].(GradientStop.Offset)" From="0.3"
                                                                 To="0.7" Duration="0:0:0.5" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="Pulse" />
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Rectangle.Style>
                </Rectangle>

                <!--
                    Warning indicator when production halted on top tile in stack or blocked by earlier production in its queue
                    BlockedByEarlierProduction actually includes self since there were issues with MultiLogicalAnd/IsBlocked/BlockedByEarlierProduction
                -->
                <Image Canvas.Top="0" Canvas.Right="0"
                       Width="{StaticResource HUDProductionWarningIconSize}"
                       Height="{StaticResource HUDProductionWarningIconSize}"
                       Source="pack://application:,,,/WPFGUI;component/icons/production_warning.png"
                       Visibility="{Binding BlockedByEarlierProduction, Converter={StaticResource BoolToVis}}" />
            </Canvas>
        </Grid>
    </DataTemplate>

