                                                       VerticalAlignment="Center"
                                                       Style="{StaticResource UniqueToCivIcon}" />

                                                <!--  $11219856: Unique to Chinese  -->
                                                <TextBlock VerticalAlignment="Center"
                                                           Style="{StaticResource nHUDBodyTextBlockStyle}"
                                                           Text="{esUtility:LocString $11219856}" />
                                            </StackPanel>
