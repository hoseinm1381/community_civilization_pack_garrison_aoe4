                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Grid Width="47" Height="47"
                                              HorizontalAlignment="Left" VerticalAlignment="Top">
