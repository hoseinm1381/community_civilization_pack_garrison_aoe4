    <!--  Income stat  -->
    <DataTemplate x:Key="BrawlStatHeaderTemplate_Income">
        <ContentPresenter Width="{StaticResource BrawlStatColumnWidth}"
                          HorizontalAlignment="Center"
                          Content="/WPFGUI;component/icons/resources/resource_gold_icon.png"
                          ContentTemplate="{StaticResource BrawlStatHeaderTemplate}"
                          ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="86400000">
            <ContentPresenter.ToolTip>
                <ToolTip Style="{StaticResource HUDTooltipStyle}">
                    <!--  $11262610: Income per round  -->
                    <TextBlock Margin="4" VerticalAlignment="Center"
                               Style="{StaticResource HUDWhiteSubtitleAltTextBlock18ptStyle}"
                               Text="{esUtility:LocString $11262610}" />
                </ToolTip>
            </ContentPresenter.ToolTip>
        </ContentPresenter>
    </DataTemplate>

    <DataTemplate x:Key="BrawlStatValueTemplate_Income">
        <Grid Width="{StaticResource BrawlStatColumnWidth}"
              Height="{StaticResource BrawlStatRowHeight}"
              HorizontalAlignment="Center">
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{Binding [player_color]}"
                       Style="{StaticResource HUDWhiteSubtitleAltTextBlock18ptStyle}"
                       Text="{Binding [income], Converter={StaticResource CastToIntOperator}}" />
        </Grid>
    </DataTemplate>

    <!--  Kills stat  -->
    <DataTemplate x:Key="BrawlStatHeaderTemplate_Kills">
        <ContentPresenter Width="{StaticResource BrawlStatColumnWidth}"
                          HorizontalAlignment="Center"
                          Content="/WPFGUI;component/icons/common/orders/attack_move.png"
                          ContentTemplate="{StaticResource BrawlStatHeaderTemplate}"
                          ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="86400000">
            <ContentPresenter.ToolTip>
                <ToolTip Style="{StaticResource HUDTooltipStyle}">
                    <!--  $11168079: Killed  -->
                    <TextBlock Margin="4" VerticalAlignment="Center"
                               Style="{StaticResource HUDWhiteSubtitleAltTextBlock18ptStyle}"
                               Text="{esUtility:LocString $11168079}" />
                </ToolTip>
            </ContentPresenter.ToolTip>
        </ContentPresenter>
    </DataTemplate>

    <DataTemplate x:Key="BrawlStatValueTemplate_Kills">
        <Grid Width="{StaticResource BrawlStatColumnWidth}"
              Height="{StaticResource BrawlStatRowHeight}"
              HorizontalAlignment="Center">
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                       Style="{StaticResource HUDWhiteSubtitleAltTextBlock18ptStyle}"
                       Text="{Binding [killed], Converter={StaticResource CastToIntOperator}}" />
        </Grid>
    </DataTemplate>

    <!--  Losses stat  -->
    <DataTemplate x:Key="BrawlStatHeaderTemplate_Losses">
        <ContentPresenter Width="{StaticResource BrawlStatColumnWidth}"
                          HorizontalAlignment="Center"
                          Content="/WPFGUI;component/icons/common/orders/scuttle.png"
                          ContentTemplate="{StaticResource BrawlStatHeaderTemplate}"
                          ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="86400000">
            <ContentPresenter.ToolTip>
                <ToolTip Style="{StaticResource HUDTooltipStyle}">
                    <!--  $11168079: Killed  -->
                    <TextBlock Margin="4" VerticalAlignment="Center"
                               Style="{StaticResource HUDWhiteSubtitleAltTextBlock18ptStyle}"
                               Text="{esUtility:LocString $11168085}" />
                </ToolTip>
            </ContentPresenter.ToolTip>
        </ContentPresenter>
    </DataTemplate>

    <DataTemplate x:Key="BrawlStatValueTemplate_Losses">
        <Grid Width="{StaticResource BrawlStatColumnWidth}"
              Height="{StaticResource BrawlStatRowHeight}"
              HorizontalAlignment="Center">
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                       Style="{StaticResource HUDWhiteSubtitleAltTextBlock18ptStyle}"
                       Text="{Binding [lost], Converter={StaticResource CastToIntOperator}}" />
        </Grid>
    </DataTemplate>

    <Style x:Key="BrawlStatsDisplayStyle" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Control}">
                    <Grid>
                        <!--  This is animated [0-1]  -->
                        <Decorator Name="BrawlStatViewerContentSizeRatioProxy"
                                   Height="1"
                                   Visibility="Hidden" />

                        <Decorator Name="BrawlStatViewerHeaderMinWidthProxy" Visibility="Hidden">
                            <Decorator.Width>
                                <MultiBinding Converter="{StaticResource MultiAddOperator}">
                                    <Binding ElementName="BrawlStatViewerModeSwitchToggleWrapper" Path="ActualWidth" />
                                    <Binding ElementName="BrawlStatViewerTimerWrapper" Path="ActualWidth" />
                                </MultiBinding>
                            </Decorator.Width>
                        </Decorator>

                        <Decorator Name="BrawlStatViewerHorizontalExpantionProxy">
                            <Decorator.Width>
                                <MultiBinding Converter="{StaticResource MultiLerpOffset}">
                                    <Binding ElementName="BrawlStatViewerContentSizeRatioProxy" Path="Height" />
                                    <Binding ElementName="BrawlStatViewerHeaderMinWidthProxy" Path="Width" />
                                    <Binding ElementName="BrawlStatsContentCanvas" Path="ActualWidth" />
                                </MultiBinding>
                            </Decorator.Width>
                        </Decorator>

                        <ContentControl Margin="4"
                                        IsTabStop="False"
                                        Template="{StaticResource CanvasTertiaryGradientBackgroundBox}">
                            <Border BorderBrush="{DynamicResource TertiaryColorLightBrush}" BorderThickness="2">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Decorator Name="BrawlStatViewerModeSwitchToggleWrapper"
                                               Grid.Row="0" Grid.Column="0"
                                               HorizontalAlignment="Left" VerticalAlignment="Top">
                                        <ToggleButton x:Name="BrawlStatViewerModeSwitchToggle"
                                                      Margin="-4,-4,12,0" HorizontalAlignment="Left"
                                                      VerticalAlignment="Top"
                                                      esUtility:Telemetry.Name="BrawlStatsMinimize" IsChecked="True"
                                                      IsTabStop="False"
                                                      Style="{StaticResource HUDExpanderToggleButtonWithBorderStyle}">
                                            <ToggleButton.Resources>
                                                <sys:Double x:Key="ExpandedToggleButtonGridAngleMin">0</sys:Double>
                                                <sys:Double x:Key="ExpandedToggleButtonGridAngleMax">180</sys:Double>
                                            </ToggleButton.Resources>
                                        </ToggleButton>
                                    </Decorator>

                                    <Decorator Name="BrawlStatViewerTimerWrapper"
                                               Grid.Row="0" Grid.Column="1"
                                               HorizontalAlignment="Right" VerticalAlignment="Top">
                                        <Grid MinHeight="22"
                                              Margin="5,6,10,6" HorizontalAlignment="Right"
                                              VerticalAlignment="Top">
                                            <TextBlock VerticalAlignment="Center"
                                                       Style="{StaticResource HUDWhiteSubtitleAltTextBlock14ptStyle}"
                                                       Text="{Binding [next_income_timer], Converter={StaticResource LocalizedStringConverter}, ConverterParameter=$11262578}" />
                                        </Grid>
                                    </Decorator>

                                    <Grid Grid.Row="1" Grid.Column="0"
                                          Grid.ColumnSpan="2"
                                          HorizontalAlignment="Left" VerticalAlignment="Top"
                                          ClipToBounds="True">
                                        <Grid.Height>
                                            <MultiBinding Converter="{StaticResource MultiMultiplyOperator}">
                                                <Binding ElementName="BrawlStatViewerContentSizeRatioProxy" Path="Height" />
                                                <Binding ElementName="BrawlStatsContentCanvas" Path="ActualHeight" />
                                            </MultiBinding>
                                        </Grid.Height>
                                        <Grid.Width>
                                            <MultiBinding Converter="{StaticResource MultiAddOperator}">
                                                <Binding ElementName="BrawlStatViewerHeaderMinWidthProxy" Path="Width" />
                                                <Binding ElementName="BrawlStatViewerHorizontalExpantionProxy" Path="Width" />
                                            </MultiBinding>
                                        </Grid.Width>

                                        <Canvas Name="BrawlStatsContentCanvas"
                                                Width="{Binding ElementName=BrawlStatsContentWrapper, Path=ActualWidth}"
                                                Height="{Binding ElementName=BrawlStatsContentWrapper, Path=ActualHeight}"
                                                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                ClipToBounds="True">
                                            <Border Name="BrawlStatsContentWrapper"
                                                    Canvas.Left="0" Canvas.Top="0">
                                                <StackPanel Margin="8,4,8,8">
                                                    <ListView IsTabStop="False"
                                                              ItemsSource="{Binding [factions]}"
                                                              Style="{StaticResource HUDStatListViewStyle}">
                                                        <ListView.View>
                                                            <GridView AllowsColumnReorder="False">
                                                                <GridView.ColumnHeaderContainerStyle>
                                                                    <Style BasedOn="{StaticResource GridCellHeader}" TargetType="{x:Type GridViewColumnHeader}">
                                                                        <Setter Property="BorderThickness" Value="0" />
                                                                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                                                                        <Setter Property="VerticalContentAlignment" Value="Center" />
                                                                    </Style>
                                                                </GridView.ColumnHeaderContainerStyle>
                                                                <!--  shared stats  -->
                                                                <GridViewColumn Width="{StaticResource BrawlPlayerColumnWidth}"
                                                                                CellTemplate="{StaticResource BrawlStatValueTemplate_PlayerName}"
                                                                                HeaderTemplate="{StaticResource BrawlStatHeaderTemplate_PlayerName}" />

                                                                <GridViewColumn Width="{StaticResource BrawlStatColumnWidth}"
                                                                                CellTemplate="{StaticResource BrawlStatValueTemplate_Income}"
                                                                                HeaderTemplate="{StaticResource BrawlStatHeaderTemplate_Income}" />

                                                                <!--
                                                                    Commenting these out to remove the Kills/Losses from Towers,
                                                                    leaving here in case we want to bring them back later on
                                                                -->

                                                                <!-- <GridViewColumn Width="{StaticResource BrawlStatColumnWidth}"
                                                                                CellTemplate="{StaticResource BrawlStatValueTemplate_Kills}"
                                                                                HeaderTemplate="{StaticResource BrawlStatHeaderTemplate_Kills}" />

                                                                <GridViewColumn Width="{StaticResource BrawlStatColumnWidth}"
                                                                                CellTemplate="{StaticResource BrawlStatValueTemplate_Losses}"
                                                                                HeaderTemplate="{StaticResource BrawlStatHeaderTemplate_Losses}" />-->
                                                            </GridView>
                                                        </ListView.View>
                                                    </ListView>

                                                    <Separator Margin="0,6,0,8" HorizontalAlignment="Stretch"
                                                               Style="{StaticResource CardSeparatorStyle}" />

                                                    <!--  $11262609 - Victory at %1INCOME% income  -->
                                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                                               esControls:TextBlockExtensions.AutoToolTip="True"
                                                               Style="{StaticResource HUDPrimaryColorGradientVerticalSubtitleTextBlock14ptStyle}"
                                                               Text="{Binding [income_victory_goal], Converter={StaticResource LocalizedStringConverter}, ConverterParameter=$11262609}"
                                                               TextTrimming="CharacterEllipsis" ToolTipService.InitialShowDelay="0"
                                                               ToolTipService.ShowDuration="86400000" ToolTipService.ShowOnDisabled="True">
                                                        <TextBlock.ToolTip>
                                                            <ToolTip Style="{StaticResource HUDBaseAutoTooltipStyle}" />
                                                        </TextBlock.ToolTip>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </Canvas>
                                    </Grid>
                                </Grid>
                            </Border>
                        </ContentControl>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="ToggleButton.Unchecked" SourceName="BrawlStatViewerModeSwitchToggle">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation BeginTime="0:0:0"
                                                     EasingFunction="{StaticResource CircleEaseIn}"
                                                     Storyboard.TargetName="BrawlStatViewerContentSizeRatioProxy" Storyboard.TargetProperty="Height"
                                                     To="0" Duration="0:0:0.25" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="ToggleButton.Checked" SourceName="BrawlStatViewerModeSwitchToggle">
                            <EventTrigger.EnterActions />
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation BeginTime="0:0:0"
                                                     EasingFunction="{StaticResource CircleEaseOut}"
                                                     Storyboard.TargetName="BrawlStatViewerContentSizeRatioProxy" Storyboard.TargetProperty="Height"
                                                     To="1" Duration="0:0:0.25" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="PauseMenuPlayerCard" DataType="{x:Type model:PlayerModel}">
        <Grid Width="590" Height="177"
              Background="{DynamicResource TertiaryColorDarkBrush}"
              Effect="{DynamicResource DropShadowInGamePanelStyle}">
            <Image HorizontalAlignment="Right" Source="{Binding Race.PatternImagePath}" />

            <Grid Margin="50,20,20,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Team #  -->
                <TextBlock Foreground="{Binding RelationshipColor, Converter={StaticResource SolidColorBrushConverter}}">
                    <TextBlock.Style>
                        <Style BasedOn="{StaticResource BaseTextBlockStyleHalfScale}" TargetType="{x:Type TextBlock}">
                            <Setter Property="Text" Value="{Binding TeamNumber, Converter={StaticResource LocalizedStringConverter}, ConverterParameter=$11162573}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDarkColor}" Value="True">
                                    <Setter Property="Effect" Value="{StaticResource TextLightDropShadowEffect}" />
                                </DataTrigger>
                                <!--  No Team  -->
                                <DataTrigger Binding="{Binding TeamNumber, Converter={StaticResource LessCompare}, ConverterParameter=0}" Value="True">
                                    <Setter Property="Text" Value="{Binding Converter={StaticResource UnboundLocStringConverter}, ConverterParameter=$11169276}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Grid Grid.Row="1" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!--  Civ icon  -->
                    <Image Width="52"
                           Effect="{DynamicResource ButtonDropShadowEffect}"
                           Source="{Binding RaceIcon}" />

                    <!--  Player civ name  -->
                    <TextBlock Grid.Column="1"
                               Margin="10,5,0,0" VerticalAlignment="Center"
                               Style="{StaticResource SubtitleTextBlockStyleHalfScale}"
                               Text="{Binding RaceName}"
                               TextWrapping="Wrap" />
                </Grid>

                <!--  Player Name  -->
                <Grid Grid.Row="2"
                      HorizontalAlignment="Left" VerticalAlignment="Bottom">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Foreground="{Binding RelationshipColor, Converter={StaticResource SolidColorBrushConverter}}"
                                   Text="{Binding Name}"
                                   TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style BasedOn="{StaticResource TitleTextBlockStyle}" TargetType="{x:Type TextBlock}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDarkColor}" Value="True">
                                            <Setter Property="Effect" Value="{StaticResource TextLightDropShadowEffect}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!--  Crossplay Info  -->
                        <ContentControl Grid.Column="1"
                                        Margin="4,0" HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Content="{Binding Profile}"
                                        IsHitTestVisible="False" IsTabStop="False"
                                        Style="{StaticResource CrossplayIndicatorStyle}" />
                    </Grid>

                    <ContentControl Grid.Column="1"
                                    HorizontalAlignment="Left"
                                    Content="{Binding Profile}"
                                    IsTabStop="False">
                        <ContentControl.Resources>
                            <DataTemplate DataType="{x:Type model:PlayerProfileModel}">
                                <StackPanel Orientation="Horizontal">
                                    <!--  Chat Banned Icon  -->
                                    <Image Width="32"
                                           Source="/WPFGUI;component/images/fe/fe_chat_ban.png"
                                           Visibility="{Binding IsChatBanned, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}" />
                                    <!--  Voice Chat Banned Icon  -->
                                    <Image Width="32" Source="{StaticResource MicBlockedIcon}">
                                        <Image.Visibility>
                                            <MultiBinding Converter="{StaticResource MultiLogicalAnd}">
                                                <Binding Converter="{StaticResource BoolToVis}" Path="IsChatBanned" />
                                                <Binding Converter="{StaticResource BoolToVis}" Path="UsesVoiceChat" />
                                            </MultiBinding>
                                        </Image.Visibility>
                                    </Image>
                                </StackPanel>
                            </DataTemplate>
                        </ContentControl.Resources>
                    </ContentControl>
                </Grid>

                <!--  Rank Image  -->
                <ContentControl x:Name="RankImage"
                                Grid.RowSpan="3" Grid.Column="1"
                                Height="140"
                                Margin="{StaticResource ExtraSmallMarginLeftRight}"
                                IsTabStop="False"
                                Visibility="{Binding IsRankedMatch, Source={x:Static loadModel:LoadMultiplayerModel.Instance}, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                    <ContentControl.Style>
                        <Style BasedOn="{StaticResource RankEmblemControlStyle}" TargetType="{x:Type ContentControl}">
                            <Setter Property="Content" Value="{Binding Profile.CommunityEventManager.RankedSeasons[0].Ranked1v1Season}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTeamsMatch, Source={x:Static loadModel:LoadMultiplayerModel.Instance}}" Value="True">
                                    <Setter Property="Content" Value="{Binding Profile.CommunityEventManager.RankedSeasons[0].RankedTeamsSeason}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
            </Grid>

            <Grid Margin="-50,-15,0,0" HorizontalAlignment="Left"
                  VerticalAlignment="Top">
                <!--  Coat Of Arms  -->
                <ContentControl Height="185" MaxWidth="90"
                                Margin="0,47,0,-30"
                                Content="{Binding Profile}"
                                Effect="{DynamicResource ButtonDropShadowEffect}"
                                IsTabStop="False">
                    <ContentControl.Resources>
                        <DataTemplate DataType="{x:Type model:PlayerProfileModel}">
                            <Control DataContext="{Binding CoatOfArms}"
                                     IsTabStop="False"
                                     Template="{StaticResource CoatOfArmsControlNoBannerTop}" />
                        </DataTemplate>
                    </ContentControl.Resources>
                </ContentControl>

                <!--  Portrait  -->
                <ContentControl Margin="-10,-10,-10,0" HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Content="{Binding Profile}"
                                Effect="{StaticResource ButtonDropShadowEffect}"
                                IsTabStop="False">
                    <ContentControl.Style>
                        <Style TargetType="{x:Type FrameworkElement}">
                            <Setter Property="Height" Value="100" />
                            <Setter Property="Width" Value="100" />
                        </Style>
                    </ContentControl.Style>

                    <ContentControl.Resources>
                        <DataTemplate DataType="{x:Type model:PlayerProfileModel}">
                            <ContentPresenter ContentTemplate="{StaticResource PlayerPortrait}" />
                        </DataTemplate>
                    </ContentControl.Resources>
                </ContentControl>
            </Grid>
        </Grid>
    </DataTemplate>

    <Style x:Key="MultiplayerPausePanel" TargetType="ContentControl">
        <Setter Property="MinHeight" Value="200" />
        <Setter Property="MinWidth" Value="400" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContentControl}">
                    <Grid AutomationProperties.AutomationId="{esUtility:LocString $1000641}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <!--  0 Title  -->
                                <RowDefinition Height="*" />
                                <!--  1 Time  -->
                                <RowDefinition Height="*" />
                                <!--  1 Banner  -->
                                <RowDefinition Height="*" />
                                <!--  1 Pauses Remaining  -->
                                <RowDefinition Height="*" />
                                <!--  2 Button Bar  -->
                                <RowDefinition Height="70" />
                            </Grid.RowDefinitions>

                            <!--  $1000641 - Game Paused  -->
                            <TextBlock Grid.Row="0"
                                       Margin="{StaticResource SmallMarginBottom}"
                                       HorizontalAlignment="Center" VerticalAlignment="Top"
                                       Style="{StaticResource SubheaderTextBlockStyle}"
                                       Text="{esUtility:LocString $1000641}" />

                            <!--  Remaining Time  -->
                            <TextBlock Grid.Row="1"
                                       Margin="{StaticResource SmallMarginBottom}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Text="{Binding MPPause.UnpauseAvailabilityTimer, Mode=OneWay, Converter={StaticResource ShorthandTimeFormat}, ConverterParameter=$1272}">
                                <TextBlock.Style>
                                    <Style BasedOn="{StaticResource BaseTextBlockStyle}" TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Value="True">
                                                <DataTrigger.Binding>
                                                    <MultiBinding Converter="{StaticResource MultiLEqualCompare}" ConverterParameter="0">
                                                        <Binding Converter="{StaticResource CastToSingleOperator}" Path="MPPause.UnpauseAvailabilityTimer" />
                                                    </MultiBinding>
                                                </DataTrigger.Binding>
                                                <Setter Property="Visibility" Value="Hidden" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <ContentControl Grid.Row="2"
                                            Margin="{StaticResource SmallMarginTopBottom}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Content="{Binding MPPause.PauseExecutorInfo}"
                                            ContentTemplate="{StaticResource PauseMenuPlayerCard}"
                                            IsTabStop="False" />

                            <TextBlock Grid.Row="3"
                                       Margin="{StaticResource SmallMarginTopBottom}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Style="{StaticResource BodyTextBlockStyle}">
                                <TextBlock.Text>
                                    <!--  $11263692 - Remaining %1AMOUNT%/%2TOTAL%  -->
                                    <MultiBinding Converter="{StaticResource LocalizedStringMultiConverter}" ConverterParameter="$11263692">
                                        <Binding Mode="OneWay" Path="MPPause.RemainingPauseCount" />
                                        <Binding Mode="OneWay" Path="MPPause.TotalPauseCount" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>

                            <!--  2 Resume Button  -->
                            <Button Name="ResumeButton"
                                    Grid.Row="4"
                                    Padding="62,10" HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    AutomationProperties.ItemType="{esUtility:LocString $11192481}"
                                    AutomationProperties.Name="{esUtility:LocString $11037980}"
                                    Command="{Binding MPPause.Unpause}"
                                    Content="{esUtility:LocString $11037980}"
                                    Style="{StaticResource PrimaryAnimatedTextButton}"
                                    ToolTipService.InitialShowDelay="0"
                                    ToolTipService.IsEnabled="{Binding IsEnabled, Converter={StaticResource InvBool}, RelativeSource={RelativeSource Self}}"
                                    ToolTipService.ShowDuration="86400000" ToolTipService.ShowOnDisabled="True">
                                <Button.ToolTip>
                                    <ToolTip Style="{StaticResource HUDTooltipStyle}">
                                        <TextBlock MaxWidth="400"
                                                   Style="{StaticResource BaseTextBlockStyle}"
                                                   Text="{esUtility:LocString $11263723}"
                                                   TextWrapping="Wrap" />
                                    </ToolTip>
                                </Button.ToolTip>
                            </Button>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Vietnam 0.7.10: local presentation, original China template untouched. -->
    <DataTemplate x:Key="VietnamBuffaloCounter" DataType="{x:Type model:HUDModelBase}">
        <Grid Width="{StaticResource SmallWidgetDisplayGridWidth}">
            <Canvas><Image Canvas.Right="-6" Canvas.Bottom="-2"
                Width="{StaticResource SmallWidgetDisplayBackgroundWidth}" Stretch="UniformToFill"
                Style="{DynamicResource HUDCivSpecific2BackgroundImage}" /></Canvas>
            <Button Height="{StaticResource HUDResourceButtonHeight}" Margin="6,0,8,10"
                HorizontalContentAlignment="Stretch" Style="{DynamicResource HUDButtonStyle}"
                IsHitTestVisible="True" Background="Transparent"
                Command="{Binding LocalPlayer.ScarModel[vietnam_buffalo_cycle]}"
                ToolTip="Water Buffalo — living / current limit. Click to select the next buffalo.">
                <Button.IsEnabled><Binding Path="LocalPlayer.ScarModel[vietnam_buffalo_can_cycle]" /></Button.IsEnabled>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Image Width="27" Height="27" Margin="4,0,2,0" Source="/WPFGUI;component/images/vietnam_0710/buffalo.png" />
                    <TextBlock Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource nHUDBaseHeavyTextBlockStyle}">
                        <TextBlock.Text><Binding Path="LocalPlayer.ScarModel[vietnam_buffalo_text]" /></TextBlock.Text>
                    </TextBlock>
                </Grid>
            </Button>
        </Grid>
    </DataTemplate>
    <DataTemplate x:Key="VietnamBuffaloSupervisionTemplate">
        <Border Width="48" Height="48" Background="#D020281B" BorderBrush="#E7C66F" BorderThickness="2" CornerRadius="24" Opacity="0.95" IsHitTestVisible="False">
            <Image Width="40" Height="40" Source="/WPFGUI;component/images/vietnam_0710/buffalo.png" IsHitTestVisible="False" />
        </Border>
    </DataTemplate>

</ResourceDictionary>