                                                                Orientation="Vertical">
                                                        <TextBlock Style="{StaticResource nHUDBaseTextBlockStyle}" Text="{esUtility:LocString $11270967}" />
                                                        <TextBlock Style="{StaticResource nHUDSubtitleTextBlockStyle}" Text="{esUtility:LocString $11195006}" />
                                                        <TextBlock Margin="{StaticResource SmallMarginTop}"
                                                                   Style="{StaticResource nHUDBodyTextBlockStyle}"
                                                                   TextWrapping="Wrap">
                                                            <TextBlock.Text>
                                                                <MultiBinding Converter="{StaticResource LocalizedStringMultiConverter}" ConverterParameter="$11271351">
                                                                    <Binding Converter="{StaticResource CastToIntOperator}"
