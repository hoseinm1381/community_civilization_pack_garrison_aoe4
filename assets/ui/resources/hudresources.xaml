    <Storyboard x:Key="TagDataMouseAnimation">
        <!--  Blinking Mouse Button Animations  -->
        <DoubleAnimation AutoReverse="True" BeginTime="0:0:0.55"
                         RepeatBehavior="Forever"
                         Storyboard.TargetName="MouseIcon" Storyboard.TargetProperty="Opacity"
                         From="0" To="1"
                         Duration="0:0:0.5" />
        <DoubleAnimation BeginTime="0:0:0.55"
                         Storyboard.TargetName="EmptyMouseIcon" Storyboard.TargetProperty="Opacity"
                         From="0" To="1" />
    </Storyboard>

    <Storyboard x:Key="TagDataGlowAnimation">
        <!--  Text Animations  -->
        <DoubleAnimation BeginTime="0:0:0.55"
                         Storyboard.TargetName="Text" Storyboard.TargetProperty="Opacity"
                         From="0" To="1" />
        <!--  Glow Animations  -->
        <DoubleAnimation BeginTime="0:0:0.5"
                         EasingFunction="{StaticResource QuadEaseOut}"
                         Storyboard.TargetName="ContentGlow" Storyboard.TargetProperty="Opacity"
                         From="0" To="1"
                         Duration="0:0:0.05" />
        <DoubleAnimation BeginTime="0:0:0.55"
                         EasingFunction="{StaticResource QuadEaseInOut}"
                         Storyboard.TargetName="ContentGlow" Storyboard.TargetProperty="Opacity"
                         From="1" To="0"
                         Duration="0:0:0.75" />
        <DoubleAnimation BeginTime="0:0:0.5"
                         EasingFunction="{StaticResource QuadEaseOut}"
                         Storyboard.TargetName="ContentGlowInner" Storyboard.TargetProperty="Opacity"
                         From="0" To="1"
                         Duration="0:0:0.05" />
        <DoubleAnimation BeginTime="0:0:0.55"
                         EasingFunction="{StaticResource QuadEaseInOut}"
                         Storyboard.TargetName="ContentGlowInner" Storyboard.TargetProperty="Opacity"
                         From="1" To="0"
                         Duration="0:0:0.75" />
        <!--  Edge Glow Animations  -->
        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TopEdgeGlow" Storyboard.TargetProperty="Opacity">
            <LinearDoubleKeyFrame KeyTime="0:0:0.5" Value="0" />
            <LinearDoubleKeyFrame KeyTime="0:0:0.55" Value="1" />
            <LinearDoubleKeyFrame KeyTime="0:0:0.6" Value="1" />
            <LinearDoubleKeyFrame KeyTime="0:0:2" Value="0" />
        </DoubleAnimationUsingKeyFrames>
        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TopEdgeGlowInner" Storyboard.TargetProperty="Opacity">
            <LinearDoubleKeyFrame KeyTime="0:0:0.5" Value="0" />
            <LinearDoubleKeyFrame KeyTime="0:0:0.55" Value="1" />
            <LinearDoubleKeyFrame KeyTime="0:0:0.6" Value="1" />
            <LinearDoubleKeyFrame KeyTime="0:0:2" Value="0" />
        </DoubleAnimationUsingKeyFrames>
    </Storyboard>

    <Storyboard x:Key="BuffPulseAnimation">
        <DoubleAnimationUsingKeyFrames RepeatBehavior="Forever" Storyboard.TargetProperty="(UIElement.Opacity)">
            <EasingDoubleKeyFrame KeyTime="0" Value="0.5" />
            <EasingDoubleKeyFrame KeyTime="0:0:1" Value="1" />
            <EasingDoubleKeyFrame KeyTime="0:0:2" Value="0.5" />
        </DoubleAnimationUsingKeyFrames>
    </Storyboard>

    <DataTemplate x:Key="TagDataTemplate">
        <ContentPresenter Name="TagBody"
                          Content="{Binding}"
                          RenderTransformOrigin="0.5,0.5">
            <ContentPresenter.RenderTransform>
                <TransformGroup>
                    <TranslateTransform x:Name="TagTranslate" />
                    <ScaleTransform x:Name="TagScale" />
                </TransformGroup>
            </ContentPresenter.RenderTransform>

            <ContentPresenter.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.SizeChanged">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation EasingFunction="{StaticResource QuadEaseInOut}"
                                             Storyboard.TargetName="TagScale" Storyboard.TargetProperty="(ScaleTransform.ScaleY)"
                                             From="1.5" To="0.95"
                                             Duration="0:0:0.33" />
                            <DoubleAnimation EasingFunction="{StaticResource QuadEaseInOut}"
                                             Storyboard.TargetName="TagScale" Storyboard.TargetProperty="(ScaleTransform.ScaleX)"
                                             From="1.5" To="0.95"
                                             Duration="0:0:0.33" />
                            <DoubleAnimation BeginTime="0:0:0.33"
                                             EasingFunction="{StaticResource QuadEaseInOut}"
                                             Storyboard.TargetName="TagScale" Storyboard.TargetProperty="(ScaleTransform.ScaleY)"
                                             From="0.95" To="1"
                                             Duration="0:0:0.25" />
                            <DoubleAnimation BeginTime="0:0:0.33"
                                             EasingFunction="{StaticResource QuadEaseInOut}"
                                             Storyboard.TargetName="TagScale" Storyboard.TargetProperty="(ScaleTransform.ScaleX)"
                                             From="0.95" To="1"
                                             Duration="0:0:0.25" />
                            <DoubleAnimation Storyboard.TargetName="TagBody" Storyboard.TargetProperty="Opacity"
                                             From="0" To="1"
                                             Duration="0:0:0.5" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </ContentPresenter.Triggers>

