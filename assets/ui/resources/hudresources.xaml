                                                       Style="{StaticResource nHUDTitleTextBlockStyle}"
                                                       Text="{Binding [current_dynasty][upgrade][name]}" />
                                            <TextBlock Margin="0,0,0,15"
                                                       Style="{StaticResource nHUDSubtitleTextBlockStyle}"
                                                       Text="{Binding [current_dynasty][upgrade][extra]}" />
                                            <StackPanel Margin="0,0,0,20" Orientation="Horizontal">
