    </Style>

    <DataTemplate x:Key="BrawlStatHeaderTemplate">
        <Grid Width="{StaticResource BrawlStatColumnWidth}"
              Height="{StaticResource BrawlStatRowHeight}"
              HorizontalAlignment="Center">
            <Image Height="{StaticResource BrawlStatRowHeight}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Source="{Binding}" />
        </Grid>
    </DataTemplate>

    <!--  Player Stat  -->
    <DataTemplate x:Key="BrawlStatHeaderTemplate_PlayerName">
        <!--  $11171386: PLAYER  -->
        <Grid Width="{StaticResource BrawlPlayerColumnWidth}" Height="{StaticResource BrawlStatRowHeight}">
            <TextBlock Margin="5,0,0,0" HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       esControls:TextBlockExtensions.AutoToolTip="True"
                       Style="{StaticResource HUDWhiteSubtitleAltTextBlock18ptStyle}"
                       Text="{esUtility:LocString $11171386}"
                       TextTrimming="CharacterEllipsis" ToolTipService.InitialShowDelay="0"
                       ToolTipService.ShowDuration="86400000">
                <TextBlock.ToolTip>
                    <ToolTip Style="{StaticResource HUDBaseAutoTooltipAllCapsStyle}" />
                </TextBlock.ToolTip>
            </TextBlock>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="BrawlStatValueTemplate_PlayerName">
        <Grid Width="{StaticResource BrawlPlayerColumnWidth}"
              Height="{StaticResource BrawlStatRowHeight}"
              VerticalAlignment="Center">
            <TextBlock esControls:TextBlockExtensions.AutoToolTip="True"
                       Text="{Binding [player_name]}"
                       TextTrimming="CharacterEllipsis" ToolTipService.InitialShowDelay="0"
                       ToolTipService.ShowDuration="86400000" ToolTipService.ShowOnDisabled="True">
                <TextBlock.ToolTip>
                    <ToolTip Style="{StaticResource HUDBaseAutoTooltipStyle}" />
                </TextBlock.ToolTip>
                <TextBlock.Style>
                    <Style BasedOn="{StaticResource HUDParentTitleAltTextBlockStyle}" TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{Binding [player_color]}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding [is_defeated]}" Value="True">
                                <Setter Property="Opacity" Value="0.5" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
