                                                                        <BeginStoryboard x:Name="MenganFlashAnimation">
                                                                            <BeginStoryboard.Storyboard>
                                                                                <Storyboard RepeatBehavior="Forever">
                                                                                    <SingleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                                                                                        <EasingSingleKeyFrame KeyTime="0" Value="0" />
                                                                                        <EasingSingleKeyFrame KeyTime="0:0:0.5" Value="1" />
                                                                                        <EasingSingleKeyFrame KeyTime="0:0:1" Value="0" />
                                                                                    </SingleAnimationUsingKeyFrames>
                                                                                </Storyboard>
                                                                            </BeginStoryboard.Storyboard>
                                                                        </BeginStoryboard>
                                                                    </DataTrigger.ExitActions>
                                                                    <DataTrigger.EnterActions>
                                                                        <StopStoryboard BeginStoryboardName="MenganFlashAnimation" />
                                                                    </DataTrigger.EnterActions>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Rectangle.Style>
                                                </Rectangle>

                                                <Rectangle Name="MouseOver"
                                                           Fill="{StaticResource ButtonHighlightBrush}"
                                                           Visibility="Collapsed" />
                                                <Rectangle Name="Highlight"
                                                           Fill="#FF93BED7" Visibility="Collapsed" />

                                                <ContentControl Name="Border" Template="{DynamicResource TexturedSecondaryDarkSingleBorder}">
