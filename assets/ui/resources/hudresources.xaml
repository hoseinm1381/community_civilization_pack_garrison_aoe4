    <Style x:Key="HUDButton" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="true" />
        <Setter Property="SnapsToDevicePixels" Value="true" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Name="Border"
                            BorderBrush="#444444" BorderThickness="1">
                        <Grid>
                            <Rectangle Name="Tint"
                                       Fill="Transparent"
                                       RadiusX="{StaticResource HUDButtonRadiusX}"
                                       RadiusY="{StaticResource HUDButtonRadiusY}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="true">
                            <Setter TargetName="Tint" Property="Fill" Value="#44AAAAAA" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="true">
                            <Setter TargetName="Border" Property="BorderBrush" Value="#888888" />
                            <Setter TargetName="Tint" Property="Fill" Value="#44AAAAFF" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="false">
                            <Setter TargetName="Tint" Property="Fill" Value="#44444444" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="esUtility:AudioAttachedProperty.PreviewMouseLeftButtonUpSound" Value="sfx_ui_hud_inGame_button_play" />
    </Style>
    <Style x:Key="HUDCheckbox" TargetType="{x:Type CheckBox}">
        <Setter Property="OverridesDefaultStyle" Value="true" />
        <Setter Property="SnapsToDevicePixels" Value="true" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <StackPanel Background="Transparent" Orientation="Horizontal">
                        <Grid x:Name="HUDObjectiveCheckboxGroup"
                              Width="15" Height="15">
                            <Rectangle x:Name="Background"
                                       Fill="{DynamicResource TertiaryColorDarkBrush}"
                                       Opacity=".5" />
                            <Rectangle x:Name="Highlight"
                                       Fill="{DynamicResource TertiaryColorLightTransparentGradientVerticalBrush}"
                                       Visibility="Collapsed" />
                            <Rectangle x:Name="Outline"
                                       Stroke="{DynamicResource PrimaryColorGradientVerticalBrush}"
                                       StrokeThickness="1" />
                            <Image Source="/WPFGUI;component/icons/objectives/objective_complete.png" Visibility="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="True">
                            <Setter TargetName="Background" Property="Fill" Value="{DynamicResource TertiaryColorGradientVerticalBrush}" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="true">
                            <Setter TargetName="Highlight" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="true">
                            <Setter TargetName="Background" Property="Fill" Value="{StaticResource PressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="false">
                            <Setter TargetName="Background" Property="Fill" Value="{StaticResource DisabledBackgroundBrush}" />
                            <Setter TargetName="Background" Property="Fill" Value="{StaticResource DisabledBorderBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource DisabledForegroundBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="esUtility:AudioAttachedProperty.PreviewMouseLeftButtonUpSound" Value="sfx_ui_frontend_checkbox_play" />
    </Style>

    <Style x:Key="HUDObjectiveCheckbox"
           BasedOn="{StaticResource HUDCheckbox}"
           TargetType="{x:Type CheckBox}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <StackPanel Background="Transparent" Orientation="Horizontal">
                        <Grid x:Name="HUDObjectiveCheckboxGroup"
                              Width="15" Height="15">
                            <Rectangle x:Name="Background"
                                       Fill="{DynamicResource TertiaryColorDarkBrush}"
                                       Opacity=".5" />
                            <Rectangle x:Name="Highlight"
                                       Fill="{DynamicResource TertiaryColorLightTransparentGradientVerticalBrush}"
                                       Visibility="Collapsed" />
                            <Rectangle x:Name="Outline"
                                       Stroke="{DynamicResource PrimaryColorGradientVerticalBrush}"
                                       StrokeThickness="1" />
                            <Image x:Name="CheckMark"
                                   Source="/WPFGUI;component/icons/objectives/objective_complete.png" Visibility="Collapsed" />
                            <Image x:Name="ObjectiveFailedMark"
                                   Source="/WPFGUI;component/icons/objectives/objective_failed.png" Visibility="Collapsed" />
                        </Grid>
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <!--  DataTrigger to Objective States  -->
                        <DataTrigger Binding="{Binding Path=State}" Value="{x:Static model:ObjectiveState.Complete}">
                            <Setter TargetName="Background" Property="Fill" Value="{DynamicResource TertiaryColorGradientVerticalBrush}" />
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Path=State}" Value="{x:Static model:ObjectiveState.Failed}">
                            <Setter TargetName="Background" Property="Fill" Value="{DynamicResource TertiaryColorGradientVerticalBrush}" />
                            <Setter TargetName="ObjectiveFailedMark" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Path=State}" Value="{x:Static model:ObjectiveState.Incomplete}">
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="true">
                            <Setter TargetName="Highlight" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="true">
                            <Setter TargetName="Background" Property="Fill" Value="{StaticResource PressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="false">
                            <Setter TargetName="Background" Property="Fill" Value="{StaticResource DisabledBackgroundBrush}" />
                            <Setter TargetName="Background" Property="Fill" Value="{StaticResource DisabledBorderBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource DisabledForegroundBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

