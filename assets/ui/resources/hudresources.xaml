    <sys:Double x:Key="DynastyCardWidth">326</sys:Double>
    <sys:Double x:Key="DynastyCardHeight">304</sys:Double>

    <Style x:Key="DynastiesCardStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Effect" Value="{StaticResource DynastyDropShadowEffect}" />
        <Setter Property="Height" Value="{StaticResource DynastyCardHeight}" />
        <Setter Property="Margin" Value="{StaticResource ExtraSmallMarginRight}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid>
                        <Grid.Background>
                            <LinearGradientBrush>
