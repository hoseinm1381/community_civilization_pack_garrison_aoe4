    <Style x:Key="CasterTextBlockFade164" TargetType="TextBlock">
        <Setter Property="MaxWidth" Value="164" />
        <Style.Triggers>
            <DataTrigger Value="True">
                <DataTrigger.Binding>
                    <!--  Overflow is detected by the following expression: ActualWidth >= MaxWidth  -->
                    <MultiBinding Converter="{StaticResource MultiGEqualCompare}">
                        <Binding Path="MaxWidth" RelativeSource="{RelativeSource Self}" />
                        <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" />
                    </MultiBinding>
                </DataTrigger.Binding>
                <Setter Property="OpacityMask">
                    <Setter.Value>
                        <LinearGradientBrush MappingMode="Absolute" StartPoint="0,0" EndPoint="164,0">
                            <!--  We could change StartPoint to be at predetermined pixels from the end later, to keep the look the same irrespective of text length  -->
                            <GradientStop Offset="0" Color="#FFFFFFFF" />
                            <GradientStop Offset="0.8" Color="#FFFFFFFF" />
                            <GradientStop Offset="0.9" Color="#30FFFFFF" />
                            <GradientStop Offset="1" Color="#00FFFFFF" />
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
            </DataTrigger>
        </Style.Triggers>
    </Style>

