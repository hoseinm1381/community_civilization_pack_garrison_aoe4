                                                        </Image>
                                                        <Image Width="14" Height="12"
                                                               Margin="0,3,11,0" HorizontalAlignment="Right"
                                                               VerticalAlignment="Top"
                                                               Source="/WPFGUI;component/icons/races/chinese/dynasties/check_mark_gold.png"
                                                               Visibility="{Binding [built], Converter={StaticResource BoolToVis}}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Grid>
