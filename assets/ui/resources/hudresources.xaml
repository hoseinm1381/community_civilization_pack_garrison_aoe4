                </Grid>
            </Grid>
        </Grid>

        <DataTemplate.Triggers>
            <!--  Tier 1  -->
            <DataTrigger Binding="{Binding LocalPlayer.StateModel.Float[golden_age_level_abb], Converter={StaticResource GreaterCompare}, ConverterParameter=0}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard Name="PulseAnimation" Storyboard="{StaticResource BackgroundPulse}" />
                </DataTrigger.EnterActions>
            </DataTrigger>
            <!--  Tier 2  -->
            <DataTrigger Binding="{Binding LocalPlayer.StateModel.Float[golden_age_level_abb], Converter={StaticResource GreaterCompare}, ConverterParameter=1}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard Name="PulseAnimation2" Storyboard="{StaticResource BackgroundPulse}" />
                </DataTrigger.EnterActions>
            </DataTrigger>
            <!--  Tier 3  -->
            <DataTrigger Binding="{Binding LocalPlayer.StateModel.Float[golden_age_level_abb], Converter={StaticResource GreaterCompare}, ConverterParameter=2}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard Name="PulseAnimation3" Storyboard="{StaticResource BackgroundPulse}" />
                </DataTrigger.EnterActions>
            </DataTrigger>
            <!--  Tier 4  -->
            <DataTrigger Binding="{Binding LocalPlayer.StateModel.Float[golden_age_level_abb], Converter={StaticResource GreaterCompare}, ConverterParameter=3}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard Name="PulseAnimation4" Storyboard="{StaticResource BackgroundPulse}" />
                </DataTrigger.EnterActions>
            </DataTrigger>
            <!--  Max Tier  -->
            <DataTrigger Binding="{Binding LocalPlayer.AbbasidHouseOfWisdomEntity.DistrictInfo.IsTierMax}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard Name="PulseAnimation5" Storyboard="{StaticResource BackgroundPulse}" />
                </DataTrigger.EnterActions>
                <Setter TargetName="BackgroundPulse" Property="Fill" Value="{DynamicResource PrimaryColorGradientVerticalBrush}" />
                <Setter TargetName="Background" Property="Fill" Value="{DynamicResource PrimaryColorDarkGradientVerticalBrush}" />
                <Setter TargetName="BuildingCountText" Property="Foreground" Value="White" />
                <Setter TargetName="BackgroundBorder" Property="Template" Value="{DynamicResource TexturedPrimarySingleBorder}" />
                <Setter TargetName="ProgressBar" Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ProgressBar}">
                            <Grid x:Name="PART_Track" Background="White">
                                <Rectangle Margin="1" Fill="{StaticResource PrimaryColorGradientHorizontalReverseBrush}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding LocalPlayer.AbbasidHouseOfWisdomEntity, Converter={StaticResource NotNullConverter}}" Value="True" />
                    <Condition Binding="{Binding LocalPlayer.AbbasidHouseOfWisdomEntity.DistrictInfo.IsTierMax}" Value="False" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="BuildingCountText" Property="Text">
                    <Setter.Value>
                        <MultiBinding Converter="{StaticResource LocalizedStringMultiConverter}" ConverterParameter="$11004775">
                            <Binding Path="LocalPlayer.AbbasidHouseOfWisdomEntity.DistrictInfo.CurrentDP" />
                            <Binding Path="LocalPlayer.AbbasidHouseOfWisdomEntity.DistrictInfo.UnlockNextTierDP" />
                        </MultiBinding>
                    </Setter.Value>
                </Setter>
            </MultiDataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

