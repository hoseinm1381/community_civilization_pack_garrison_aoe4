                                   Grid.Column="1"
                                   Margin="{StaticResource SmallMarginLeft}"
                                   HorizontalAlignment="Left" VerticalAlignment="Center"
                                   Style="{StaticResource nHUDBaseHeavyTextBlockStyle}"
                                   Text="{Binding PlayerBonusStackMenu.SkillPoints, Converter={StaticResource CastToIntOperator}}" />
                        <TextBlock Name="SkillPointsBlackText"
                                   Grid.Column="1"
                                   Margin="{StaticResource SmallMarginLeft}"
                                   HorizontalAlignment="Left" VerticalAlignment="Center"
                                   Effect="{x:Null}"
                                   Foreground="{DynamicResource BlackColorBrush}"
                                   Opacity="0"
                                   Style="{StaticResource nHUDBaseHeavyTextBlockStyle}"
                                   Text="{Binding PlayerBonusStackMenu.SkillPoints, Converter={StaticResource CastToIntOperator}}" />
                    </Grid>
                    <Button.Triggers>
                        <EventTrigger RoutedEvent="Binding.TargetUpdated">
                            <BeginStoryboard>
                                <Storyboard>
                                    <!--  Fade in/out Black text  -->
                                    <DoubleAnimation BeginTime="0:0:0"
                                                     Storyboard.TargetName="SkillPointsBlackText" Storyboard.TargetProperty="Opacity"
                                                     From="0" To="1"
                                                     Duration="0:0:0.5" />
                                    <DoubleAnimation BeginTime="0:0:2"
                                                     Storyboard.TargetName="SkillPointsBlackText" Storyboard.TargetProperty="Opacity"
                                                     From="1" To="0"
                                                     Duration="0:0:1" />
                                    <!--  Fade out/in White text  -->
                                    <DoubleAnimation BeginTime="0:0:0"
                                                     Storyboard.TargetName="SkillPointsWhiteText" Storyboard.TargetProperty="Opacity"
                                                     From="1" To="0"
                                                     Duration="0:0:0.5" />
                                    <DoubleAnimation BeginTime="0:0:2"
                                                     Storyboard.TargetName="SkillPointsWhiteText" Storyboard.TargetProperty="Opacity"
                                                     From="0" To="1"
                                                     Duration="0:0:1" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Button.Triggers>
                </Button>
                <Grid.ToolTip>
                    <ToolTip Content="{Binding Path=PlacementTarget.DataContext.LocalPlayer.StateModel, RelativeSource={RelativeSource Self}}"
                             Placement="Top" RenderTransformOrigin="0,1"
                             Style="{StaticResource HUDTooltipBorderStyle}">
