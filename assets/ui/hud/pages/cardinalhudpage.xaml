                                    <!--<Grid Margin="0,8,0,0">
                                        <Grid.Visibility>
                                            <MultiBinding Converter="{StaticResource MultiLogicalAnd}" FallbackValue="Collapsed">
                                                <Binding Converter="{StaticResource GreaterCompare}"
                                                         ConverterParameter="0" Path="Progress" />
                                                <Binding Path="IsMonk" />
