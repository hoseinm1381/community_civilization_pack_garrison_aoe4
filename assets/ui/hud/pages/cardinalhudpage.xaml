                                            <ToolTip MaxWidth="300"
                                                     Placement="Top"
                                                     Style="{StaticResource ResourceToolTipStyle}">
                                                <ContentControl IsTabStop="False" Style="{StaticResource HUDTooltipBorderStyle}">
                                                    <TextBlock Style="{StaticResource nHUDBaseTextBlockStyle}"
                                                               Text="{esUtility:LocString $11183106}"
                                                               TextWrapping="Wrap" />
                                                </ContentControl>
                                            </ToolTip>
                                        </Button.ToolTip>
                                        <Image Margin="0,2,0,0" Source="../../icons/camera_rotate_right.png" />
                                    </Button>
                                </Grid>
                            </Grid>
                        </Canvas>

                        <ContentPresenter Canvas.Right="24" Content="{Binding CallToAction}">
                            <Canvas.Top>
                                <MultiBinding Converter="{StaticResource MultiSubtractOperator}">
                                    <Binding>
                                        <Binding.Source>
                                            <sys:Double>103</sys:Double>
                                        </Binding.Source>
                                    </Binding>
                                    <Binding Converter="{StaticResource DivideOperator}"
                                             ConverterParameter="2" ElementName="TextDescription"
                                             Path="ActualHeight" />
                                </MultiBinding>
                            </Canvas.Top>
