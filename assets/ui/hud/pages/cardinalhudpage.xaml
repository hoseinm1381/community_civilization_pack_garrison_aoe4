                                </StackPanel>
                            </DataTemplate>

                        </ItemsControl.Resources>

                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <esControls:AlignedCanvas ChildVerticalAlignment="Bottom" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style>
                                <Style.Setters>
                                    <Setter Property="esControls:TagAdorner.AlignmentMode" Value="Relative" />
                                    <Setter Property="esControls:TagAdorner.HorizontalAnchor" Value="Center" />
                                    <Setter Property="esControls:TagAdorner.VerticalAnchor" Value="Top" />
                                    <Setter Property="esControls:TagAdorner.HorizontalPlacement" Value="Center" />
                                    <Setter Property="esControls:TagAdorner.VerticalPlacement" Value="Top" />
                                    <Setter Property="esControls:TagAdorner.DataTemplate" Value="{StaticResource TagDataTemplate}" />
                                    <Setter Property="esControls:TagAdorner.ArrowDataTemplate" Value="{StaticResource TagArrowDataTemplate}" />
                                    <Setter Property="esControls:TagAdorner.TargetDataTemplate" Value="{StaticResource EmptyTagDataTemplate}" />
                                    <Setter Property="esControls:TagAdorner.ClampMode" Value="Custom" />
                                    <Setter Property="esControls:TagAdorner.IsTagged">
                                        <Setter.Value>
                                            <MultiBinding Converter="{StaticResource IsTaggedConverter}">
                                                <Binding Path="TagVersion" Source="{x:Static model:HUDModel.Instance}" />
                                                <Binding Path="ID" />
                                            </MultiBinding>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="esControls:TagAdorner.Data">
                                        <Setter.Value>
                                            <MultiBinding Converter="{StaticResource TagDataConverter}">
                                                <Binding Path="TagVersion" Source="{x:Static model:HUDModel.Instance}" />
                                                <Binding Path="ID" />
                                            </MultiBinding>
                                        </Setter.Value>
                                    </Setter>
                                </Style.Setters>
                            </Style>
                        </ItemsControl.ItemContainerStyle>

                        <ItemsControl.ItemTemplateSelector>
                            <esModels:DataTemplateSourceSelector Optional="True">
                                <esModels:DataTemplateSourceSelector.Resources>
                                    <DataTemplate x:Key="StoneDepositProgress">
                                        <Grid>
                                            <StackPanel Orientation="Vertical">
                                                <Grid Visibility="{Binding Entity.StateModel.Bool[entity_state_gather_stone], Converter={StaticResource BoolToVis}}">
                                                    <!--
                                                        StoredDataContext is to store the StateTreeTargetingModel.CommittedTarget[COMMITTED_RESOURCE_DEPOSIT]
                                                        so its properties get updated on every frame. Indexers do not get updated
                                                        in the lazy model system
                                                    -->
                                                    <FrameworkElement Name="StoredDataContext" DataContext="{Binding Entity.StateTreeTargetingModel.CommittedTarget[COMMITTED_RESOURCE_DEPOSIT]}" />
                                                    <esControls:CircularProgressBar IsTabStop="False"
                                                                                    Maximum="{Binding ElementName=StoredDataContext, Path=DataContext.ResourceDeposit.InitialAmount, Mode=OneWay}"
                                                                                    Minimum="0"
                                                                                    Style="{StaticResource HUDOvooDepletionCircularProgressBar}"
                                                                                    Visibility="Visible"
                                                                                    Value="{Binding ElementName=StoredDataContext, Path=DataContext.ResourceDeposit.RemainingAmount, Mode=OneWay}" />
                                                </Grid>
                                                <ProgressBar Width="{StaticResource BuildingHealthbarWidth}" Style="{StaticResource HealthBarDecoratorStyle}" />
                                            </StackPanel>
                                            <ProgressBar Width="{StaticResource BuildingHealthbarWidth}"
                                                         Height="{StaticResource BuildingHealthbarHeight}"
                                                         Opacity="{Binding SelectionOpacity}"
                                                         Template="{StaticResource ConstructionProgressBar}"
                                                         Visibility="{Binding Entity.IsConstructionDone, Converter={StaticResource InvBoolToVis}}"
                                                         Value="{Binding Entity.ConstructionProgress, Mode=OneWay}" />
                                        </Grid>
                                    </DataTemplate>

                                    <DataTemplate x:Key="GloriousChargeDecorator">
                                        <StackPanel>
                                            <esControls:CircularProgressBar HorizontalAlignment="Center"
                                                                            Background="White"
                                                                            DataContext="{Binding Entity.AbilitiesLookUp[outpost_glorious_charge_mon_ha_gol]}"
                                                                            IsTabStop="False" Maximum="1"
                                                                            Minimum="0"
                                                                            Style="{StaticResource GloriousChargeCircularProgressBar}"
                                                                            Value="{Binding Progress, Mode=OneWay}">
                                                <esControls:CircularProgressBar.Visibility>
                                                    <MultiBinding Converter="{StaticResource MultiLogicalAnd}">
                                                        <Binding Converter="{StaticResource NotNullConverter}"
                                                                 Path="DataContext"
                                                                 RelativeSource="{RelativeSource Self}" />
                                                        <Binding Converter="{StaticResource InvBool}" Path="IsRecharging" />
                                                    </MultiBinding>
                                                </esControls:CircularProgressBar.Visibility>
                                            </esControls:CircularProgressBar>

                                            <TextBlock FontSize="20" Foreground="White"
