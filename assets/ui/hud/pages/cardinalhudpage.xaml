                                                    </Grid>
                                                </Grid>
                                            </Grid>

                                            <Rectangle x:Name="Shockwave"
                                                       HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                <Rectangle.RenderTransform>
                                                    <TransformGroup>
                                                        <ScaleTransform ScaleX="0.0" ScaleY="0.0" />
                                                    </TransformGroup>
                                                </Rectangle.RenderTransform>
                                                <Rectangle.Style>
                                                    <Style TargetType="Rectangle">
                                                        <Style.Setters>
                                                            <Setter Property="Opacity" Value="1" />
                                                            <Setter Property="Fill">
                                                                <Setter.Value>
                                                                    <ImageBrush ImageSource="pack://application:,,,/WPFGUI;component/icons/objectives/s10_cc_shockwave.png" />
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                                                        </Style.Setters>
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding RewardIteration, Converter={StaticResource EqualToConverter}, ConverterParameter=4}" Value="True" />
                                                                    <Condition Binding="{Binding RewardProgress, Converter={StaticResource GEqualCompare}, ConverterParameter=0.9}" Value="True" />
                                                                </MultiDataTrigger.Conditions>
                                                                <MultiDataTrigger.EnterActions>
                                                                    <BeginStoryboard x:Name="Shockwave">
                                                                        <Storyboard Storyboard.Target="Self" Duration="0:0:3">

                                                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)">
                                                                                <EasingDoubleKeyFrame KeyTime="0:0:00" Value="0.1" />
                                                                                <EasingDoubleKeyFrame EasingFunction="{StaticResource CircleEaseIn}"
                                                                                                      KeyTime="0:0:1"
                                                                                                      Value="1" />
                                                                            </DoubleAnimationUsingKeyFrames>
                                                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)">
                                                                                <EasingDoubleKeyFrame KeyTime="0:0:00" Value="0.1" />
                                                                                <EasingDoubleKeyFrame EasingFunction="{StaticResource CircleEaseIn}"
                                                                                                      KeyTime="0:0:1"
                                                                                                      Value="1" />
                                                                            </DoubleAnimationUsingKeyFrames>
                                                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity" Duration="0:0:1">
                                                                                <EasingDoubleKeyFrame KeyTime="0:0:00" Value="1" />
                                                                                <EasingDoubleKeyFrame KeyTime="0:0:0.5" Value="0.7" />
                                                                                <EasingDoubleKeyFrame KeyTime="0:0:01" Value="0" />

                                                                            </DoubleAnimationUsingKeyFrames>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </MultiDataTrigger.EnterActions>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Rectangle.Style>
                                            </Rectangle>
                                        </Grid>


                                        <Grid Width="{DynamicResource TopEllipseDiameter}"
