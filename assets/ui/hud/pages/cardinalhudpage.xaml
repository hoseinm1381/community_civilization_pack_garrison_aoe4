                                                               Source="pack://application:,,,/WPFGUI;component/icons/objectives/s10_cc_silver_01.png"
                                                               Visibility="{Binding RewardIteration, Converter={StaticResource GEqualCompare}, ConverterParameter=0, FallbackValue=Collapsed}" />

                                                        <Image x:Name="SilverProgress1"
                                                               Source="pack://application:,,,/WPFGUI;component/icons/objectives/s10_cc_silver_02.png"
