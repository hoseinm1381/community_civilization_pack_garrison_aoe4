            <DataTemplate x:Key="GenericCallToAction">
                <Grid x:Name="CTAGrid"
                      VerticalAlignment="Center"
                      RenderTransformOrigin="0.5, 0.5">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform />
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <Grid.Height>
                        <MultiBinding Converter="{StaticResource MultiAddOperator}">
                            <Binding ElementName="TextDescription" Path="ActualHeight" />
                            <Binding>
                                <Binding.Source>
                                    <sys:Double>393</sys:Double>
                                </Binding.Source>
                            </Binding>
                        </MultiBinding>
                    </Grid.Height>
                    <Grid.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <EventTrigger.Actions>
                                <BeginStoryboard>
                                    <Storyboard Duration="0:0:5">
                                        <!--  Burn Shader  -->
                                        <!--  Temporarely disabling CallToAction shaders because they do not work.  -->
                                        <!--
                                        <DoubleAnimation BeginTime="0:0:0.25"
                                                         Storyboard.TargetName="DropShadowGlowTopCTA" Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1"
                                                         Duration="0:0:0.25" />
                                        <DoubleAnimation BeginTime="0:0:0.25"
                                                         Storyboard.TargetName="DropShadowGlowBottomCTA" Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1"
                                                         Duration="0:0:0.25" />
                                        <DoubleAnimation BeginTime="0:0:0.5"
                                                         Storyboard.TargetName="DropShadowGlowTopCTA" Storyboard.TargetProperty="Opacity"
                                                         From="1" To="0"
                                                         Duration="0:0:0.25" />
                                        <DoubleAnimation BeginTime="0:0:0.5"
                                                         Storyboard.TargetName="DropShadowGlowBottomCTA" Storyboard.TargetProperty="Opacity"
                                                         From="1" To="0"
                                                         Duration="0:0:0.25" />
                                        <DoubleAnimation BeginTime="0:0:0"
                                                         Storyboard.TargetName="BurnShaderTop" Storyboard.TargetProperty="Reveal"
                                                         From="0" To="1"
                                                         Duration="0:0:1" />
                                        <DoubleAnimation BeginTime="0:0:0"
                                                         Storyboard.TargetName="BurnShaderBottom" Storyboard.TargetProperty="Reveal"
                                                         From="0" To="1"
                                                         Duration="0:0:1" />
                                        -->
                                        <!--  Temporary animation while shaders do not work  -->
                                        <ObjectAnimationUsingKeyFrames BeginTime="0:0:0.25"
                                                                       Storyboard.TargetName="ScrollImageTop" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation BeginTime="0:0:0.25"
                                                         Storyboard.TargetName="ScrollImageTop" Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1"
                                                         Duration="0:0:0.4" />
                                        <ObjectAnimationUsingKeyFrames BeginTime="0:0:0.25"
                                                                       Storyboard.TargetName="ScrollImageBottom" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation BeginTime="0:0:0.25"
                                                         Storyboard.TargetName="ScrollImageBottom" Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1"
                                                         Duration="0:0:0.4" />
                                        <!--  [END] Temporary animation while shaders do not work  -->
                                        <!--  Switch Rect for image for fadeout purposes later  -->
                                        <ObjectAnimationUsingKeyFrames BeginTime="0:0:1"
                                                                       Storyboard.TargetName="ScrollImageTop" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <!--  Temporarely disabling CallToAction shaders because they do not work.  -->
                                        <!--
                                        <ObjectAnimationUsingKeyFrames BeginTime="0:0:1"
                                                                       Storyboard.TargetName="ScrollRectangleTop" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        -->
                                        <ObjectAnimationUsingKeyFrames BeginTime="0:0:1"
                                                                       Storyboard.TargetName="ScrollImageBottom" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <!--  Temporarely disabling CallToAction shaders because they do not work.  -->
                                        <!--
                                        <ObjectAnimationUsingKeyFrames BeginTime="0:0:1"
                                                                       Storyboard.TargetName="ScrollRectangleBottom" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        -->
                                        <!--  Opening of Scroll  -->
                                        <DoubleAnimation BeginTime="0:0:1"
                                                         Storyboard.TargetName="ScrollBackground" Storyboard.TargetProperty="Opacity"
                                                         From="0" To="0.85"
                                                         Duration="0:0:0.5" />
                                        <DoubleAnimation BeginTime="0:0:1"
                                                         Storyboard.TargetName="CTAScroll" Storyboard.TargetProperty="Height"
                                                         From="10" Duration="0:0:0.5">
                                            <DoubleAnimation.To>
                                                <MultiBinding Converter="{StaticResource MultiAddOperator}">
                                                    <Binding ElementName="TextDescription" Path="ActualHeight" />
                                                    <Binding>
                                                        <Binding.Source>
                                                            <sys:Double>263</sys:Double>
                                                        </Binding.Source>
                                                    </Binding>
                                                </MultiBinding>
                                            </DoubleAnimation.To>
                                        </DoubleAnimation>
                                        <ThicknessAnimation BeginTime="0:0:1"
                                                            Storyboard.TargetName="ScrollContainer" Storyboard.TargetProperty="Margin"
                                                            From="0,180,0,0" To="0,0,0,0"
                                                            Duration="0:0:0.5" />
                                        <!--  Fade in Text description  -->
                                        <DoubleAnimation BeginTime="0:0:1.5"
                                                         Storyboard.TargetName="TextDescription" Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1.0"
                                                         Duration="0:0:0.5" />
                                        <!--  Zoom out on text description  -->
                                        <DoubleAnimation BeginTime="0:0:1.5"
                                                         Storyboard.TargetName="ScaleTextDescription" Storyboard.TargetProperty="(ScaleTransform.ScaleX)"
                                                         From="1.5" To="1"
                                                         Duration="0:0:0.5" />
                                        <DoubleAnimation BeginTime="0:0:1.5"
                                                         Storyboard.TargetName="ScaleTextDescription" Storyboard.TargetProperty="(ScaleTransform.ScaleY)"
                                                         From="1.5" To="1"
                                                         Duration="0:0:0.5" />
                                        <!--  Opacity Mask Eliptical fade in for scroll image  -->
                                        <DoubleAnimationUsingKeyFrames BeginTime="0:0:1.75"
                                                                       Storyboard.TargetName="ScrollContentImage" Storyboard.TargetProperty="(UIElement.OpacityMask).(GradientBrush.GradientStops)[1].(GradientStop.Offset)">
                                            <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.75" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <!--  Zoom in on scroll image  -->
                                        <DoubleAnimation BeginTime="0:0:1.5"
                                                         Storyboard.TargetName="ScaleContentImage" Storyboard.TargetProperty="(ScaleTransform.ScaleX)"
                                                         From="1" To="1.2"
                                                         Duration="0:0:3.25" />
                                        <DoubleAnimation BeginTime="0:0:1.75"
                                                         Storyboard.TargetName="ScaleContentImage" Storyboard.TargetProperty="(ScaleTransform.ScaleY)"
                                                         From="1" To="1.2"
                                                         Duration="0:0:3.25" />
                                        <!--  Show bottom button  -->
                                        <DoubleAnimation BeginTime="0:0:2.5"
                                                         Storyboard.TargetName="ScrollButton" Storyboard.TargetProperty="Opacity"
                                                         To="1.0" Duration="0:0:0" />
                                        <!--  Adjust opacity of scroll image and shader  -->
                                        <DoubleAnimation BeginTime="0:0:2.5"
                                                         Storyboard.TargetName="ScrollContentShader" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.25" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger.Actions>
                        </EventTrigger>
                    </Grid.Triggers>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFadingOut}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard Duration="0:0:0.25">
                                                <DoubleAnimation BeginTime="0:0:0"
                                                                 Storyboard.TargetProperty="Opacity" From="1"
                                                                 To="0" Duration="0:0:0.25" />
                                                <DoubleAnimation BeginTime="0:0:0"
                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" From="1"
                                                                 To="0.9" Duration="0:0:0.25" />
                                                <DoubleAnimation BeginTime="0:0:0"
                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" From="1"
                                                                 To="0.9" Duration="0:0:0.25" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <StackPanel x:Name="ScrollContainer"
                                Margin="0,180,0,0" HorizontalAlignment="Center">
                        <!--  Top image  -->
                        <Canvas Width="300" Height="78"
                                Canvas.ZIndex="2">
                            <Image x:Name="ScrollImageTop"
                                   Grid.Row="1"
                                   Width="300"
                                   HorizontalAlignment="Center" VerticalAlignment="Top"
                                   Source="{DynamicResource ImageTopCTA}"
                                   Visibility="Collapsed" />
                            <!--  Temporarely disabling CallToAction shaders because they do not work.  -->
                            <!--
                            <Rectangle x:Name="ScrollRectangleTop"
                                       Grid.Row="1"
                                       Width="300" Height="108"
                                       HorizontalAlignment="Center" VerticalAlignment="Top">
                                <Rectangle.Fill>
                                    <utility:Shader>
                                        <utility:ShaderBrush x:Name="BurnShaderTop"
                                                             ImageSource="{DynamicResource ImageTopCTA}"
                                                             PixelShader="Burn" Reveal="0"
                                                             VertexShader="Common"
                                                             Color="{DynamicResource PrimaryColor}" />
                                    </utility:Shader>
                                </Rectangle.Fill>
                                <Rectangle.Effect>
                                    <DropShadowEffect x:Name="DropShadowGlowTopCTA"
                                                      BlurRadius="10" Opacity="1"
                                                      ShadowDepth="0"
                                                      Color="{DynamicResource PrimaryColorLight}" />
                                </Rectangle.Effect>
                            </Rectangle>
                            -->
                        </Canvas>
                        <!--  Content of the CTA Scroll  -->
                        <Grid x:Name="CTAScroll"
                              Grid.Row="0"
                              Width="247" Height="10"
                              ClipToBounds="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Rectangle x:Name="ScrollBackground"
                                       Grid.Row="0" Grid.RowSpan="2"
                                       Fill="{DynamicResource TertiaryColorDarkBrush}"
                                       Opacity="0" />

                            <Grid Grid.Row="0" ClipToBounds="True">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="TextDescription"
                                           Grid.Row="0"
                                           MinHeight="107" MaxWidth="223"
                                           Margin="12,40,12,17" HorizontalAlignment="Center"
                                           Panel.ZIndex="1"
                                           Foreground="{Binding Color, Converter={StaticResource SolidColorBrushConverter}}"
                                           IsHitTestVisible="False" Opacity="0"
                                           RenderTransformOrigin="0.5, 0.5"
                                           Style="{StaticResource HUDParentBodyTextBlock22ptStyle}"
                                           Text="{Binding Title}"
                                           TextAlignment="Center" TextWrapping="Wrap">
                                    <TextBlock.RenderTransform>
                                        <ScaleTransform x:Name="ScaleTextDescription"
                                                        ScaleX="1.5" ScaleY="1.5" />
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                                <!--  Scroll content Image  -->
                                <Canvas Grid.Row="1"
                                        Width="241" Height="210"
                                        HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Canvas.RenderTransform>
                                        <ScaleTransform x:Name="ScaleContentImage"
                                                        ScaleX="1" ScaleY="1" />
                                    </Canvas.RenderTransform>
                                    <Image x:Name="ScrollContentImage"
                                           Width="241" Height="210"
                                           VerticalAlignment="Bottom"
                                           Source="{Binding Icon}"
                                           Stretch="UniformToFill">
                                        <Image.OpacityMask>
                                            <RadialGradientBrush Center="0,0.5" GradientOrigin="0,0.5" RadiusX="2" RadiusY="2">
                                                <GradientStop Offset="0" Color="#FF000000" />
                                                <GradientStop Offset="0" Color="#00000000" />
                                            </RadialGradientBrush>
                                        </Image.OpacityMask>
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFadingOut}" Value="True">
                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard Duration="0:0:0.25">
                                                                    <DoubleAnimation BeginTime="0:0:0"
                                                                                     Storyboard.TargetProperty="Opacity" From="1"
                                                                                     To="0" Duration="0:0:0.25" />
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                    <Rectangle x:Name="ScrollContentShader"
                                               Width="{Binding ActualWidth, ElementName=ScrollContentImage}"
                                               Height="{Binding ActualHeight, ElementName=ScrollContentImage}"
                                               VerticalAlignment="Bottom"
                                               Opacity="0">
                                        <Rectangle.Fill>
                                            <esUtility:Shader>
                                                <esUtility:ShaderBrush Bumpiness="0.4" Emboss="2"
                                                                       ImageSource="{Binding Icon}"
                                                                       LightColor="#FFFFFFFF" LightDirection="0, 0, 1"
                                                                       Metallic="1" NormalMapSource="../../Resources/Images/NoiseNormalMap.png"
                                                                       Offsets="2, 4, 0, 1" PixelShader="Plate"
                                                                       Shininess="50" VertexShader="Common"
                                                                       Color="{DynamicResource PrimaryColor}" />
                                            </esUtility:Shader>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                </Canvas>
                            </Grid>
                            <!--  CTA 'View Event' Button  -->
                            <Grid Grid.Row="1" Margin="12,0,12,24">
                                <Button x:Name="ScrollButton"
                                        Margin="0" HorizontalAlignment="Stretch"
                                        Command="{Binding Focus}"
                                        IsHitTestVisible="True" IsTabStop="False"
                                        Opacity="0">
                                    <Button.Style>
                                        <Style BasedOn="{StaticResource PrimaryAnimatedContentButton}" TargetType="Button">
                                            <Setter Property="Border.CornerRadius" Value="0" />
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Style="{StaticResource HUDAnimatedButtonTextBlockStyle}" Text="{esUtility:LocString $11169834}" />
                                </Button>
                            </Grid>
                        </Grid>
                        <!--  Bottom Image  -->
                        <Canvas Width="300" Height="38"
                                VerticalAlignment="Bottom">
                            <Image x:Name="ScrollImageBottom"
                                   Grid.Row="1"
                                   Width="300"
                                   Margin="0,-12,0,0" HorizontalAlignment="Center"
                                   Source="{DynamicResource ImageBottomCTA}"
                                   Visibility="Collapsed" />
                            <!--  Temporarely disabling CallToAction shaders because they do not work.  -->
                            <!--
                            <Rectangle x:Name="ScrollRectangleBottom"
