                        <controls:BasicDecoratorsControl.HealthOverlayBrush>
                            <DynamicResource ResourceKey="TransparentToWhiteOverlayBrush" />
                        </controls:BasicDecoratorsControl.HealthOverlayBrush>
                    </controls:BasicDecoratorsControl>

                    <!--
                        Performance note: we want to avoid selecting and instantiating a DataTemplate when a kicker is created
                        so we set RecyclingItemsControl.RecyclingLimit and RecyclingItemsControl.PrewarmCount.
                        * Bind to OptimizedKickers which contains kickers that don't specify DataTemplate property. *
                        * If a kicker has a valid DataTemplate property, it goes to the UnoptimizedKickers below. *
                    -->
                    <esControls:PositionCanvasItemsControl IsHitTestVisible="False" IsTabStop="False"
                                                           ItemsSource="{Binding OptimizedKickers}"
                                                           PositionPropertyName="ProjectedPosition"
                                                           Version="{Binding OptimizedKickers.Version}">
                        <!--
                            In order for PrewarmCount to work we need to know in advance which template to use so rather than add templates
                            to ItemsControl.Resources chosen by the KickerModel's type we set .ItemTemplate (or an ItemContainerStyle that
                            explicitly sets the ItemContainer's ContentTemplate) - thus KickerMessageModel, KickerXPModel etc all look the same.
                            Formerly there were simple white text kickers for KickerUpgradeModel, KickerXPModel etc.
                        -->
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource HUDBackgroundColorBrush}" Style="{StaticResource KickerTemplateStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{Binding Icon}" Style="{StaticResource KickerIconStyle}" />
                                        <TextBlock x:Name="KickerDefaultText"
                                                   Style="{StaticResource nHUDBaseHeavyTextBlockStyle}"
                                                   Text="{Binding Text}" />
                                        <Image Source="{Binding Symbol}" Style="{StaticResource KickerIconStyle}" />
                                        <TextBlock x:Name="KickerAdditionalText"
                                                   Style="{StaticResource nHUDBaseHeavyTextBlockStyle}"
                                                   Text="{Binding AdditionalText}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <esControls:RecyclingItemsControl.PrewarmCount>10</esControls:RecyclingItemsControl.PrewarmCount>
                        <esControls:RecyclingItemsControl.RecyclingLimit>100</esControls:RecyclingItemsControl.RecyclingLimit>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <esControls:AlignedCanvas ChildVerticalAlignment="Bottom" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </esControls:PositionCanvasItemsControl>

                    <!--  Unoptimized kickers. Bind to UnoptimizedKickers which contains kickers that specify DataTemplate property for template selecting  -->
                    <esControls:PositionCanvasItemsControl IsHitTestVisible="False" IsTabStop="False"
                                                           ItemsSource="{Binding UnoptimizedKickers}"
                                                           PositionPropertyName="ProjectedPosition"
                                                           Version="{Binding UnoptimizedKickers.Version}">
                        <!--  Perf hack: Do not template selecting but trigger on DataTemplate so that the kickers can be pre-warmed  -->
                        <esControls:RecyclingItemsControl.PrewarmCount>10</esControls:RecyclingItemsControl.PrewarmCount>
                        <esControls:RecyclingItemsControl.RecyclingLimit>100</esControls:RecyclingItemsControl.RecyclingLimit>
                        <ItemsControl.ItemTemplate>
                            <!--  Heal Receiver indicator  -->
                            <DataTemplate DataType="{x:Type model:KickerModel}">
                                <StackPanel Orientation="Vertical">
                                    <Image Width="28" Source="pack://application:,,,/WPFGUI;component/icons/buffs/buff_receiver_heal.png">
                                        <Image.Style>
                                            <Style BasedOn="{StaticResource KickerTemplateStyle}" TargetType="Image">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataTemplate}" Value="BuffReceiverHealTemplate">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>

                                            </Style>
                                        </Image.Style>
                                    </Image>
                                    <Image Width="52" Source="pack://application:,,,/WPFGUI;component/icons/buffs/buff_generator_heal.png">
                                        <Image.Style>
                                            <Style BasedOn="{StaticResource KickerTemplateStyle}" TargetType="Image">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataTemplate}" Value="HealingIndicatorTemplate">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                        <Image.Triggers>
                                            <EventTrigger RoutedEvent="Image.Loaded">
                                                <EventTrigger.Actions>
                                                    <!--
                                                        Do not StopStoryboard on this. Let Visiblity control animation cycle.
                                                        Otherwise, StopSoryboard when collpased may crash the game.
                                                    -->
                                                    <BeginStoryboard Storyboard="{StaticResource BuffPulseAnimation}" />
                                                </EventTrigger.Actions>
                                            </EventTrigger>
                                        </Image.Triggers>
                                    </Image>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <esControls:AlignedCanvas ChildVerticalAlignment="Bottom" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </esControls:PositionCanvasItemsControl>

                    <!--  There is another ItemsControl for TargetingModel.ToolTips under this one, but with its ChildVerticalAlignment set to Bottom  -->
                    <ItemsControl IsHitTestVisible="False" IsTabStop="False"
                                  ItemsSource="{Binding ElementName=TheHUDPage, Path=TargetingModel.ToolTips}">
                        <ItemsControl.Resources>
                            <!--  Empty DataTemplate to catch the other TargetingModelTopModels not covered by this ItemsControl  -->
                            <DataTemplate DataType="{x:Type targetingModel:TargetingToolTipModel}" />
                            <SolidColorBrush x:Key="UnsatisfiedBrush" Color="Red" />
                            <DataTemplate DataType="{x:Type targetingModel:BuildCostTargetingToolTipModel}">
                                <ContentControl IsTabStop="False" Opacity="0.95"
                                                RenderTransformOrigin="0.5,0.5"
                                                Style="{StaticResource HUDTooltipBorderStyle}"
                                                Visibility="{Binding TimeToBuild, Converter={StaticResource NumberToVis}, FallbackValue=Collapsed}">
                                    <ContentControl.RenderTransform>
                                        <TranslateTransform X="56" />
                                    </ContentControl.RenderTransform>
                                    <StackPanel Orientation="Vertical">
                                        <ItemsControl Margin="{StaticResource ExtraSmallMarginBottom}"
                                                      IsTabStop="False"
                                                      ItemsSource="{Binding ResourceCost}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Vertical" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type model:ResourceModel}">
                                                    <StackPanel Orientation="Horizontal" Visibility="{Binding Amount, Converter={StaticResource NumberToVis}, FallbackValue=Collapsed}">
                                                        <Image Width="{StaticResource HUDResourceIconSize}"
                                                               VerticalAlignment="Center"
                                                               Source="{Binding Icon}" />
                                                        <TextBlock Margin="{StaticResource ExtraSmallMarginLeft}"
                                                                   VerticalAlignment="Center"
                                                                   Style="{StaticResource nHUDBaseHeavyTextBlockStyle}"
                                                                   Text="{Binding Amount, Converter={StaticResource LocalizedStringConverter}, ConverterParameter=$11144600}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <StackPanel Orientation="Horizontal" Visibility="{Binding Amount, Converter={StaticResource NumberToVis}, FallbackValue=Collapsed}">
                                            <Image Width="{StaticResource HUDResourceIconSize}"
                                                   VerticalAlignment="Center"
                                                   Source="../../icons/common/time_to_build.png" />
                                            <TextBlock Margin="2,0,4,0" VerticalAlignment="Center"
                                                       Style="{StaticResource nHUDBaseHeavyTextBlockStyle}"
                                                       Text="{Binding TimeToBuild, Converter={StaticResource TimeFormat}}" />
                                        </StackPanel>
                                    </StackPanel>
                                </ContentControl>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type targetingModel:WallCapToolTipModel}">
                                <Image Width="40" Height="18"
                                       Source="pack://application:,,,/WPFGUI;component/icons/wall_link.png" />
                            </DataTemplate>
                            <!--  Influence decorator during placing a building  -->
                            <DataTemplate DataType="{x:Type targetingModel:DistrictTargetingToolTipModel}">
                                <Image Source="pack://application:,,,/WPFGUI;component/icons/influence_decorator.png" Visibility="{Binding Influenced, Converter={StaticResource BoolToVis}}">
                                    <Image.RenderTransform>
                                        <TranslateTransform Y="-200" />
                                    </Image.RenderTransform>
                                </Image>
                            </DataTemplate>
                        </ItemsControl.Resources>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="esControls:AlignedCanvas.Position" Value="{Binding ProjectedPosition}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <esControls:AlignedCanvas ChildVerticalAlignment="Top" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ItemsPresenter />
                            </ControlTemplate>
                        </ItemsControl.Template>
                    </ItemsControl>

                    <!--  There is another ItemsControl for TargetingModel.ToolTips above this one, but with its ChildVerticalAlignment set to Top  -->
                    <ItemsControl IsHitTestVisible="False" IsTabStop="False"
                                  ItemsSource="{Binding ElementName=TheHUDPage, Path=TargetingModel.ToolTips}">
                        <ItemsControl.Resources>
                            <!--  Empty DataTemplate to catch the other TargetingModelTopModels not covered by this ItemsControl  -->
                            <DataTemplate DataType="{x:Type targetingModel:TargetingToolTipModel}" />

                            <DataTemplate DataType="{x:Type targetingModel:HuntingCabinTargetingToolTipModel}">
                                <Grid Background="{StaticResource HUDTargetingToolTipResourceGradient}">
                                    <StackPanel Margin="20,2,20,2" Orientation="Horizontal">
                                        <Image Width="{StaticResource HUDResourceIconSize}" Source="/WPFGUI;component/icons/resources/resource_gold_icon.png" />
                                        <TextBlock Margin="{StaticResource ExtraSmallMarginLeft}"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource nHUDBaseTextBlockStyle}"
                                                   Text="{Binding Gold, Converter={StaticResource LocalizedStringConverter}, ConverterParameter=$11232240}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.Resources>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="esControls:AlignedCanvas.Position" Value="{Binding ProjectedPosition}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <esControls:AlignedCanvas ChildVerticalAlignment="Bottom" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ItemsPresenter />
                            </ControlTemplate>
                        </ItemsControl.Template>
                    </ItemsControl>

                    <!--  Position tags  -->
                    <ItemsControl IsHitTestVisible="False" IsTabStop="False"
                                  ItemsSource="{Binding PositionTags}">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="esControls:AlignedCanvas.Position" Value="{Binding ProjectedPosition}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <esControls:AlignedCanvas ChildVerticalAlignment="Top" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ItemsPresenter />
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!--  Only need a invisible piece of ui so that the tag adorner can attach to  -->
                                <Grid>
                                <FrameworkElement esControls:TagAdorner.AlignmentMode="Relative"
                                                  esControls:TagAdorner.ArrowDataTemplate="{StaticResource TagArrowDataTemplate}"
                                                  esControls:TagAdorner.ClampMode="Custom"
                                                  esControls:TagAdorner.Data="{Binding TagData}"
                                                  esControls:TagAdorner.DataTemplate="{StaticResource TagDataTemplate}"
                                                  esControls:TagAdorner.HorizontalAnchor="Center" esControls:TagAdorner.HorizontalPlacement="Center"
                                                  esControls:TagAdorner.TargetDataTemplate="{StaticResource EmptyTagDataTemplate}"
                                                  esControls:TagAdorner.VerticalAnchor="Bottom" esControls:TagAdorner.VerticalPlacement="Top">
                                    <FrameworkElement.Style>
                                        <Style TargetType="FrameworkElement">
                                            <Setter Property="esControls:TagAdorner.IsTagged" Value="True" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TagData.Data[VietnamQuietSupervision]}" Value="True">
                                                    <Setter Property="esControls:TagAdorner.IsTagged" Value="False" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </FrameworkElement.Style>
                                </FrameworkElement>
                                <!-- Private work marker bypasses tutorial arrow, animation and clamping. -->
                                <ContentControl Content="{Binding TagData}" Margin="0,-52,0,0" IsHitTestVisible="False"
                                                ContentTemplate="{StaticResource VietnamBuffaloSupervisionTemplate}">
                                    <ContentControl.Style>
                                        <Style TargetType="ContentControl">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TagData.Data[VietnamQuietSupervision]}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContentControl.Style>
                                </ContentControl>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!--  Hint Points with On Screen design only. The "onscreen" region is larger than the actual screen.  -->
                    <eHUDControls:CompassControl IsHitTestVisible="False" IsTabStop="False"
                                                 ItemsSource="{Binding HintPoints}"
                                                 PositionPropertyName="ProjectedPosition"
                                                 Version="{Binding HintPoints.Version}"
                                                 Visibility="{Binding HintPointsVisibility}">
                        <eHUDControls:CompassControl.Resources>
                            <Style x:Key="HintPointBody" TargetType="FrameworkElement">
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Path=IsOnScreen, RelativeSource={RelativeSource FindAncestor, AncestorType=eHUDControls:CompassItem}, Mode=OneWay}" Value="false">
                                        <!--  Do not use Collapsed. Otherwise, it could change the size of compass item and casue trouble calculating on-screen information near the screen edges  -->
                                        <Setter Property="Visibility" Value="Hidden" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </eHUDControls:CompassControl.Resources>

                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <eHUDControls:CompassCanvas Padding="-160,-100,-160,0"
                                                            ChildHorizontalAlignment="Center" ChildVerticalAlignment="Bottom" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplateSelector>
                            <esModels:DataTemplateSourceSelector Optional="True">
                                <esModels:DataTemplateSourceSelector.DefaultDataTemplate>
                                    <DataTemplate DataType="{x:Type model:HintPointModel}">
                                        <StackPanel Opacity="0.9" Orientation="Vertical"
                                                    Style="{StaticResource HintPointBody}">
                                            <Border Margin="0,0,0,8" Background="{StaticResource DualFadeGradientBackground}">
                                                <TextBlock MaxWidth="280"
                                                           Margin="20,8" HorizontalAlignment="Center"
                                                           Style="{StaticResource nHUDBaseTextBlockStyle}"
                                                           Text="{Binding Text}"
                                                           TextAlignment="Center" TextWrapping="Wrap" />
                                            </Border>
                                            <Image Width="35" Height="35"
                                                   Source="../../icons/hint_point_arrow.png" />
                                        </StackPanel>
                                    </DataTemplate>
                                </esModels:DataTemplateSourceSelector.DefaultDataTemplate>

                                <esModels:DataTemplateSourceSelector.Resources>
                                    <!--
                                        I'm emptying all of these data templates, because they're done in the next <CompassControl>.
                                        If we delete all these templates, then they will end up using the default data template.
                                    -->

                                    <DataTemplate x:Key="ObjectiveTemplate" DataType="{x:Type model:HintPointModel}" />

                                    <!--  KEEP THESE DATA TEMPLATES IN SYNC WITH THOSE OF THE OBJECTIVE LIST AND OBJECTIVE TITLE  -->

                                    <!--  CAMPAIGN AND CHALLENGE OBJECTIVE TEMPLATES  -->

                                    <DataTemplate x:Key="PrimaryObjectiveTemplate" DataType="{x:Type model:HintPointModel}" />

                                    <DataTemplate x:Key="PrimaryOrObjectiveTemplate" DataType="{x:Type model:HintPointModel}" />

                                    <DataTemplate x:Key="InfoObjectiveTemplate" DataType="{x:Type model:HintPointModel}" />

                                    <DataTemplate x:Key="CaptureObjectiveTemplate" DataType="{x:Type model:HintPointModel}" />

                                    <DataTemplate x:Key="BattleObjectiveTemplate" DataType="{x:Type model:HintPointModel}" />

                                    <DataTemplate x:Key="ConquerorObjectiveTemplate" DataType="{x:Type model:HintPointModel}" />

                                    <DataTemplate x:Key="BuildObjectiveTemplate" DataType="{x:Type model:HintPointModel}" />

                                    <DataTemplate x:Key="LeaderInjuredObjectiveTemplate" DataType="{x:Type model:HintPointModel}" />

                                    <DataTemplate x:Key="SecondaryObjectiveTemplate" DataType="{x:Type model:HintPointModel}" />

                                    <DataTemplate x:Key="SecondaryOrObjectiveTemplate" DataType="{x:Type model:HintPointModel}" />

                                    <DataTemplate x:Key="TipObjectiveTemplate" DataType="{x:Type model:HintPointModel}" />

                                    <DataTemplate x:Key="OptionalObjectiveTemplate" DataType="{x:Type model:HintPointModel}" />

                                    <DataTemplate x:Key="BonusObjectiveTemplate" DataType="{x:Type model:HintPointModel}" />

                                    <!--
                                        Skipping:
                                        - Challenge Gold
                                        - Challenge Silver
                                        - Challenge Bronze
                                        - Challenge No Medal
                                    -->

                                    <DataTemplate x:Key="StrengthTugOfWarObjectiveTemplate" DataType="{x:Type model:HintPointModel}" />

                                    <!--  Build cost widget for Rebuilding Moscow Palisades  -->
                                    <DataTemplate x:Key="BuildCostWidgetTemplate" DataType="{x:Type model:HintPointModel}" />

                                    <!--  Build cost widget for Rebuilding Moscow buildings  -->
                                    <DataTemplate x:Key="BuildCostWidgetNoIconTemplate" DataType="{x:Type model:HintPointModel}" />

                                    <!--  MULTIPLAYER  OBJECTIVE TEMPLATES  -->

                                    <DataTemplate x:Key="ConquestObjectiveTemplate" DataType="{x:Type model:HintPointModel}" />

                                    <DataTemplate x:Key="WonderObjectiveTemplate" DataType="{x:Type model:HintPointModel}" />

                                    <DataTemplate x:Key="WonderOrObjectiveTemplate" DataType="{x:Type model:HintPointModel}" />

                                    <!--  This is the Sacred Site Hint Point (aka Holy Site), if looking the decorator (thing floating above the sacred site), search for EntityStrategicPointDecoratorModel  -->
                                    <DataTemplate x:Key="HolySiteObjectiveTemplate" DataType="{x:Type model:HintPointModel}" />

                                    <!--
                                        Skipping these, use HolySiteObjectiveTemplate instead or create the templates if needed.
                                        - HolySiteObjectiveTemplate
                                        - HolySiteSecondaryObjectiveTemplate
                                    -->

                                    <!--  END OF OBJECTIVE TEMPLATES  -->

                                    <!--  Training Hint Point tempalte with TagAdorner attached  -->
                                    <DataTemplate x:Key="TrainingHintPointTemplate" />

                                    <DataTemplate x:Key="BouncingArrowObjectiveTemplate" DataType="{x:Type model:HintPointModel}" />

                                </esModels:DataTemplateSourceSelector.Resources>
                            </esModels:DataTemplateSourceSelector>
                        </ItemsControl.ItemTemplateSelector>
                    </eHUDControls:CompassControl>

                    <!--  Hint Points with On Screen & Off Screen designs (the off screen design sticks to the edge of the screen pointing toward it's position/entity)  -->
                    <eHUDControls:CompassControl IsHitTestVisible="False" IsTabStop="False"
                                                 ItemsSource="{Binding HintPoints}"
                                                 PositionPropertyName="ProjectedPosition"
                                                 Version="{Binding HintPoints.Version}"
                                                 Visibility="{Binding HintPointsVisibility}">
                        <eHUDControls:CompassControl.Resources>
                            <Style x:Key="LocationIndicator" TargetType="FrameworkElement">
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="{Binding Angle, RelativeSource={RelativeSource FindAncestor, AncestorType=eHUDControls:CompassItem}, Mode=OneWay}" />
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                                <Setter Property="Visibility" Value="{Binding ArrowVisibility, FallbackValue=Collapsed}" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Path=IsOnScreen, RelativeSource={RelativeSource FindAncestor, AncestorType=eHUDControls:CompassItem}, Mode=OneWay}" Value="true" />
                                            <Condition Binding="{Binding ArrowVisibility, FallbackValue=Collapsed}" Value="{x:Static Visibility.Visible}" />
                                        </MultiDataTrigger.Conditions>
                                        <!--  Do not use Collapsed. Otherwise, it could change the size of compass item and casue trouble calculating on-screen information near the screen edges  -->
                                        <Setter Property="Visibility" Value="Hidden" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>

                            <Style x:Key="LocationIndicatorNoRotation" TargetType="FrameworkElement">
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Visibility" Value="{Binding ArrowVisibility, FallbackValue=Collapsed}" />
                            </Style>

                            <Style x:Key="HintPointBody" TargetType="FrameworkElement">
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Path=IsOnScreen, RelativeSource={RelativeSource FindAncestor, AncestorType=eHUDControls:CompassItem}, Mode=OneWay}" Value="false">
                                        <!--  Do not use Collapsed. Otherwise, it could change the size of compass item and casue trouble calculating on-screen information near the screen edges  -->
                                        <Setter Property="Visibility" Value="Hidden" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>

                            <Style x:Key="HintPointBodyBouncingArrow" TargetType="FrameworkElement">
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Path=IsOnScreen, RelativeSource={RelativeSource FindAncestor, AncestorType=eHUDControls:CompassItem}, Mode=OneWay}" Value="false">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>

                            <Style x:Key="HintPointBodyOffScreen" TargetType="FrameworkElement">
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <!--  Do not use Collapsed. Otherwise, it could change the size of compass item and casue trouble calculating on-screen information near the screen edges  -->
                                <Setter Property="Visibility" Value="Hidden" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Path=IsOnScreen, RelativeSource={RelativeSource FindAncestor, AncestorType=eHUDControls:CompassItem}, Mode=OneWay}" Value="false">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>

                            <!--  Default values  -->
                            <DataTemplate x:Key="ObjectiveStatusIconTemplate" />

                            <Style x:Key="ObjectiveHintPointStyle" TargetType="ContentControl">
                                <!--  This Background property must be of type `SolidColorBrush` and is used for the color the porgress bar glow  -->
                                <Setter Property="Background" Value="White" />
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate DataType="{x:Type model:HintPointModel}">
                                            <Grid>
                                                <!--  on screen  -->
                                                <Grid HorizontalAlignment="Center" Style="{StaticResource HintPointBody}">
                                                    <Grid MinWidth="240" Margin="{DynamicResource OnScreenOffset}">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>

                                                        <Rectangle Grid.Row="1"
                                                                   Margin="0,0,0,-1"
                                                                   RenderTransformOrigin="0.5,0.5">
                                                            <Rectangle.Fill>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                    <GradientStop Offset="0" Color="{DynamicResource TertiaryColorDarkTransparent}" />
                                                                    <GradientStop Offset="0.125" Color="{DynamicResource TertiaryColorDark}" />
                                                                    <GradientStop Offset="0.875" Color="{DynamicResource TertiaryColorDark}" />
                                                                    <GradientStop Offset="1" Color="{DynamicResource TertiaryColorDarkTransparent}" />
                                                                </LinearGradientBrush>
                                                            </Rectangle.Fill>
                                                            <Rectangle.RenderTransform>
                                                                <ScaleTransform ScaleX="{Binding ObjectiveTextAlpha}" />
                                                            </Rectangle.RenderTransform>
                                                        </Rectangle>

                                                        <Separator Grid.Row="0"
                                                                   Margin="35,0,35,0" HorizontalAlignment="Stretch"
                                                                   VerticalAlignment="Bottom"
                                                                   Style="{StaticResource PrimarySeperatorStyle}" />

                                                        <Viewbox Grid.Row="0"
                                                                 Width="126"
                                                                 Margin="0,0,0,-15" HorizontalAlignment="Center"
                                                                 VerticalAlignment="Bottom">
                                                            <Grid>
                                                                <Ellipse Width="46" Height="46"
                                                                         Fill="{DynamicResource TertiaryColorDarkBrush}" />

                                                                <Image Width="32" Height="32"
                                                                       Margin="0,0,1,2"
                                                                       Source="{DynamicResource ObjectiveIcon}" />

                                                                <Image Width="126" Source="/WPFGUI;component/icons/HUD/objectives/objective_top_image.png" />
                                                            </Grid>
                                                        </Viewbox>

                                                        <Grid Grid.Row="1" Margin="60,12,60,12">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>

                                                            <TextBlock Grid.Row="0"
                                                                       Margin="0,1,0,0"
                                                                       Style="{StaticResource nHUDSubheaderTextBlockStyle}"
                                                                       TextAlignment="Center" TextWrapping="Wrap">
                                                                <TextBlock.Inlines>
                                                                    <InlineUIContainer>
                                                                        <ContentControl Content="{Binding}"
                                                                                        ContentTemplate="{DynamicResource ObjectiveStatusIconTemplate}"
                                                                                        IsTabStop="False" />
                                                                    </InlineUIContainer>

                                                                    <Run Text="{Binding Text, Mode=OneWay}" />
                                                                </TextBlock.Inlines>
                                                            </TextBlock>

                                                            <Viewbox Grid.Row="1"
                                                                     Width="134"
                                                                     Margin="0,5,0,0"
                                                                     Visibility="{Binding Objective.ProgressVisibility}">
                                                                <Grid>
                                                                    <Image Name="TheProgressBarGlow"
                                                                           Width="{Binding ElementName=TheProgressBar, Path=ActualWidth, Converter={StaticResource AddOperator}, ConverterParameter=12}"
                                                                           Height="{Binding ElementName=TheProgressBar, Path=ActualHeight, Converter={StaticResource AddOperator}, ConverterParameter=12}"
                                                                           Margin="-6" VerticalAlignment="Bottom"
                                                                           Opacity="0" Source="/WPFGUI;component/icons/HUD/objectives/objective_hint_point_progressbar_glow.png"
                                                                           Stretch="Fill">
                                                                        <Image.Effect>
                                                                            <esEffects:TintEffect Tint="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ContentControl}, Path=Background.Color}" />
                                                                        </Image.Effect>
                                                                    </Image>

                                                                    <ProgressBar Name="TheProgressBar"
                                                                                 Width="134" MinHeight="4"
                                                                                 VerticalAlignment="Bottom"
                                                                                 BorderThickness="0" IsTabStop="False"
                                                                                 Style="{StaticResource PrimaryProgressBar}"
                                                                                 Value="{Binding Objective.Progress, Mode=OneWay}" />
                                                                </Grid>
                                                            </Viewbox>
                                                        </Grid>

                                                        <Separator Grid.Row="2"
                                                                   Margin="35,0,35,0" HorizontalAlignment="Stretch"
                                                                   VerticalAlignment="Top"
                                                                   Style="{StaticResource PrimarySeperatorStyle}" />

                                                        <Image Grid.Row="2"
                                                               Width="125"
                                                               Margin="0,-8,0,0" HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Source="/WPFGUI;component/icons/HUD/objectives/objective_bottom_image.png" />

                                                        <Image Grid.Row="3"
                                                               Width="70" Height="70"
                                                               Source="/WPFGUI;component/icons/objective_arrow.png"
                                                               Visibility="{DynamicResource OnScreenArrowVisibility}" />
                                                    </Grid>
                                                </Grid>

                                                <!--  off screen  -->
                                                <Grid Width="70" Height="70"
                                                      RenderTransformOrigin="0.5,0.5"
                                                      Style="{StaticResource HintPointBodyOffScreen}">
                                                    <Grid.RenderTransform>
                                                        <RotateTransform Angle="{Binding Angle, RelativeSource={RelativeSource FindAncestor, AncestorType=eHUDControls:CompassItem}, Mode=OneWay}" />
                                                    </Grid.RenderTransform>

                                                    <Image Width="70" Height="70"
                                                           Source="/WPFGUI;component/icons/objective_arrow.png"
                                                           Style="{StaticResource LocationIndicatorNoRotation}" />

                                                    <Decorator Visibility="{DynamicResource OffScreenIconVisibility}">
                                                        <Image Width="50" Height="50"
                                                               Source="{DynamicResource ObjectiveIcon}">
                                                            <Image.Style>
                                                                <Style BasedOn="{StaticResource LocationIndicatorNoRotation}" TargetType="Image">
                                                                    <Setter Property="RenderTransform">
                                                                        <Setter.Value>
                                                                            <TransformGroup>
                                                                                <RotateTransform Angle="{Binding Angle, RelativeSource={RelativeSource FindAncestor, AncestorType=eHUDControls:CompassItem}, Mode=OneWay, Converter={StaticResource MultiplyOperator}, ConverterParameter=-1}" />
                                                                                <TranslateTransform Y="-50" />
                                                                            </TransformGroup>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                    <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                                                                    <!--
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding Objective.Type}" Value="{x:Static model:ObjectiveType.Information}" />
                                                                                <Condition Binding="{Binding Path=IsOnScreen, RelativeSource={RelativeSource FindAncestor, AncestorType=engineHUDControls:CompassItem}, Mode=OneWay}" Value="false" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                    -->
                                                                </Style>
                                                            </Image.Style>
                                                        </Image>
                                                    </Decorator>
                                                </Grid>
                                            </Grid>

                                            <DataTemplate.Triggers>
                                                <DataTrigger Value="False">
                                                    <DataTrigger.Binding>
                                                        <MultiBinding Converter="{StaticResource MultiLogicalAnd}">
                                                            <Binding Path="Objective.IsFlashing" />
                                                            <Binding Mode="OneWay" Path="IsOnScreen"
                                                                     RelativeSource="{RelativeSource FindAncestor,
                                                                                                     AncestorType=eHUDControls:CompassItem}" />
                                                        </MultiBinding>
                                                    </DataTrigger.Binding>
                                                    <DataTrigger.EnterActions>
                                                        <StopStoryboard BeginStoryboardName="Pulse" />
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <BeginStoryboard Name="Pulse">
                                                            <Storyboard AutoReverse="True" RepeatBehavior="Forever">
                                                                <DoubleAnimation Storyboard.TargetName="TheProgressBarGlow" Storyboard.TargetProperty="(Image.Opacity)"
                                                                                 From="0" To="1"
                                                                                 Duration="0:0:0.8" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="IsTabStop" Value="False" />
                            </Style>

                            <Style x:Key="BuildCostWidgetControlStyle" TargetType="{x:Type Control}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type Control}">
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsPotentialSelected}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard BeginTime="0:0:0.04" Storyboard.TargetName="Container">
                                                                <DoubleAnimation EasingFunction="{StaticResource QuadEaseOut}"
                                                                                 Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" From="0.8"
                                                                                 To="1" Duration="0:0:0.1" />
                                                                <DoubleAnimation EasingFunction="{StaticResource QuadEaseOut}"
                                                                                 Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" From="0.8"
                                                                                 To="1" Duration="0:0:0.1" />
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1"
                                                                                 Duration="0:0:0.1" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard Storyboard.TargetName="Container">
                                                                <DoubleAnimation EasingFunction="{StaticResource QuadEaseIn}"
                                                                                 Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="0.8"
                                                                                 Duration="0:0:0.05" />
                                                                <DoubleAnimation EasingFunction="{StaticResource QuadEaseIn}"
                                                                                 Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="0.8"
                                                                                 Duration="0:0:0.05" />
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0"
                                                                                 Duration="0:0:0.05" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                            <Grid x:Name="Container"
                                                  Opacity="0" RenderTransformOrigin="0.5,0">
                                                <Grid.RenderTransform>
                                                    <ScaleTransform ScaleX="0.8" ScaleY="0.8" />
                                                </Grid.RenderTransform>
                                                <Grid HorizontalAlignment="Center" VerticalAlignment="Top">
                                                    <Rectangle Margin="2,2,-2,-2"
                                                               Fill="#8f000000" RadiusX="2"
                                                               RadiusY="2" />
                                                    <Rectangle Margin="3,3,-3,-3"
                                                               Fill="#2f000000" RadiusX="2"
                                                               RadiusY="2" />
                                                    <Rectangle RadiusX="2" RadiusY="2">
                                                        <Rectangle.Fill>
                                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                                <GradientStop Offset="0" Color="{DynamicResource TertiaryColorLight}" />
                                                                <GradientStop Offset="1" Color="{DynamicResource TertiaryColorDark}" />
                                                            </LinearGradientBrush>
                                                        </Rectangle.Fill>
                                                    </Rectangle>
                                                    <StackPanel Orientation="Vertical">
                                                        <Image Height="32"
                                                               Margin="{StaticResource ExtraSmallMarginTop}"
                                                               HorizontalAlignment="Center"
                                                               Source="/WPFGUI;component/icons/objectives/objectives_build_small.png" />
                                                        <ItemsControl Margin="{StaticResource ExtraSmallMarginBottom}"
                                                                      HorizontalAlignment="Center"
                                                                      IsTabStop="False"
                                                                      ItemsSource="{Binding Resources}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Margin="{StaticResource ExtraSmallMarginLeftRight}" Orientation="Vertical" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <Image Height="20"
                                                                               Margin="{StaticResource ExtraSmallMarginAll}"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                            <Image.Style>
                                                                                <Style TargetType="{x:Type Image}">
                                                                                    <Setter Property="Source" Value="{Binding Icon}" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsInsufficient}" Value="True">
                                                                                            <Setter Property="Source" Value="{Binding InsufficientIcon}" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Image.Style>
                                                                        </Image>
                                                                        <TextBlock Margin="{StaticResource ExtraSmallMarginAll}"
                                                                                   VerticalAlignment="Center"
                                                                                   Text="{Binding Amount, Converter={StaticResource CastToIntOperator}}">
                                                                            <TextBlock.Style>
                                                                                <Style BasedOn="{StaticResource nHUDBaseHeavyTextBlockStyle}" TargetType="{x:Type TextBlock}">
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsInsufficient}" Value="True">
                                                                                            <Setter Property="Foreground" Value="{DynamicResource ErrorColorLightBrush}" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </eHUDControls:CompassControl.Resources>

                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <eHUDControls:CompassCanvas Padding="80,0,150,450"
                                                            ChildHorizontalAlignment="Center" ChildVerticalAlignment="Bottom" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplateSelector>
                            <esModels:DataTemplateSourceSelector Optional="True">
                                <esModels:DataTemplateSourceSelector.DefaultDataTemplate>
                                    <!-- I'm "disabling" this data template, because it's done in the previous <CompassControl> -->
                                    <DataTemplate DataType="{x:Type model:HintPointModel}" />
                                </esModels:DataTemplateSourceSelector.DefaultDataTemplate>

                                <esModels:DataTemplateSourceSelector.Resources>
                                    <DataTemplate x:Key="ObjectiveTemplate" DataType="{x:Type model:HintPointModel}">
                                        <ContentControl Content="{Binding}"
                                                        IsTabStop="False"
                                                        Style="{StaticResource ObjectiveHintPointStyle}">
                                            <ContentControl.Resources>
                                                <ImageSource x:Key="ObjectiveIcon">/WPFGUI;component/icons/objectives/objectives_generic_small.png</ImageSource>
                                                <Thickness x:Key="OnScreenOffset">0</Thickness>
                                                <Visibility x:Key="OnScreenArrowVisibility">Visible</Visibility>
                                                <Visibility x:Key="OffScreenIconVisibility">Visible</Visibility>
                                            </ContentControl.Resources>
                                        </ContentControl>
                                    </DataTemplate>

                                    <!--  KEEP THESE DATA TEMPLATES IN SYNC WITH THOSE OF THE OBJECTIVE LIST AND OBJECTIVE TITLE  -->

                                    <!--  CAMPAIGN AND CHALLENGE OBJECTIVE TEMPLATES  -->

                                    <DataTemplate x:Key="PrimaryObjectiveTemplate" DataType="{x:Type model:HintPointModel}">
                                        <ContentControl Content="{Binding}"
                                                        IsTabStop="False"
                                                        Style="{StaticResource ObjectiveHintPointStyle}">
                                            <ContentControl.Resources>
                                                <ImageSource x:Key="ObjectiveIcon">/WPFGUI;component/icons/objectives/objectives_generic_small.png</ImageSource>
                                                <Thickness x:Key="OnScreenOffset">0</Thickness>
                                                <Visibility x:Key="OnScreenArrowVisibility">Visible</Visibility>
                                                <Visibility x:Key="OffScreenIconVisibility">Visible</Visibility>
                                            </ContentControl.Resources>
                                        </ContentControl>
                                    </DataTemplate>

                                    <DataTemplate x:Key="PrimaryOrObjectiveTemplate" DataType="{x:Type model:HintPointModel}">
                                        <ContentControl Content="{Binding}"
                                                        IsTabStop="False"
                                                        Style="{StaticResource ObjectiveHintPointStyle}">
                                            <ContentControl.Resources>
                                                <ImageSource x:Key="ObjectiveIcon">/WPFGUI;component/icons/objectives/objectives_generic_small.png</ImageSource>
                                                <Thickness x:Key="OnScreenOffset">0</Thickness>
                                                <Visibility x:Key="OnScreenArrowVisibility">Visible</Visibility>
                                                <Visibility x:Key="OffScreenIconVisibility">Visible</Visibility>
                                            </ContentControl.Resources>
                                        </ContentControl>
                                    </DataTemplate>

                                    <DataTemplate x:Key="InfoObjectiveTemplate" DataType="{x:Type model:HintPointModel}">
                                        <ContentControl Content="{Binding}"
                                                        IsTabStop="False"
                                                        Style="{StaticResource ObjectiveHintPointStyle}">
                                            <ContentControl.Resources>
                                                <ImageSource x:Key="ObjectiveIcon">/WPFGUI;component/icons/objectives/objectives_warning_small.png</ImageSource>
                                                <Thickness x:Key="OnScreenOffset">0,0,0,254</Thickness>
                                                <Visibility x:Key="OnScreenArrowVisibility">Collapsed</Visibility>
                                                <Visibility x:Key="OffScreenIconVisibility">Visible</Visibility>
                                            </ContentControl.Resources>
                                        </ContentControl>
                                    </DataTemplate>

                                    <DataTemplate x:Key="CaptureObjectiveTemplate" DataType="{x:Type model:HintPointModel}">
                                        <ContentControl Content="{Binding}"
                                                        IsTabStop="False"
                                                        Style="{StaticResource ObjectiveHintPointStyle}">
                                            <ContentControl.Resources>
                                                <ImageSource x:Key="ObjectiveIcon">/WPFGUI;component/icons/objectives/objectives_capture_small.png</ImageSource>
                                                <Thickness x:Key="OnScreenOffset">0,0,0,254</Thickness>
                                                <Visibility x:Key="OnScreenArrowVisibility">Collapsed</Visibility>
                                                <Visibility x:Key="OffScreenIconVisibility">Visible</Visibility>
                                            </ContentControl.Resources>
                                        </ContentControl>
                                    </DataTemplate>

                                    <DataTemplate x:Key="BattleObjectiveTemplate" DataType="{x:Type model:HintPointModel}">
                                        <ContentControl Content="{Binding}"
                                                        IsTabStop="False"
                                                        Style="{StaticResource ObjectiveHintPointStyle}">
                                            <ContentControl.Resources>
                                                <ImageSource x:Key="ObjectiveIcon">/WPFGUI;component/icons/objectives/objectives_battle_small.png</ImageSource>
                                                <Thickness x:Key="OnScreenOffset">0</Thickness>
                                                <Visibility x:Key="OnScreenArrowVisibility">Visible</Visibility>
                                                <Visibility x:Key="OffScreenIconVisibility">Visible</Visibility>
                                            </ContentControl.Resources>
                                        </ContentControl>
                                    </DataTemplate>

                                    <DataTemplate x:Key="ConquerorObjectiveTemplate" DataType="{x:Type model:HintPointModel}">
                                        <ContentControl Content="{Binding}"
                                                        IsTabStop="False"
                                                        Style="{StaticResource ObjectiveHintPointStyle}">
                                            <ContentControl.Resources>
                                                <ImageSource x:Key="ObjectiveIcon">/WPFGUI;component/icons/objectives/objectives_conqueror_small.png</ImageSource>
                                                <Thickness x:Key="OnScreenOffset">0</Thickness>
                                                <Visibility x:Key="OnScreenArrowVisibility">Visible</Visibility>
                                                <Visibility x:Key="OffScreenIconVisibility">Visible</Visibility>
                                            </ContentControl.Resources>
                                        </ContentControl>
                                    </DataTemplate>

                                    <DataTemplate x:Key="BuildObjectiveTemplate" DataType="{x:Type model:HintPointModel}">
                                        <ContentControl Content="{Binding}"
                                                        IsTabStop="False"
                                                        Style="{StaticResource ObjectiveHintPointStyle}">
                                            <ContentControl.Resources>
                                                <ImageSource x:Key="ObjectiveIcon">/WPFGUI;component/icons/objectives/objectives_build_small.png</ImageSource>
                                                <Thickness x:Key="OnScreenOffset">0</Thickness>
                                                <Visibility x:Key="OnScreenArrowVisibility">Visible</Visibility>
                                                <Visibility x:Key="OffScreenIconVisibility">Visible</Visibility>
                                            </ContentControl.Resources>
                                        </ContentControl>
                                    </DataTemplate>

                                    <DataTemplate x:Key="LeaderInjuredObjectiveTemplate" DataType="{x:Type model:HintPointModel}">
                                        <ContentControl Content="{Binding}"
                                                        IsTabStop="False"
                                                        Style="{StaticResource ObjectiveHintPointStyle}">
                                            <ContentControl.Resources>
                                                <ImageSource x:Key="ObjectiveIcon">/WPFGUI;component/icons/objectives/objectives_leader_small.png</ImageSource>
                                                <Thickness x:Key="OnScreenOffset">0,0,0,0</Thickness>
                                                <Visibility x:Key="OnScreenArrowVisibility">Visible</Visibility>
                                                <Visibility x:Key="OffScreenIconVisibility">Visible</Visibility>
                                            </ContentControl.Resources>
                                        </ContentControl>
                                    </DataTemplate>

                                    <DataTemplate x:Key="SecondaryObjectiveTemplate" DataType="{x:Type model:HintPointModel}">
                                        <ContentControl Content="{Binding}"
                                                        IsTabStop="False"
                                                        Style="{StaticResource ObjectiveHintPointStyle}">
                                            <ContentControl.Resources>
                                                <ImageSource x:Key="ObjectiveIcon">/WPFGUI;component/icons/objectives/objectives_generic_small.png</ImageSource>
                                                <Thickness x:Key="OnScreenOffset">0</Thickness>
