                                                        IsTabStop="False"
                                                        Style="{StaticResource ObjectiveHintPointStyle}">
                                            <ContentControl.Resources>
                                                <ImageSource x:Key="ObjectiveIcon">/WPFGUI;component/icons/objectives/objectives_generic_small.png</ImageSource>
                                                <Thickness x:Key="OnScreenOffset">0,0,0,254</Thickness>
                                                <Visibility x:Key="OnScreenArrowVisibility">Collapsed</Visibility>
                                                <Visibility x:Key="OffScreenIconVisibility">Visible</Visibility>
                                            </ContentControl.Resources>
                                        </ContentControl>
                                    </DataTemplate>

                                    <!--  Build cost widget for Rebuilding Moscow Palisades  -->
                                    <DataTemplate x:Key="BuildCostWidgetTemplate" DataType="{x:Type model:HintPointModel}">
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Target.IsPotentialSelected}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation EasingFunction="{StaticResource QuadEaseOut}"
                                                                             Storyboard.TargetName="Icon" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                                             To="1.8" Duration="0:0:0.1" />
                                                            <DoubleAnimation EasingFunction="{StaticResource QuadEaseOut}"
                                                                             Storyboard.TargetName="Icon" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                                             To="1.8" Duration="0:0:0.1" />
                                                            <DoubleAnimation EasingFunction="{StaticResource QuadEaseOut}"
                                                                             Storyboard.TargetName="IconBG" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                                             To="0.8" Duration="0:0:0.14" />
                                                            <DoubleAnimation EasingFunction="{StaticResource QuadEaseOut}"
                                                                             Storyboard.TargetName="IconBG" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                                             To="0.8" Duration="0:0:0.14" />
                                                            <DoubleAnimation Storyboard.TargetName="IconContainer" Storyboard.TargetProperty="Opacity"
                                                                             To="0" Duration="0:0:0.1" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard BeginTime="0:0:0">
                                                            <DoubleAnimation EasingFunction="{StaticResource QuadEaseIn}"
                                                                             Storyboard.TargetName="Icon" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                                             To="1" Duration="0:0:0.08" />
                                                            <DoubleAnimation EasingFunction="{StaticResource QuadEaseIn}"
                                                                             Storyboard.TargetName="Icon" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                                             To="1" Duration="0:0:0.08" />
                                                            <DoubleAnimation EasingFunction="{StaticResource QuadEaseIn}"
                                                                             Storyboard.TargetName="IconBG" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                                             To="1" Duration="0:0:0.08" />
                                                            <DoubleAnimation EasingFunction="{StaticResource QuadEaseIn}"
                                                                             Storyboard.TargetName="IconBG" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                                             To="1" Duration="0:0:0.08" />
                                                            <DoubleAnimation Storyboard.TargetName="IconContainer" Storyboard.TargetProperty="Opacity"
                                                                             To="1" Duration="0:0:0.08" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                        <Grid Margin="0,0,0,-120"
                                              DataContext="{Binding Target}"
                                              Style="{StaticResource HintPointBody}">
                                            <Control Margin="0,8,0,0"
                                                     IsTabStop="False"
                                                     Style="{StaticResource BuildCostWidgetControlStyle}" />
                                            <Viewbox Width="60"
                                                     HorizontalAlignment="Center" VerticalAlignment="Top">
                                                <Grid x:Name="IconContainer">
                                                    <Image x:Name="IconBG"
                                                           Width="92"
                                                           RenderTransformOrigin="0.5,0.5" Source="/WPFGUI;component/icons/objectives/golden_circle.png">
                                                        <Image.RenderTransform>
                                                            <ScaleTransform />
                                                        </Image.RenderTransform>
                                                    </Image>
                                                    <Image x:Name="Icon"
                                                           Width="32" Height="32"
                                                           Margin="0,0,1,2"
                                                           RenderTransformOrigin="0.5,0.5" Source="/WPFGUI;component/icons/objectives/objectives_build_small.png">
                                                        <Image.RenderTransform>
                                                            <ScaleTransform />
                                                        </Image.RenderTransform>
                                                    </Image>
                                                </Grid>
                                            </Viewbox>
                                        </Grid>
                                    </DataTemplate>

                                    <!--  Build cost widget for Rebuilding Moscow buildings  -->
                                    <DataTemplate x:Key="BuildCostWidgetNoIconTemplate" DataType="{x:Type model:HintPointModel}">
                                        <Grid Margin="0,0,0,-100"
                                              DataContext="{Binding Target}"
                                              Style="{StaticResource HintPointBody}">
                                            <Control IsTabStop="False" Style="{StaticResource BuildCostWidgetControlStyle}" />
                                        </Grid>
                                    </DataTemplate>

                                    <!--  MULTIPLAYER  OBJECTIVE TEMPLATES  -->

                                    <DataTemplate x:Key="ConquestObjectiveTemplate" DataType="{x:Type model:HintPointModel}">
                                        <ContentControl Content="{Binding}"
                                                        IsTabStop="False"
                                                        Style="{StaticResource ObjectiveHintPointStyle}">
                                            <ContentControl.Resources>
                                                <ImageSource x:Key="ObjectiveIcon">/WPFGUI;component/icons/objectives/objectives_battle_small.png</ImageSource>
                                                <Thickness x:Key="OnScreenOffset">0</Thickness>
                                                <Visibility x:Key="OnScreenArrowVisibility">Visible</Visibility>
                                                <Visibility x:Key="OffScreenIconVisibility">Visible</Visibility>
                                            </ContentControl.Resources>
                                        </ContentControl>
                                    </DataTemplate>

                                    <DataTemplate x:Key="WonderObjectiveTemplate" DataType="{x:Type model:HintPointModel}">
                                        <ContentControl Content="{Binding}"
                                                        IsTabStop="False"
                                                        Style="{StaticResource ObjectiveHintPointStyle}">
                                            <ContentControl.Resources>
                                                <ImageSource x:Key="ObjectiveIcon">/WPFGUI;component/icons/objectives/objectives_wonder_small.png</ImageSource>
                                                <Thickness x:Key="OnScreenOffset">0</Thickness>
                                                <Visibility x:Key="OnScreenArrowVisibility">Visible</Visibility>
                                                <Visibility x:Key="OffScreenIconVisibility">Visible</Visibility>
                                            </ContentControl.Resources>
                                        </ContentControl>
                                    </DataTemplate>

                                    <DataTemplate x:Key="WonderOrObjectiveTemplate" DataType="{x:Type model:HintPointModel}">
                                        <ContentControl Content="{Binding}"
                                                        IsTabStop="False"
                                                        Style="{StaticResource ObjectiveHintPointStyle}">
                                            <ContentControl.Resources>
                                                <ImageSource x:Key="ObjectiveIcon">/WPFGUI;component/icons/objectives/objectives_wonder_small.png</ImageSource>
                                                <Thickness x:Key="OnScreenOffset">0</Thickness>
                                                <Visibility x:Key="OnScreenArrowVisibility">Visible</Visibility>
                                                <Visibility x:Key="OffScreenIconVisibility">Visible</Visibility>
                                            </ContentControl.Resources>
                                        </ContentControl>
                                    </DataTemplate>

                                    <!--  This is the Sacred Site Hint Point (aka Holy Site), if looking the decorator (thing floating above the sacred site), search for EntityStrategicPointDecoratorModel  -->
                                    <DataTemplate x:Key="HolySiteObjectiveTemplate" DataType="{x:Type model:HintPointModel}">
                                        <ContentControl Content="{Binding}" IsTabStop="False">
                                            <ContentControl.Resources>
                                                <ImageSource x:Key="ObjectiveIcon">/WPFGUI;component/icons/objectives/objectives_holy_site_small.png</ImageSource>
                                                <Thickness x:Key="OnScreenOffset">0,0,0,254</Thickness>
                                                <Visibility x:Key="OnScreenArrowVisibility">Collapsed</Visibility>
                                                <Visibility x:Key="OffScreenIconVisibility">Visible</Visibility>
                                                <SolidColorBrush x:Key="PrimaryColorGradientHorizontalReverseBrush" Color="{Binding Objective.Colour}" />
                                                <DataTemplate x:Key="ObjectiveStatusIconTemplate" DataType="{x:Type model:HintPointModel}">
                                                    <Image Height="28" Margin="0,0,0,-6">
                                                        <Image.Style>
                                                            <Style TargetType="Image">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Objective.State}" Value="{x:Static model:ObjectiveState.Complete}">
                                                                        <Setter Property="Source" Value="/WPFGUI;component/icons/objectives/objective_complete.png" />
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Objective.State}" Value="{x:Static model:ObjectiveState.Failed}">
                                                                        <Setter Property="Source" Value="/WPFGUI;component/icons/objectives/objectives_battle_small.png" />
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Image.Style>
                                                    </Image>
                                                </DataTemplate>
                                            </ContentControl.Resources>

                                            <ContentControl.Style>
                                                <Style BasedOn="{StaticResource ObjectiveHintPointStyle}" TargetType="ContentControl">
                                                    <Setter Property="Background" Value="White" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Objective.State}" Value="{x:Static model:ObjectiveState.Failed}">
                                                            <Setter Property="Background">
                                                                <Setter.Value>
                                                                    <SolidColorBrush Color="{Binding Objective.Colour}" />
                                                                </Setter.Value>
                                                            </Setter>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ContentControl.Style>
                                        </ContentControl>
                                    </DataTemplate>

                                    <!--
                                        Skipping these, use HolySiteObjectiveTemplate instead or create the templates if needed.
                                        - HolySiteObjectiveTemplate
                                        - HolySiteSecondaryObjectiveTemplate
                                    -->

                                    <!--  END OF OBJECTIVE TEMPLATES  -->

                                    <!--  Training Hint Point tempalte with TagAdorner attached  -->
                                    <DataTemplate x:Key="TrainingHintPointTemplate">
                                        <StackPanel esControls:TagAdorner.AlignmentMode="Relative"
                                                    esControls:TagAdorner.ArrowDataTemplate="{StaticResource TagArrowDataTemplate}"
                                                    esControls:TagAdorner.ClampMode="Custom"
                                                    esControls:TagAdorner.DataTemplate="{StaticResource TagDataTemplate}"
                                                    esControls:TagAdorner.HorizontalAnchor="Center" esControls:TagAdorner.HorizontalPlacement="Center"
                                                    esControls:TagAdorner.TargetDataTemplate="{StaticResource EmptyTagDataTemplate}"
                                                    esControls:TagAdorner.VerticalAnchor="Top" esControls:TagAdorner.VerticalPlacement="Top"
                                                    Opacity="0.9" Orientation="Vertical"
                                                    Style="{StaticResource HintPointBody}">
                                            <esControls:TagAdorner.IsTagged>
                                                <MultiBinding Converter="{StaticResource IsTaggedConverter}" ConverterParameter="TrainingHintPoint">
                                                    <Binding Path="TagVersion" Source="{x:Static model:HUDModel.Instance}" />
                                                </MultiBinding>
                                            </esControls:TagAdorner.IsTagged>
                                            <esControls:TagAdorner.Data>
                                                <MultiBinding Converter="{StaticResource TagDataConverter}" ConverterParameter="TrainingHintPoint">
                                                    <Binding Path="TagVersion" Source="{x:Static model:HUDModel.Instance}" />
                                                </MultiBinding>
                                            </esControls:TagAdorner.Data>
                                            <Image Width="48" Height="48"
                                                   HorizontalAlignment="Center"
                                                   Source="{Binding Icon}" />
                                            <TextBlock MaxWidth="280"
                                                       Margin="0,0,0,8" HorizontalAlignment="Center"
                                                       Style="{StaticResource nHUDBaseHeavyTextBlockStyle}"
                                                       Text="{Binding Text}"
                                                       TextAlignment="Center" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>

                                    <DataTemplate x:Key="BouncingArrowObjectiveTemplate" DataType="{x:Type model:HintPointModel}">
                                        <Grid>
                                            <!--  on screen  -->
                                            <StackPanel Orientation="Vertical" Style="{StaticResource HintPointBody}">
                                                <ContentControl Margin="0,0,0,254" HorizontalAlignment="Center"
                                                                VerticalAlignment="Bottom"
                                                                IsHitTestVisible="False" IsTabStop="False"
                                                                Visibility="{Binding Titles.SubtitleSpeechVisibility}">
                                                    <StackPanel>
                                                        <Image Width="70" Height="70"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Source="/WPFGUI;component/icons/objective_arrow.png">
                                                            <Image.RenderTransform>
                                                                <TranslateTransform x:Name="transTransform" X="0" Y="0" />
                                                            </Image.RenderTransform>
                                                        </Image>
                                                    </StackPanel>
                                                </ContentControl>
                                            </StackPanel>
                                            <!--  off screen  -->
                                            <Image Width="70" Height="70"
                                                   Source="/WPFGUI;component/icons/objective_arrow.png"
                                                   Style="{StaticResource LocationIndicator}" />
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Objective.State}" Value="{x:Static model:ObjectiveState.Incomplete}">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard Name="BouncingArrowStoryboard">
                                                        <Storyboard RepeatBehavior="Forever">
                                                            <DoubleAnimation AutoReverse="True"
                                                                             Storyboard.TargetName="transTransform" Storyboard.TargetProperty="Y"
                                                                             From="1" To="15"
                                                                             Duration="00:00:1">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <BounceEase Bounces="1" Bounciness="0"
                                                                                EasingMode="EaseOut" />
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="BouncingArrowStoryboard" />
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>

                                </esModels:DataTemplateSourceSelector.Resources>
                            </esModels:DataTemplateSourceSelector>
                        </ItemsControl.ItemTemplateSelector>
                    </eHUDControls:CompassControl>
                </Grid>

                <Grid x:Name="Titles"
                      Width="Auto" Height="Auto"
                      IsHitTestVisible="False">

                    <TextBlock Padding="20" VerticalAlignment="Center"
                               Opacity="{Binding Titles.TitleAlpha}"
                               Style="{StaticResource HUDWhiteTitleTextBlock27ptStyle}"
                               Text="{Binding Titles.TitleText}"
                               TextAlignment="Center" TextWrapping="Wrap"
                               Visibility="{Binding Titles.TitleVisibility, FallbackValue=Collapsed}" />

                    <!--  Scripted Camera Title with multi-line text  -->
                    <!--  Also known as Campaign Title  -->
                    <StackPanel Margin="0,325,0,0" HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                IsHitTestVisible="False"
                                Opacity="{Binding Titles.SubtitleAlpha}"
                                Orientation="Vertical"
                                Visibility="{Binding Titles.SubTitleVisibility, FallbackValue=Collapsed}">

                        <Grid RenderTransformOrigin="0.5,0.6">
                            <Ellipse Width="120" Height="120"
                                     Margin="0,55,0,0" HorizontalAlignment="Center"
                                     VerticalAlignment="Top">
                                <Ellipse.Fill>
                                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                                        <GradientStop Offset="0.8333" Color="{DynamicResource TertiaryColorDark}" />
                                        <GradientStop Offset="1" Color="{DynamicResource TertiaryColorDarkTransparent}" />
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>

                            <Image Width="175" Height="175"
                                   Margin="0,0,0,8"
                                   Source="{Binding Titles.SubtitleIcon}" />

                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="{Binding Titles.SubtitleAlpha}" ScaleY="{Binding Titles.SubtitleAlpha}" />
                            </Grid.RenderTransform>
                        </Grid>

                        <Grid MinWidth="430">
                            <Rectangle RenderTransformOrigin="0.5,0.5">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Offset="0" Color="{DynamicResource TertiaryColorDarkTransparent}" />
                                        <GradientStop Offset="0.125" Color="{DynamicResource TertiaryColorDark}" />
                                        <GradientStop Offset="0.875" Color="{DynamicResource TertiaryColorDark}" />
                                        <GradientStop Offset="1" Color="{DynamicResource TertiaryColorDarkTransparent}" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                                <Rectangle.RenderTransform>
                                    <ScaleTransform ScaleX="{Binding Titles.SubtitleAlpha}" />
                                </Rectangle.RenderTransform>
                            </Rectangle>

                            <Separator Margin="60,-1" HorizontalAlignment="Stretch"
                                       VerticalAlignment="Top"
                                       Style="{StaticResource PrimarySeperatorStyle}" />

                            <Image Width="243"
                                   Margin="0,-7,0,0" HorizontalAlignment="Center"
                                   VerticalAlignment="Top"
                                   RenderTransformOrigin="0.5,0.5" Source="/WPFGUI;component/icons/HUD/objectives/objective_bottom_image_big.png">
                                <!--<Image.RenderTransform>
                                    <RotateTransform Angle="180" />
                                </Image.RenderTransform>-->
                            </Image>

                            <TextBlock Margin="60,30,60,25"
                                       Style="{StaticResource HUDGoldGradientColorTitleTextBlock37ptStyle}"
                                       Text="{Binding Titles.SubtitleText}"
                                       TextAlignment="Center" TextWrapping="Wrap" />

                            <Separator Margin="60,0" HorizontalAlignment="Stretch"
                                       VerticalAlignment="Bottom"
                                       Style="{StaticResource PrimarySeperatorStyle}" />

                            <Image Width="234"
                                   Margin="0,0,0,-8" HorizontalAlignment="Center"
                                   VerticalAlignment="Bottom"
                                   RenderTransformOrigin="0.5,0.5" Source="/WPFGUI;component/icons/HUD/objectives/objective_bottom_image_big.png" />
                        </Grid>
                    </StackPanel>

                    <!--  Objective Title  -->
                    <ContentControl Margin="0,234,0,0" HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    Content="{Binding}"
                                    DataContext="{Binding Titles}"
                                    IsHitTestVisible="False" IsTabStop="False"
                                    Visibility="{Binding ObjectiveTextVisibility}">
                        <ContentControl.Resources>
                            <Style x:Key="ObjectiveTitleIconStyle" TargetType="Image">
                                <Setter Property="Height" Value="32" />
                                <Setter Property="Margin" Value="0,0,1,2" />
                                <Setter Property="Source" Value="/WPFGUI;component/icons/objectives/objectives_generic_small.png" />
                                <Setter Property="Width" Value="32" />

                                <Style.Triggers>

                                    <!--  KEEP THESE DATA TEMPLATES IN SYNC WITH THOSE OF THE OBJECTIVE LIST AND OBJECTIVE HINT POINTS  -->

                                    <!--  CAMPAIGN AND CHALLENGE OBJECTIVE TEMPLATES  -->

                                    <DataTrigger Binding="{Binding}" Value="PrimaryObjectiveDataTemplate">
                                        <Setter Property="Source" Value="/WPFGUI;component/icons/objectives/objectives_generic_small.png" />
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding}" Value="PrimaryOrObjectiveDataTemplate">
                                        <Setter Property="Source" Value="/WPFGUI;component/icons/objectives/objectives_generic_small.png" />
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding}" Value="InfoObjectiveDataTemplate">
                                        <Setter Property="Source" Value="/WPFGUI;component/icons/objectives/objectives_warning_small.png" />
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding}" Value="CaptureObjectiveDataTemplate">
                                        <Setter Property="Source" Value="/WPFGUI;component/icons/objectives/objectives_capture_small.png" />
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding}" Value="BattleObjectiveDataTemplate">
                                        <Setter Property="Source" Value="/WPFGUI;component/icons/objectives/objectives_battle_small.png" />
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding}" Value="BuildObjectiveDataTemplate">
                                        <Setter Property="Source" Value="/WPFGUI;component/icons/objectives/objectives_build_small.png" />
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding}" Value="LeaderInjuredObjectiveDataTemplate">
                                        <Setter Property="Source" Value="/WPFGUI;component/icons/objectives/objectives_leader_small.png" />
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding}" Value="SecondaryObjectiveDataTemplate">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding}" Value="SecondaryObjectiveOrDataTemplate">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding}" Value="TipObjectiveDataTemplate">
                                        <Setter Property="Source" Value="/WPFGUI;component/icons/objectives/objective_tip.png" />
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding}" Value="OptionalObjectiveDataTemplate">
                                        <Setter Property="Source" Value="/WPFGUI;component/icons/objectives/objectives_optional_small.png" />
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding}" Value="BonusObjectiveDataTemplate">
                                        <Setter Property="Source" Value="/WPFGUI;component/icons/objectives/objectives_optional_small.png" />
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding}" Value="ChallengeGoldObjectiveDataTemplate">
                                        <Setter Property="Source" Value="/WPFGUI;component/icons/objectives/challenge_medal_gold.png" />
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding}" Value="ChallengesSilverObjectiveDataTemplate">
                                        <Setter Property="Source" Value="/WPFGUI;component/icons/objectives/challenge_medal_silver.png" />
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding}" Value="ChallengeBronzeObjectiveDataTemplate">
                                        <Setter Property="Source" Value="/WPFGUI;component/icons/objectives/challenge_medal_bronze.png" />
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding}" Value="ChallengeNoMedalObjectiveDataTemplate">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding}" Value="StrengthTugOfWarObjectiveDataTemplate">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding}" Value="StrengthTugOfWarObjectiveWithVelocityDataTemplate">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding}" Value="UnrestObjectiveDataTemplate">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>

                                    <!--  MULTIPLAYER  OBJECTIVE TEMPLATES  -->

                                    <DataTrigger Binding="{Binding}" Value="ConquestObjectiveTemplate">
                                        <Setter Property="Source" Value="/WPFGUI;component/icons/objectives/objectives_battle_small.png" />
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding}" Value="WonderObjectiveTemplate">
                                        <Setter Property="Source" Value="/WPFGUI;component/icons/objectives/objectives_wonder_small.png" />
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding}" Value="WonderOrObjectiveTemplate">
                                        <Setter Property="Source" Value="/WPFGUI;component/icons/objectives/objectives_wonder_small.png" />
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding}" Value="HolySiteObjectiveDataTemplate">
                                        <Setter Property="Source" Value="/WPFGUI;component/icons/objectives/objectives_holy_site_small.png" />
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding}" Value="HolySiteOrObjectiveDataTemplate">
                                        <Setter Property="Source" Value="/WPFGUI;component/icons/objectives/objectives_holy_site_small.png" />
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding}" Value="HolySiteSecondaryObjectiveDataTemplate">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>

                            <Style x:Key="ObjectiveTitleStatusIconStyle" TargetType="Image">
                                <Setter Property="Height" Value="42" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Setter Property="Width" Value="42" />

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ObjectiveState}" Value="{x:Static model:ObjectiveState.Complete}">
                                        <Setter Property="Source" Value="/WPFGUI;component/icons/HUD/objectives/objective_completed.png" />
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ObjectiveState}" Value="{x:Static model:ObjectiveState.Failed}">
                                        <Setter Property="Source" Value="/WPFGUI;component/icons/HUD/objectives/objective_failed.png" />
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>

                            <DataTemplate x:Key="ObjectiveTitleTemplate" DataType="{x:Type model:TitleModel}">
                                <Grid MinWidth="570"
                                      HorizontalAlignment="Center"
                                      Opacity="{Binding ObjectiveTextAlpha}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Rectangle Grid.Row="1" RenderTransformOrigin="0.5,0.5">
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Offset="0" Color="{DynamicResource TertiaryColorDarkTransparent}" />
                                                <GradientStop Offset="0.125" Color="{DynamicResource TertiaryColorDark}" />
                                                <GradientStop Offset="0.875" Color="{DynamicResource TertiaryColorDark}" />
                                                <GradientStop Offset="1" Color="{DynamicResource TertiaryColorDarkTransparent}" />
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                        <Rectangle.RenderTransform>
                                            <ScaleTransform ScaleX="{Binding ObjectiveTextAlpha}" />
                                        </Rectangle.RenderTransform>
                                    </Rectangle>

                                    <Separator Grid.Row="0"
                                               Margin="35,0,35,0" HorizontalAlignment="Stretch"
                                               VerticalAlignment="Bottom"
                                               Style="{StaticResource PrimarySeperatorStyle}" />

                                    <Viewbox Grid.Row="0"
                                             Width="230"
                                             Margin="0,0,0,-15" HorizontalAlignment="Center"
                                             VerticalAlignment="Bottom"
                                             Visibility="{Binding Visibility, ElementName=IconOverride, Converter={StaticResource InvVis}}">
                                        <Grid>
                                            <Image Width="230"
                                                   Margin="0,0,0,7" HorizontalAlignment="Center"
                                                   VerticalAlignment="Bottom"
                                                   RenderTransformOrigin="0.5,0.5" Source="/WPFGUI;component/icons/HUD/objectives/objective_bottom_image_big.png">
                                                <Image.RenderTransform>
                                                    <RotateTransform Angle="180" />
                                                </Image.RenderTransform>
                                            </Image>

                                            <Ellipse Width="46" Height="46"
                                                     Fill="{DynamicResource TertiaryColorDarkBrush}" />

                                            <Grid RenderTransformOrigin="0.5,0.5">
                                                <Grid.RenderTransform>
                                                    <ScaleTransform ScaleX="{Binding ObjectiveTextAlpha}" ScaleY="{Binding ObjectiveTextAlpha}" />
                                                </Grid.RenderTransform>

                                                <Grid Visibility="{Binding ObjectiveState, Converter={StaticResource EqualToConverter}, ConverterParameter={x:Static model:ObjectiveState.Incomplete}}">
                                                    <Image Name="MainObjectiveIcon"
                                                           DataContext="{Binding ObjectiveDataTemplate}"
                                                           Style="{StaticResource ObjectiveTitleIconStyle}" />

                                                    <Image Name="SecondaryObjectiveIcon"
                                                           DataContext="{Binding ParentObjective.DataTemplate}"
                                                           Style="{StaticResource ObjectiveTitleIconStyle}"
                                                           Visibility="{Binding ElementName=MainObjectiveIcon, Path=Visibility, Converter={StaticResource EqualToConverter}, ConverterParameter={x:Static Visibility.Collapsed}}" />
                                                </Grid>

                                                <Image Style="{StaticResource ObjectiveTitleStatusIconStyle}" />
                                            </Grid>

                                            <Image Width="126" Source="/WPFGUI;component/icons/HUD/objectives/objective_top_image.png" />
                                        </Grid>
                                    </Viewbox>

                                    <Image x:Name="IconOverride"
                                           Width="150" Height="150"
                                           Margin="0,0,0,-12">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Setter Property="Visibility" Value="{Binding Source, RelativeSource={RelativeSource Self}, Converter={StaticResource NotNullToVis}}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ObjectiveDataTemplate}" Value="RogueBronzeMedalTemplate">
                                                        <Setter Property="Source" Value="/WPFGUI;component/icons/medals/bronze_3.png" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ObjectiveDataTemplate}" Value="RogueSivlerMedalTemplate">
                                                        <Setter Property="Source" Value="/WPFGUI;component/icons/medals/silver_3.png" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ObjectiveDataTemplate}" Value="RogueGoldMedalTemplate">
                                                        <Setter Property="Source" Value="/WPFGUI;component/icons/medals/gold_3.png" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ObjectiveDataTemplate}" Value="RogueConquerorMedalTemplate">
                                                        <Setter Property="Source" Value="/WPFGUI;component/icons/medals/conquerer_3.png" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>

                                    <Grid Grid.Row="1" Margin="60,12,60,12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!--  New Objective!  -->
                                        <TextBlock Grid.Row="0"
                                                   Style="{StaticResource HUDObjectiveTitleStatusIncompleteTextBlockStyle}"
                                                   Text="{esUtility:LocString $11169066}"
                                                   TextAlignment="Center" TextWrapping="Wrap"
                                                   Visibility="{Binding ObjectiveState, Converter={StaticResource IsEqualVisibilityConverter}, ConverterParameter={x:Static model:ObjectiveState.Incomplete}}" />
                                        <!--  Objective completed!  -->
                                        <TextBlock Grid.Row="0"
                                                   Style="{StaticResource HUDObjectiveTitleStatusCompleteTextBlockStyle}"
                                                   Text="{esUtility:LocString $11169067}"
                                                   TextAlignment="Center" TextWrapping="Wrap"
                                                   Visibility="{Binding ObjectiveState, Converter={StaticResource IsEqualVisibilityConverter}, ConverterParameter={x:Static model:ObjectiveState.Complete}}" />
                                        <!--  Objective failed!  -->
                                        <TextBlock Grid.Row="0"
                                                   Style="{StaticResource HUDObjectiveTitleStatusFailedTextBlockStyle}"
                                                   Text="{esUtility:LocString $11169068}"
                                                   TextAlignment="Center" TextWrapping="Wrap"
                                                   Visibility="{Binding ObjectiveState, Converter={StaticResource IsEqualVisibilityConverter}, ConverterParameter={x:Static model:ObjectiveState.Failed}}" />

                                        <TextBlock Grid.Row="1"
                                                   Margin="0,14,0,6"
                                                   Style="{StaticResource HUDPrimaryColorLightBaseAltTextBlock24ptStyle}"
                                                   Text="{Binding ObjectiveText}"
                                                   TextAlignment="Center" />
                                    </Grid>

                                    <Separator Grid.Row="2"
                                               Margin="35,-1,35,0" HorizontalAlignment="Stretch"
                                               VerticalAlignment="Top"
                                               Style="{StaticResource PrimarySeperatorStyle}" />

                                    <Grid Grid.Row="2" Margin="0,-10,0,0">
                                        <Image Width="230"
                                               Margin="0,2,0,0" HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Source="/WPFGUI;component/icons/HUD/objectives/objective_bottom_image_big.png" />
                                    </Grid>
                                </Grid>
                            </DataTemplate>

                            <DataTemplate x:Key="FtueObjectiveTitleTemplate">
                                <Button IsTabStop="False">
                                    <Button.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform ScaleX="1" ScaleY="1" />
                                            <TranslateTransform X="0" Y="0" />
                                        </TransformGroup>
                                    </Button.RenderTransform>
                                    <Button.Style>
                                        <Style BasedOn="{StaticResource InvisibleButton}" TargetType="Button">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ObjectiveTextVisibility}" Value="{x:Static Visibility.Visible}">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)">
                                                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                                                    <DiscreteDoubleKeyFrame KeyTime="0:0:3" Value="1" />
                                                                    <EasingDoubleKeyFrame KeyTime="0:0:4.5" Value="0.2">
                                                                        <EasingDoubleKeyFrame.EasingFunction>
                                                                            <QuinticEase EasingMode="EaseIn" />
                                                                        </EasingDoubleKeyFrame.EasingFunction>
                                                                    </EasingDoubleKeyFrame>
                                                                </DoubleAnimationUsingKeyFrames>
                                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)">
                                                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                                                    <DiscreteDoubleKeyFrame KeyTime="0:0:3" Value="1" />
                                                                    <EasingDoubleKeyFrame KeyTime="0:0:4.5" Value="0.2">
                                                                        <EasingDoubleKeyFrame.EasingFunction>
                                                                            <QuinticEase EasingMode="EaseIn" />
                                                                        </EasingDoubleKeyFrame.EasingFunction>
                                                                    </EasingDoubleKeyFrame>
                                                                </DoubleAnimationUsingKeyFrames>
                                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.X)">
                                                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                                                    <DiscreteDoubleKeyFrame KeyTime="0:0:3" Value="0" />
                                                                    <EasingDoubleKeyFrame KeyTime="0:0:4.5" Value="-700">
                                                                        <EasingDoubleKeyFrame.EasingFunction>
                                                                            <QuinticEase EasingMode="EaseIn" />
                                                                        </EasingDoubleKeyFrame.EasingFunction>
                                                                    </EasingDoubleKeyFrame>
                                                                </DoubleAnimationUsingKeyFrames>
                                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)">
                                                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                                                    <DiscreteDoubleKeyFrame KeyTime="0:0:3" Value="0" />
                                                                    <EasingDoubleKeyFrame KeyTime="0:0:4.5" Value="-210">
                                                                        <EasingDoubleKeyFrame.EasingFunction>
                                                                            <QuinticEase EasingMode="EaseIn" />
                                                                        </EasingDoubleKeyFrame.EasingFunction>
                                                                    </EasingDoubleKeyFrame>
                                                                </DoubleAnimationUsingKeyFrames>
                                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                                                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                                                    <DiscreteDoubleKeyFrame KeyTime="0:0:3" Value="1" />
                                                                    <EasingDoubleKeyFrame KeyTime="0:0:4.5" Value="0">
                                                                        <EasingDoubleKeyFrame.EasingFunction>
                                                                            <QuinticEase EasingMode="EaseIn" />
                                                                        </EasingDoubleKeyFrame.EasingFunction>
                                                                    </EasingDoubleKeyFrame>
                                                                </DoubleAnimationUsingKeyFrames>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <ContentControl Content="{Binding}"
                                                    ContentTemplate="{StaticResource ObjectiveTitleTemplate}"
                                                    IsTabStop="False" />
                                </Button>
                            </DataTemplate>
                        </ContentControl.Resources>
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="ContentTemplate" Value="{StaticResource ObjectiveTitleTemplate}" />
                                <Style.Triggers>
                                    <DataTrigger Value="True">
                                        <DataTrigger.Binding>
                                            <MultiBinding Converter="{StaticResource MultiLogicalAnd}">
                                                <Binding Path="IsFTUE" Source="{x:Static model:HUDModel.Instance}" />
                                                <Binding Converter="{StaticResource EqualityCompare}"
                                                         ConverterParameter="{x:Static model:ObjectiveState.Incomplete}"
                                                         Path="ObjectiveState" />
                                            </MultiBinding>
                                        </DataTrigger.Binding>
                                        <Setter Property="ContentTemplate" Value="{StaticResource FtueObjectiveTitleTemplate}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                </Grid>

                <Grid x:Name="Taskbar" Visibility="{Binding TaskbarVisibleVisibility, FallbackValue=Collapsed}">

                    <!--  Age Display V2 + LandmarkInConstruction + GameTimer  -->
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Top"
                          IsHitTestVisible="False">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--  Age display  -->
                        <Control Grid.Row="0"
                                 Margin="0,0,0,-8"
                                 IsTabStop="False" ToolTipService.InitialShowDelay="0"
                                 ToolTipService.IsEnabled="{Binding LocalPlayer.CurrentAge.UIInfo.Help, Converter={StaticResource NotNullOrEmptyString}}"
                                 ToolTipService.ShowDuration="86400000">
                            <Control.ToolTip>
                                <ToolTip MaxWidth="333"
                                         Background="{DynamicResource TertiaryColorGradientVerticalBrush}"
                                         DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                         Effect="{x:Null}"
                                         Placement="Mouse"
                                         Style="{StaticResource FrontEndTooltip}">
                                    <Grid>
                                        <Canvas>
                                            <Image Height="{Binding ActualHeight, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ToolTip}}"
                                                   Margin="-12" HorizontalAlignment="Left"
                                                   VerticalAlignment="Top"
                                                   Source="{Binding LocalPlayer.RaceIconSecondary}"
                                                   Stretch="Uniform">
                                                <Image.OpacityMask>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Offset="0" Color="#33FFFFFF" />
                                                        <GradientStop Offset="0.66" Color="#33FFFFFF" />
                                                        <GradientStop Offset="1" Color="#00FFFFFF" />
                                                    </LinearGradientBrush>
                                                </Image.OpacityMask>
                                            </Image>
                                        </Canvas>

                                        <StackPanel>
                                            <TextBlock Style="{StaticResource nHUDTitleTextBlockStyle}" Text="{Binding LocalPlayer.CurrentAge.UIInfo.Name}" />

                                            <TextBlock Margin="0,4"
                                                       Effect="{x:Null}"
                                                       Style="{StaticResource nHUDBodyTextBlockStyle}"
                                                       Text="{Binding LocalPlayer.CurrentAge.UIInfo.Help}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </ToolTip>
                            </Control.ToolTip>

                            <Control.Template>
                                <ControlTemplate TargetType="Control">
                                    <Grid HorizontalAlignment="Center">
                                        <Image Width="150"
                                               Margin="-25,-27,-27,-27" HorizontalAlignment="Center"
                                               VerticalAlignment="Top"
                                               Stretch="Uniform"
                                               Style="{DynamicResource HUDAgeBackgroundImage}" />
                                        <!--  last age icon  -->
                                        <Image Name="LastAgeIcon"
                                               Height="40"
                                               HorizontalAlignment="Center"
                                               Opacity="0">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Source" Value="{x:Null}" />

                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding LocalPlayer.CurrentAgeNumber}" Value="2">
                                                            <Setter Property="Source" Value="/WPFGUI;component/icons/HUD/age/age_display_afford_1.png" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding LocalPlayer.CurrentAgeNumber}" Value="3">
                                                            <Setter Property="Source" Value="/WPFGUI;component/icons/HUD/age/age_display_afford_2.png" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding LocalPlayer.CurrentAgeNumber}" Value="4">
                                                            <Setter Property="Source" Value="/WPFGUI;component/icons/HUD/age/age_display_afford_3.png" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>

                                        <!--  glowing last age icon  -->
                                        <Image Name="GlowingLastAgeIcon"
                                               Height="40"
                                               HorizontalAlignment="Center"
                                               Opacity="0">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Source" Value="{x:Null}" />

                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding LocalPlayer.CurrentAgeNumber}" Value="2">
                                                            <Setter Property="Source" Value="/WPFGUI;component/icons/HUD/age/age_display_afford_1.png" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding LocalPlayer.CurrentAgeNumber}" Value="3">
                                                            <Setter Property="Source" Value="/WPFGUI;component/icons/HUD/age/age_display_afford_2.png" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding LocalPlayer.CurrentAgeNumber}" Value="4">
                                                            <Setter Property="Source" Value="/WPFGUI;component/icons/HUD/age/age_display_afford_3.png" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>

                                        <!--  current age bg  -->
                                        <Decorator Name="CurrentAgeBgLeftOffset" Width="0" />
                                        <Decorator Name="CurrentAgeBgRightOffset" Width="0" />
                                        <Canvas Width="43" Height="7"
                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Canvas Name="CurrentAgeBgLeft"
                                                    Canvas.Left="{Binding ElementName=CurrentAgeBgLeftOffset, Path=Width, Converter={StaticResource MultiplyOperator}, ConverterParameter=-1}"
                                                    Width="0">
                                                <Image Canvas.Right="0"
                                                       Height="7"
                                                       HorizontalAlignment="Right"
                                                       Source="/WPFGUI;component/icons/HUD/age/age_display_persistent_bg_left.png" />
                                            </Canvas>

                                            <Canvas Name="CurrentAgeBgRight"
                                                    Canvas.Right="{Binding ElementName=CurrentAgeBgRightOffset, Path=Width, Converter={StaticResource MultiplyOperator}, ConverterParameter=-1}"
                                                    Width="0">
                                                <Image Canvas.Left="0"
                                                       Height="7"
                                                       RenderTransformOrigin="0,0" Source="/WPFGUI;component/icons/HUD/age/age_display_persistent_bg_right.png" />
                                            </Canvas>
                                        </Canvas>

                                        <!--  current age icon  -->
                                        <Image Name="CurrentAgeIcon"
                                               Height="40"
                                               HorizontalAlignment="Center"
                                               Source="{Binding LocalPlayer.CurrentAge.UIInfo.Icon}" />

                                        <!--  glowing current age icon  -->
                                        <Image Name="GlowingCurrentAgeIcon"
                                               Height="40"
                                               HorizontalAlignment="Center"
                                               Opacity="0">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Source" Value="{x:Null}" />

                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding LocalPlayer.CurrentAgeNumber}" Value="1">
                                                            <Setter Property="Source" Value="/WPFGUI;component/icons/HUD/age/age_display_afford_1.png" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding LocalPlayer.CurrentAgeNumber}" Value="2">
                                                            <Setter Property="Source" Value="/WPFGUI;component/icons/HUD/age/age_display_afford_2.png" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding LocalPlayer.CurrentAgeNumber}" Value="3">
                                                            <Setter Property="Source" Value="/WPFGUI;component/icons/HUD/age/age_display_afford_3.png" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding LocalPlayer.CurrentAgeNumber}" Value="4">
                                                            <Setter Property="Source" Value="/WPFGUI;component/icons/HUD/age/age_display_afford_4.png" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>

                                        <!--  can afford next age circle glow  -->
                                        <Image Name="CanAffordNextAgeCircleGlow"
                                               Height="92"
                                               Opacity="0" RenderTransformOrigin="0.5,0.5"
                                               Source="/WPFGUI;component/icons/HUD/age/age_display_afford_circle_glow.png">
                                            <Image.RenderTransform>
                                                <RotateTransform x:Name="CanAffordNextAgeCircleGlowRotation" Angle="0" />
                                            </Image.RenderTransform>
                                        </Image>

                                        <!--  can afford next age circle  -->
                                        <Image Name="CanAffordNextAgeCircle"
                                               Height="92"
                                               Opacity="0" RenderTransformOrigin="0.5,0.5"
                                               Source="/WPFGUI;component/icons/HUD/age/age_display_afford_circle.png">
                                            <Image.RenderTransform>
                                                <RotateTransform x:Name="CanAffordNextAgeCircleRotation" Angle="0" />
                                            </Image.RenderTransform>
                                        </Image>

                                        <Decorator Name="IsAllowedToBuildNextAge">
                                            <Decorator.IsEnabled>
                                                <MultiBinding Converter="{StaticResource MultiGreaterCompare}">
                                                    <Binding Path="LocalPlayer.CurrentAgeNumber" />
                                                    <Binding Converter="{StaticResource CastToIntOperator}" Path="LocalPlayer.StateModel.Int[player_max_age]">
                                                        <Binding.FallbackValue>
                                                            <sys:Int32>1</sys:Int32>
                                                        </Binding.FallbackValue>
                                                    </Binding>
                                                </MultiBinding>
                                            </Decorator.IsEnabled>
                                        </Decorator>

                                        <Decorator Name="CanAffordAndIsAllowedToBuildNextAge">
                                            <Decorator.IsEnabled>
                                                <MultiBinding Converter="{StaticResource MultiLogicalAnd}">
                                                    <Binding FallbackValue="False" Path="LocalPlayer.NextAge.CanAfford" />
                                                    <Binding ElementName="IsAllowedToBuildNextAge" Path="IsEnabled" />
                                                </MultiBinding>
                                            </Decorator.IsEnabled>
                                        </Decorator>

                                        <Decorator Name="IsPlayingAgeUpAnim" IsEnabled="False" />

                                        <Decorator Name="CurrentAgeDummyProxyToTriggerAgeUpAnim" Width="{Binding LocalPlayer.CurrentAgeNumber, NotifyOnTargetUpdated=True, Converter={StaticResource CastOperator}}" />

                                        <!--
                                            Wait untill the game is really started to start the CanAffordNextAgeAnim animation.
                                            This is because if you start a game with enough resources to build a landmark right away, the animation doesn't play.
                                        -->
                                        <Decorator Name="IsReady">
                                            <Decorator.IsEnabled>
                                                <MultiBinding Converter="{StaticResource MultiGreaterCompare}" ConverterParameter="0.9">
                                                    <Binding Converter="{StaticResource CastToSingleOperator}" Path="ElapsedTime" />
                                                </MultiBinding>
                                            </Decorator.IsEnabled>
                                        </Decorator>
                                    </Grid>

                                    <ControlTemplate.Triggers>
                                        <!--  We are able to afford to build a landmark to age up and are allowed to do so.  -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding ElementName=IsReady, Path=IsEnabled}" Value="True" />
                                                <Condition Binding="{Binding ElementName=CanAffordAndIsAllowedToBuildNextAge, Path=IsEnabled}" Value="True" />
                                                <Condition Binding="{Binding Converter={StaticResource NullConverter}, Path=LocalPlayer.AgeUpProvider}" Value="True" />
                                                <Condition Binding="{Binding ElementName=IsPlayingAgeUpAnim, Path=IsEnabled}" Value="False" />
                                            </MultiDataTrigger.Conditions>

                                            <MultiDataTrigger.EnterActions>
                                                <esUtility:WiseEventPostAction Event="sfx_ui_age_up_ready_play" />

                                                <StopStoryboard BeginStoryboardName="BuildingLandmarkAnim" />
                                                <StopStoryboard BeginStoryboardName="AgeUpAnim" />

                                                <BeginStoryboard Name="CanAffordNextAgeAnim">
                                                    <Storyboard>
                                                        <!--  show current age icon  -->
                                                        <DoubleAnimationUsingKeyFrames BeginTime="0:0:0"
                                                                                       Storyboard.TargetName="CurrentAgeIcon" Storyboard.TargetProperty="(UIElement.Opacity)">
                                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                                        </DoubleAnimationUsingKeyFrames>
                                                        <!--  hide last age icon  -->
                                                        <DoubleAnimationUsingKeyFrames BeginTime="0:0:0"
                                                                                       Storyboard.TargetName="LastAgeIcon" Storyboard.TargetProperty="(UIElement.Opacity)">
                                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                                        </DoubleAnimationUsingKeyFrames>
                                                        <!--  hide glowing last age icon  -->
                                                        <DoubleAnimationUsingKeyFrames BeginTime="0:0:0"
                                                                                       Storyboard.TargetName="GlowingLastAgeIcon" Storyboard.TargetProperty="(UIElement.Opacity)">
                                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                                        </DoubleAnimationUsingKeyFrames>

                                                        <!--  left line moves out  -->
                                                        <DoubleAnimationUsingKeyFrames BeginTime="0:0:0"
                                                                                       Storyboard.TargetName="CurrentAgeBgLeftOffset" Storyboard.TargetProperty="(FrameworkElement.Width)">
                                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                                            <LinearDoubleKeyFrame KeyTime="0:0:0.224" Value="16" />
                                                        </DoubleAnimationUsingKeyFrames>
                                                        <!--  right line moves out  -->
                                                        <DoubleAnimationUsingKeyFrames BeginTime="0:0:0"
                                                                                       Storyboard.TargetName="CurrentAgeBgRightOffset" Storyboard.TargetProperty="(FrameworkElement.Width)">
                                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                                            <LinearDoubleKeyFrame KeyTime="0:0:0.224" Value="16" />
                                                        </DoubleAnimationUsingKeyFrames>

                                                        <!--  left line fades out  -->
                                                        <DoubleAnimationUsingKeyFrames BeginTime="0:0:0"
                                                                                       Storyboard.TargetName="CurrentAgeBgLeft" Storyboard.TargetProperty="(UIElement.Opacity)">
                                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.032" Value="1" />
                                                            <LinearDoubleKeyFrame KeyTime="0:0:0.224" Value="0" />
                                                        </DoubleAnimationUsingKeyFrames>
                                                        <!--  right line fades out  -->
                                                        <DoubleAnimationUsingKeyFrames BeginTime="0:0:0"
                                                                                       Storyboard.TargetName="CurrentAgeBgRight" Storyboard.TargetProperty="(UIElement.Opacity)">
                                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.032" Value="1" />
                                                            <LinearDoubleKeyFrame KeyTime="0:0:0.224" Value="0" />
                                                        </DoubleAnimationUsingKeyFrames>

                                                        <!--  can afford next age circle fades in  -->
                                                        <DoubleAnimationUsingKeyFrames BeginTime="0:0:0"
                                                                                       Storyboard.TargetName="CanAffordNextAgeCircle" Storyboard.TargetProperty="(UIElement.Opacity)">
                                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.032" Value="0" />
                                                            <LinearDoubleKeyFrame KeyTime="0:0:0.256" Value="1" />
                                                        </DoubleAnimationUsingKeyFrames>
                                                        <!--  can afford next age circle glow fades in, then out  -->
                                                        <DoubleAnimationUsingKeyFrames BeginTime="0:0:0"
                                                                                       Storyboard.TargetName="CanAffordNextAgeCircleGlow" Storyboard.TargetProperty="(UIElement.Opacity)">
                                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.096" Value="0" />
                                                            <LinearDoubleKeyFrame KeyTime="0:0:0.384" Value="1" />
                                                            <DiscreteDoubleKeyFrame KeyTime="0:0:1.120" Value="1" />
                                                            <EasingDoubleKeyFrame KeyTime="0:0:3.008" Value="0">
                                                                <EasingDoubleKeyFrame.EasingFunction>
                                                                    <QuadraticEase EasingMode="EaseInOut" />
                                                                </EasingDoubleKeyFrame.EasingFunction>
                                                            </EasingDoubleKeyFrame>
                                                        </DoubleAnimationUsingKeyFrames>

                                                        <!--  can afford next age circle rotates twice, then stops  -->
                                                        <DoubleAnimationUsingKeyFrames BeginTime="0:0:0"
                                                                                       Storyboard.TargetName="CanAffordNextAgeCircleRotation" Storyboard.TargetProperty="(RotateTransform.Angle)">
                                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                                            <LinearDoubleKeyFrame KeyTime="0:0:1.120" Value="540" />
                                                            <EasingDoubleKeyFrame KeyTime="0:0:3.008" Value="720">
                                                                <EasingDoubleKeyFrame.EasingFunction>
                                                                    <QuadraticEase EasingMode="EaseOut" />
                                                                </EasingDoubleKeyFrame.EasingFunction>
                                                            </EasingDoubleKeyFrame>
                                                        </DoubleAnimationUsingKeyFrames>
                                                        <!--  can afford next age circle glow rotates twice, then stops  -->
                                                        <DoubleAnimationUsingKeyFrames BeginTime="0:0:0"
                                                                                       Storyboard.TargetName="CanAffordNextAgeCircleGlowRotation" Storyboard.TargetProperty="(RotateTransform.Angle)">
                                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.032" Value="0" />
                                                            <LinearDoubleKeyFrame KeyTime="0:0:1.120" Value="540" />
                                                            <EasingDoubleKeyFrame KeyTime="0:0:3.008" Value="720">
                                                                <EasingDoubleKeyFrame.EasingFunction>
                                                                    <QuadraticEase EasingMode="EaseOut" />
                                                                </EasingDoubleKeyFrame.EasingFunction>
                                                            </EasingDoubleKeyFrame>
                                                        </DoubleAnimationUsingKeyFrames>

                                                        <!--  glowing current age icon fades in, then fades out to 50%  -->
                                                        <DoubleAnimationUsingKeyFrames BeginTime="0:0:0"
                                                                                       Storyboard.TargetName="GlowingCurrentAgeIcon" Storyboard.TargetProperty="(UIElement.Opacity)">
                                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.096" Value="0" />
                                                            <EasingDoubleKeyFrame KeyTime="0:0:0.448" Value="1">
                                                                <EasingDoubleKeyFrame.EasingFunction>
                                                                    <QuadraticEase EasingMode="EaseInOut" />
                                                                </EasingDoubleKeyFrame.EasingFunction>
                                                            </EasingDoubleKeyFrame>
                                                            <DiscreteDoubleKeyFrame KeyTime="0:0:1.120" Value="1" />
                                                            <EasingDoubleKeyFrame KeyTime="0:0:3.008" Value="0.5">
                                                                <EasingDoubleKeyFrame.EasingFunction>
                                                                    <QuadraticEase EasingMode="EaseInOut" />
                                                                </EasingDoubleKeyFrame.EasingFunction>
                                                            </EasingDoubleKeyFrame>
                                                        </DoubleAnimationUsingKeyFrames>

                                                        <!--  can afford next age circle glow pulses forever  -->
                                                        <DoubleAnimationUsingKeyFrames BeginTime="0:0:3.009" RepeatBehavior="Forever"
                                                                                       Storyboard.TargetName="CanAffordNextAgeCircleGlow" Storyboard.TargetProperty="(UIElement.Opacity)">
                                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                                            <EasingDoubleKeyFrame KeyTime="0:0:1.472" Value="1">
                                                                <EasingDoubleKeyFrame.EasingFunction>
                                                                    <SineEase EasingMode="EaseInOut" />
                                                                </EasingDoubleKeyFrame.EasingFunction>
                                                            </EasingDoubleKeyFrame>
                                                            <EasingDoubleKeyFrame KeyTime="0:0:2.944" Value="0">
                                                                <EasingDoubleKeyFrame.EasingFunction>
                                                                    <SineEase EasingMode="EaseInOut" />
                                                                </EasingDoubleKeyFrame.EasingFunction>
                                                            </EasingDoubleKeyFrame>
                                                        </DoubleAnimationUsingKeyFrames>

                                                        <!--  glowing current age icon pulses forever  -->
                                                        <DoubleAnimationUsingKeyFrames BeginTime="0:0:3.009" RepeatBehavior="Forever"
                                                                                       Storyboard.TargetName="GlowingCurrentAgeIcon" Storyboard.TargetProperty="(UIElement.Opacity)">
                                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.5" />
                                                            <EasingDoubleKeyFrame KeyTime="0:0:1.472" Value="1">
                                                                <EasingDoubleKeyFrame.EasingFunction>
                                                                    <SineEase EasingMode="EaseInOut" />
                                                                </EasingDoubleKeyFrame.EasingFunction>
                                                            </EasingDoubleKeyFrame>
                                                            <EasingDoubleKeyFrame KeyTime="0:0:2.944" Value="0.5">
                                                                <EasingDoubleKeyFrame.EasingFunction>
                                                                    <SineEase EasingMode="EaseInOut" />
                                                                </EasingDoubleKeyFrame.EasingFunction>
                                                            </EasingDoubleKeyFrame>
                                                        </DoubleAnimationUsingKeyFrames>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </MultiDataTrigger.EnterActions>
                                        </MultiDataTrigger>

                                        <!--  We are no longer able to afford to build a landmark to age up or are allowed to do so.  -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding ElementName=IsReady, Path=IsEnabled}" Value="True" />
                                                <Condition Binding="{Binding ElementName=CanAffordAndIsAllowedToBuildNextAge, Path=IsEnabled}" Value="False" />
                                                <Condition Binding="{Binding Converter={StaticResource NullConverter}, Path=LocalPlayer.AgeUpProvider}" Value="True" />
                                                <Condition Binding="{Binding ElementName=IsPlayingAgeUpAnim, Path=IsEnabled}" Value="False" />
                                            </MultiDataTrigger.Conditions>

                                            <MultiDataTrigger.EnterActions>
                                                <StopStoryboard BeginStoryboardName="CanAffordNextAgeAnim" />
                                                <StopStoryboard BeginStoryboardName="BuildingLandmarkAnim" />

                                                <BeginStoryboard Name="CannotAffordNextAgeAnim">
                                                    <Storyboard>
                                                        <!--  show current age icon  -->
                                                        <DoubleAnimationUsingKeyFrames BeginTime="0:0:0"
                                                                                       Storyboard.TargetName="CurrentAgeIcon" Storyboard.TargetProperty="(UIElement.Opacity)">
                                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                                        </DoubleAnimationUsingKeyFrames>
                                                        <!--  hide last age icon  -->
                                                        <DoubleAnimationUsingKeyFrames BeginTime="0:0:0"
                                                                                       Storyboard.TargetName="LastAgeIcon" Storyboard.TargetProperty="(UIElement.Opacity)">
                                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                                        </DoubleAnimationUsingKeyFrames>
                                                        <!--  hide glowing last age icon  -->
                                                        <DoubleAnimationUsingKeyFrames BeginTime="0:0:0"
                                                                                       Storyboard.TargetName="GlowingLastAgeIcon" Storyboard.TargetProperty="(UIElement.Opacity)">
                                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                                        </DoubleAnimationUsingKeyFrames>

                                                        <!--  can afford next age circle fades out  -->
                                                        <DoubleAnimation BeginTime="0:0:0"
                                                                         Storyboard.TargetName="CanAffordNextAgeCircle" Storyboard.TargetProperty="(UIElement.Opacity)"
                                                                         To="0" Duration="0:0:0.3" />
                                                        <!--  can afford next age circle glow fades out  -->
                                                        <DoubleAnimation BeginTime="0:0:0"
                                                                         Storyboard.TargetName="CanAffordNextAgeCircleGlow" Storyboard.TargetProperty="(UIElement.Opacity)"
                                                                         To="0" Duration="0:0:0.3" />

                                                        <!--  can afford next age circle (maybe) rotates a bit more while fading out  -->
                                                        <DoubleAnimation BeginTime="0:0:0"
                                                                         Storyboard.TargetName="CanAffordNextAgeCircleRotation" Storyboard.TargetProperty="(RotateTransform.Angle)"
                                                                         To="720" Duration="0:0:0.3">
                                                            <DoubleAnimation.EasingFunction>
                                                                <QuadraticEase EasingMode="EaseOut" />
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <!--  can afford next age circle glow (maybe) rotates a bit more while fading out  -->
                                                        <DoubleAnimation BeginTime="0:0:0"
                                                                         Storyboard.TargetName="CanAffordNextAgeCircleGlowRotation" Storyboard.TargetProperty="(RotateTransform.Angle)"
                                                                         To="720" Duration="0:0:0.3">
                                                            <DoubleAnimation.EasingFunction>
                                                                <QuadraticEase EasingMode="EaseOut" />
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>

                                                        <!--  glowing current age icon fades out  -->
                                                        <DoubleAnimation BeginTime="0:0:0"
                                                                         Storyboard.TargetName="GlowingCurrentAgeIcon" Storyboard.TargetProperty="(UIElement.Opacity)"
                                                                         To="0" Duration="0:0:0.3" />

                                                        <!--  left line moves back in  -->
                                                        <DoubleAnimation BeginTime="0:0:0.2"
                                                                         Storyboard.TargetName="CurrentAgeBgLeftOffset" Storyboard.TargetProperty="(FrameworkElement.Width)"
                                                                         To="0" Duration="0:0:0.224" />
                                                        <!--  right line moves back in  -->
                                                        <DoubleAnimation BeginTime="0:0:0.2"
                                                                         Storyboard.TargetName="CurrentAgeBgRightOffset" Storyboard.TargetProperty="(FrameworkElement.Width)"
                                                                         To="0" Duration="0:0:0.224" />

                                                        <!--  left line fades in  -->
                                                        <DoubleAnimation BeginTime="0:0:0.2"
                                                                         Storyboard.TargetName="CurrentAgeBgLeft" Storyboard.TargetProperty="(UIElement.Opacity)"
                                                                         To="1" Duration="0:0:0.224" />
                                                        <!--  right line fades in  -->
                                                        <DoubleAnimation BeginTime="0:0:0.2"
                                                                         Storyboard.TargetName="CurrentAgeBgRight" Storyboard.TargetProperty="(UIElement.Opacity)"
                                                                         To="1" Duration="0:0:0.224" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </MultiDataTrigger.EnterActions>
                                        </MultiDataTrigger>

                                        <DataTrigger Binding="{Binding Converter={StaticResource NullConverter}, Path=LocalPlayer.AgeUpProvider}" Value="False">
                                            <DataTrigger.EnterActions>
                                                <StopStoryboard BeginStoryboardName="CanAffordNextAgeAnim" />
                                                <StopStoryboard BeginStoryboardName="CannotAffordNextAgeAnim" />

                                                <BeginStoryboard Name="BuildingLandmarkAnim">
                                                    <Storyboard>
                                                        <!--  show current age icon  -->
                                                        <DoubleAnimationUsingKeyFrames BeginTime="0:0:0"
                                                                                       Storyboard.TargetName="CurrentAgeIcon" Storyboard.TargetProperty="(UIElement.Opacity)">
                                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                                        </DoubleAnimationUsingKeyFrames>
                                                        <!--  hide last age icon  -->
                                                        <DoubleAnimationUsingKeyFrames BeginTime="0:0:0"
                                                                                       Storyboard.TargetName="LastAgeIcon" Storyboard.TargetProperty="(UIElement.Opacity)">
                                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                                        </DoubleAnimationUsingKeyFrames>
                                                        <!--  hide glowing last age icon  -->
                                                        <DoubleAnimationUsingKeyFrames BeginTime="0:0:0"
                                                                                       Storyboard.TargetName="GlowingLastAgeIcon" Storyboard.TargetProperty="(UIElement.Opacity)">
                                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                                        </DoubleAnimationUsingKeyFrames>

                                                        <!--  can afford next age circle fades out  -->
                                                        <DoubleAnimation BeginTime="0:0:0"
                                                                         Storyboard.TargetName="CanAffordNextAgeCircle" Storyboard.TargetProperty="(UIElement.Opacity)"
                                                                         To="0" Duration="0:0:0.3" />
                                                        <!--  can afford next age circle glow fades out  -->
                                                        <DoubleAnimation BeginTime="0:0:0"
                                                                         Storyboard.TargetName="CanAffordNextAgeCircleGlow" Storyboard.TargetProperty="(UIElement.Opacity)"
                                                                         To="0" Duration="0:0:0.3" />

                                                        <!--  can afford next age circle (maybe) rotates a bit more while fading out  -->
                                                        <DoubleAnimation BeginTime="0:0:0"
                                                                         Storyboard.TargetName="CanAffordNextAgeCircleRotation" Storyboard.TargetProperty="(RotateTransform.Angle)"
                                                                         To="720" Duration="0:0:0.3">
                                                            <DoubleAnimation.EasingFunction>
                                                                <QuadraticEase EasingMode="EaseOut" />
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <!--  can afford next age circle glow (maybe) rotates a bit more while fading out  -->
                                                        <DoubleAnimation BeginTime="0:0:0"
                                                                         Storyboard.TargetName="CanAffordNextAgeCircleGlowRotation" Storyboard.TargetProperty="(RotateTransform.Angle)"
                                                                         To="720" Duration="0:0:0.3">
                                                            <DoubleAnimation.EasingFunction>
                                                                <QuadraticEase EasingMode="EaseOut" />
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>

                                                        <!--  glowing current age icon fades in to 50%  -->
                                                        <DoubleAnimation BeginTime="0:0:0"
                                                                         Storyboard.TargetName="GlowingCurrentAgeIcon" Storyboard.TargetProperty="(UIElement.Opacity)"
                                                                         To="1" Duration="0:0:0.3" />

                                                        <!--  left line moves back in  -->
                                                        <DoubleAnimation BeginTime="0:0:0.2"
                                                                         Storyboard.TargetName="CurrentAgeBgLeftOffset" Storyboard.TargetProperty="(FrameworkElement.Width)"
                                                                         To="0" Duration="0:0:0.224" />
                                                        <!--  right line moves back in  -->
                                                        <DoubleAnimation BeginTime="0:0:0.2"
                                                                         Storyboard.TargetName="CurrentAgeBgRightOffset" Storyboard.TargetProperty="(FrameworkElement.Width)"
                                                                         To="0" Duration="0:0:0.224" />

                                                        <!--  left line fades in  -->
                                                        <DoubleAnimation BeginTime="0:0:0.2"
                                                                         Storyboard.TargetName="CurrentAgeBgLeft" Storyboard.TargetProperty="(UIElement.Opacity)"
                                                                         To="1" Duration="0:0:0.224" />
                                                        <!--  right line fades in  -->
                                                        <DoubleAnimation BeginTime="0:0:0.2"
                                                                         Storyboard.TargetName="CurrentAgeBgRight" Storyboard.TargetProperty="(UIElement.Opacity)"
                                                                         To="1" Duration="0:0:0.224" />

                                                        <!--  glowing current age icon pulses forever  -->
                                                        <DoubleAnimationUsingKeyFrames BeginTime="0:0:0.3" RepeatBehavior="Forever"
                                                                                       Storyboard.TargetName="GlowingCurrentAgeIcon" Storyboard.TargetProperty="(UIElement.Opacity)">
                                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.5" />
                                                            <EasingDoubleKeyFrame KeyTime="0:0:1.472" Value="1">
                                                                <EasingDoubleKeyFrame.EasingFunction>
                                                                    <SineEase EasingMode="EaseInOut" />
                                                                </EasingDoubleKeyFrame.EasingFunction>
                                                            </EasingDoubleKeyFrame>
                                                            <EasingDoubleKeyFrame KeyTime="0:0:2.944" Value="0.5">
                                                                <EasingDoubleKeyFrame.EasingFunction>
                                                                    <SineEase EasingMode="EaseInOut" />
                                                                </EasingDoubleKeyFrame.EasingFunction>
                                                            </EasingDoubleKeyFrame>
                                                        </DoubleAnimationUsingKeyFrames>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                        </DataTrigger>

                                        <!--  Age Up animation  -->
                                        <EventTrigger RoutedEvent="Binding.TargetUpdated" SourceName="CurrentAgeDummyProxyToTriggerAgeUpAnim">
                                            <StopStoryboard BeginStoryboardName="BuildingLandmarkAnim" />

                                            <BeginStoryboard Name="AgeUpAnim">
                                                <Storyboard>
                                                    <!--  This animation is now playing  -->
                                                    <BooleanAnimationUsingKeyFrames BeginTime="0:0:0"
                                                                                    Storyboard.TargetName="IsPlayingAgeUpAnim" Storyboard.TargetProperty="(UIElement.IsEnabled)">
                                                        <DiscreteBooleanKeyFrame KeyTime="0:0:0" Value="True" />
                                                        <DiscreteBooleanKeyFrame KeyTime="0:0:0.8" Value="False" />
                                                    </BooleanAnimationUsingKeyFrames>

                                                    <!--  can afford next age circle fades out  -->
                                                    <DoubleAnimation BeginTime="0:0:0"
                                                                     Storyboard.TargetName="CanAffordNextAgeCircle" Storyboard.TargetProperty="(UIElement.Opacity)"
                                                                     To="0" Duration="0:0:0.2" />
                                                    <!--  can afford next age circle glow fades out  -->
                                                    <DoubleAnimation BeginTime="0:0:0"
                                                                     Storyboard.TargetName="CanAffordNextAgeCircleGlow" Storyboard.TargetProperty="(UIElement.Opacity)"
                                                                     To="0" Duration="0:0:0.2" />

                                                    <!--  left line moves back in  -->
                                                    <DoubleAnimation BeginTime="0:0:0.2"
                                                                     Storyboard.TargetName="CurrentAgeBgLeftOffset" Storyboard.TargetProperty="(FrameworkElement.Width)"
                                                                     To="0" Duration="0:0:0.224" />
                                                    <!--  right line moves back in  -->
                                                    <DoubleAnimation BeginTime="0:0:0.2"
                                                                     Storyboard.TargetName="CurrentAgeBgRightOffset" Storyboard.TargetProperty="(FrameworkElement.Width)"
                                                                     To="0" Duration="0:0:0.224" />

                                                    <!--  left line fades in  -->
                                                    <DoubleAnimation BeginTime="0:0:0.2"
                                                                     Storyboard.TargetName="CurrentAgeBgLeft" Storyboard.TargetProperty="(UIElement.Opacity)"
                                                                     To="1" Duration="0:0:0.224" />
                                                    <!--  right line fades in  -->
                                                    <DoubleAnimation BeginTime="0:0:0.2"
                                                                     Storyboard.TargetName="CurrentAgeBgRight" Storyboard.TargetProperty="(UIElement.Opacity)"
                                                                     To="1" Duration="0:0:0.224" />

                                                    <!--  show last age icon, then fade out  -->
                                                    <DoubleAnimationUsingKeyFrames BeginTime="0:0:0"
                                                                                   Storyboard.TargetName="LastAgeIcon" Storyboard.TargetProperty="(UIElement.Opacity)">
                                                        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                                        <LinearDoubleKeyFrame KeyTime="0:0:0.25" Value="0" />
                                                    </DoubleAnimationUsingKeyFrames>
                                                    <!--  show glowing last age icon, then fade out  -->
                                                    <DoubleAnimationUsingKeyFrames BeginTime="0:0:0"
                                                                                   Storyboard.TargetName="GlowingLastAgeIcon" Storyboard.TargetProperty="(UIElement.Opacity)">
                                                        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                                        <LinearDoubleKeyFrame KeyTime="0:0:0.25" Value="0" />
                                                    </DoubleAnimationUsingKeyFrames>

                                                    <!--  current age icon fades in  -->
                                                    <DoubleAnimationUsingKeyFrames BeginTime="0:0:0"
                                                                                   Storyboard.TargetName="CurrentAgeIcon" Storyboard.TargetProperty="(UIElement.Opacity)">
                                                        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                                        <DiscreteDoubleKeyFrame KeyTime="0:0:0.2" Value="0" />
                                                        <LinearDoubleKeyFrame KeyTime="0:0:0.4" Value="1" />
                                                    </DoubleAnimationUsingKeyFrames>
                                                    <!--  glowing current age icon fades in, then fades out  -->
                                                    <DoubleAnimationUsingKeyFrames BeginTime="0:0:0"
                                                                                   Storyboard.TargetName="GlowingCurrentAgeIcon" Storyboard.TargetProperty="(UIElement.Opacity)">
                                                        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                                        <DiscreteDoubleKeyFrame KeyTime="0:0:0.2" Value="0" />
                                                        <LinearDoubleKeyFrame KeyTime="0:0:0.4" Value="1" />
                                                        <LinearDoubleKeyFrame KeyTime="0:0:0.5" Value="1" />
                                                        <EasingDoubleKeyFrame KeyTime="0:0:0.8" Value="0">
                                                            <EasingDoubleKeyFrame.EasingFunction>
                                                                <QuadraticEase EasingMode="EaseOut" />
                                                            </EasingDoubleKeyFrame.EasingFunction>
                                                        </EasingDoubleKeyFrame>
                                                    </DoubleAnimationUsingKeyFrames>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Control.Template>
                        </Control>

                        <!--  this appears when there is a landmark  -->
                        <Border x:Name="LandmarkInConstruction"
                                Grid.Row="1"
                                Margin="{StaticResource ExtraSmallMarginTop}"
                                HorizontalAlignment="Center"
                                Background="{DynamicResource TranslucentBackgroundOverlayBrush}"
                                DataContext="{Binding LocalPlayer.AgeUpProvider}"
                                ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="86400000">
                            <Border.Visibility>
                                <MultiBinding Converter="{StaticResource MultiLogicalAnd}">
                                    <Binding Converter="{StaticResource NotNullConverter}" />
                                    <Binding Path="SettingValueLookup[LandmarkConstructionProgressVisibilityMode]" Source="{x:Static sysConfigModels:SystemConfigModel.Instance}" />
                                </MultiBinding>
                            </Border.Visibility>
                            <Border.ToolTip>
                                <ToolTip MinWidth="375"
                                         DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                         Placement="Mouse">
                                    <ToolTip.Template>
                                        <ControlTemplate TargetType="ToolTip">
                                            <!--
                                                Primary tooltip.
                                                This is based from the one in IssuableToolTip with unnecessary code removed
                                                and the binding paths fixed (Removed Properties. in front of them).
                                            -->
                                            <ContentControl Grid.Row="1"
                                                            IsTabStop="False"
                                                            Style="{StaticResource HUDTooltipBorderStyle}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="{StaticResource HUDTooltipGutterWidthGridLength}" />
                                                        <ColumnDefinition Width="*" MaxWidth="{StaticResource HUDTooltipContentColumnMaxWidth}" />
                                                        <ColumnDefinition Width="{StaticResource HUDTooltipGutterWidthGridLength}" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!--  command card icon  -->
                                                    <ContentPresenter Grid.Column="0"
                                                                      Width="{StaticResource HUDTooltipIconSize}"
                                                                      Height="{StaticResource HUDTooltipIconSize}"
                                                                      VerticalAlignment="Top"
                                                                      Content="{Binding}"
                                                                      ContentTemplateSelector="{StaticResource StyledButtonTemplateSelector}">
                                                        <ContentPresenter.Resources>
                                                            <DataTemplate x:Key="IssuablePresenter">
                                                                <Grid>
                                                                    <Rectangle Name="Bg"
                                                                               Fill="{DynamicResource ButtonBgBrush}"
                                                                               RadiusX="{StaticResource HUDButtonRadiusX}"
                                                                               RadiusY="{StaticResource HUDButtonRadiusY}"
                                                                               Visibility="Visible" />
                                                                    <Image Name="IconImage"
                                                                           Source="{Binding UIInfo.Icon}"
                                                                           Style="{StaticResource ButtonIconStyle}" />
                                                                    <TextBlock Style="{StaticResource HUDButtonDebugTextBlockStyle}" Text="{Binding UIInfo.Debug}" />

                                                                    <Image HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                                           Style="{StaticResource UniqueToCivIconForIssuableIcon}">
                                                                        <Image.Visibility>
                                                                            <MultiBinding Converter="{StaticResource MultiLogicalOr}">
                                                                                <Binding Path="Properties.UIInfo.IsUniqueToRace" />
                                                                                <Binding Converter="{StaticResource IsEqualConverter}"
                                                                                         ConverterParameter="UniqueBuildingUpgradeDataTemplate" Path="TooltipDataTemplate" />
                                                                            </MultiBinding>
                                                                        </Image.Visibility>
                                                                    </Image>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ContentPresenter.Resources>
                                                    </ContentPresenter>

                                                    <StackPanel Grid.Column="2"
                                                                MaxWidth="{StaticResource HUDTooltipContentColumnMaxWidth}"
                                                                Orientation="Vertical">
                                                        <!--  title text  -->
                                                        <esControls:Marquee MarqueeType="ScrollToLeft" Speed="60">
                                                            <TextBlock Style="{StaticResource nHUDTitleTextBlockStyle}" Text="{Binding UIInfo.Name}" />
                                                        </esControls:Marquee>

                                                        <!--  label  -->
                                                        <esControls:Marquee MarqueeType="ScrollToLeft" Speed="60">
                                                            <ContentPresenter Content="{Binding}" ContentTemplateSelector="{StaticResource StyledButtonTemplateSelector}">
                                                                <ContentPresenter.Resources>
                                                                    <DataTemplate x:Key="IssuablePresenter" DataType="{x:Type model:CardinalEntityModel}">
                                                                        <StackPanel>
                                                                            <Grid HorizontalAlignment="Left" Visibility="{Binding UIInfo.Extra, Converter={StaticResource NotNullOrEmptyStringToVis}}">
                                                                                <TextBlock Style="{StaticResource nHUDSubtitleTextBlockStyle}" Text="{Binding UIInfo.Extra}" />
                                                                            </Grid>
                                                                            <Border HorizontalAlignment="Left" Visibility="{Binding UIInfo.Extra, Converter={StaticResource NullOrEmptyStringToVis}}">
                                                                                <TextBlock DataContext="{Binding}" Style="{StaticResource nHUDSubtitleTextBlockStyle}" />
                                                                            </Border>
                                                                        </StackPanel>
                                                                    </DataTemplate>
                                                                </ContentPresenter.Resources>
                                                            </ContentPresenter>
                                                        </esControls:Marquee>

                                                        <!--  description  -->
                                                        <TextBlock Margin="{StaticResource SmallMarginTop}"
                                                                   Style="{StaticResource nHUDBodyTextBlockStyle}"
                                                                   Text="{Binding UIInfo.Help}"
                                                                   TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />

                                                        <!--  Time remaining  -->
                                                        <TextBlock Margin="0,24,0,0" Style="{StaticResource nHUDBodyTextBlockStyle}">
                                                            <TextBlock.Text>
                                                                <MultiBinding Converter="{StaticResource LocalizedStringMultiConverter}" ConverterParameter="$11182826">
                                                                    <Binding Converter="{StaticResource TimeFormat}" Path="TimeLeft" />
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Grid>
                                            </ContentControl>
                                        </ControlTemplate>
                                    </ToolTip.Template>
                                </ToolTip>
                            </Border.ToolTip>

                            <StackPanel Margin="2,0,10,0" Orientation="Horizontal">
                                <Border Margin="0,4,8,4" Background="{DynamicResource TertiaryColorLightBrush}">
                                    <Image x:Name="AgeUpIcon"
                                           Width="Auto" Height="34"
                                           Source="{Binding UIInfo.Icon}" />

                                    <Border.Style>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="BorderBrush" Value="{x:Null}" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding UIInfo.TooltipDataTemplate}" Value="templar_age_up">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryColorGradientReflectedBrush}" />
                                                    <Setter Property="BorderThickness" Value="2" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>

                                <ProgressBar Width="115" Height="10"
                                             VerticalAlignment="Center"
                                             Template="{StaticResource ConstructionProgressBar}"
                                             Value="{Binding Progress, Mode=OneWay}" />

                                <Grid Height="36" Visibility="{Binding CanHaveWorkers, Converter={StaticResource BoolToVis}}">
                                    <Image Width="20"
                                           Margin="2,-12,0,0" HorizontalAlignment="Left"
                                           Source="/WPFGUI;component/icons/resources/resource_villager.png" Stretch="Uniform" />
                                    <TextBlock Margin="18,6,0,0"
                                               Style="{StaticResource nHUDBaseTextBlockStyle}"
                                               Text="{Binding NumWorkers, Converter={StaticResource LocalizedStringConverter}, ConverterParameter=$11182459}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!--  Game timer  -->
                        <Grid Grid.Row="2"
                              Margin="{StaticResource SmallMarginTop}"
                              HorizontalAlignment="Center" VerticalAlignment="Top"
                              Visibility="{Binding SettingValueLookup[ShowGameTimer], Source={x:Static sysConfigModels:SystemConfigModel.Instance}, Converter={StaticResource BoolToVisDesignModeOn}}">

                            <Rectangle Fill="Black" Opacity="0.6" />

                            <TextBlock Margin="{StaticResource ExtraSmallMarginAll}"
                                       Style="{StaticResource nHUDBaseTextBlockStyle}"
                                       Text="{Binding ElapsedTime, Converter={StaticResource ShorthandTimeFormat}}" />
                        </Grid>
                    </Grid>

                    <ContentControl Margin="0,230,0,0" HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    Content="{Binding EventCueTitle}"
                                    IsHitTestVisible="False" IsTabStop="False">
                        <ContentControl.Resources>
                            <sys:Double x:Key="EventCueMinHeight">39</sys:Double>
                            <sys:Double x:Key="EventCueMinWidth">400</sys:Double>
                            <Thickness x:Key="EventCueTextBlockPadding">0,0,50,0</Thickness>
                            <sys:Double x:Key="EventCueImageWidth">60</sys:Double>
                            <sys:Double x:Key="EventCueImageHeight">60</sys:Double>
                            <Thickness x:Key="EventCueImageMargin">30,0,20,0</Thickness>


                            <Style x:Key="DefaultEventCueButtonStyle" TargetType="Button">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="IsTabStop" Value="False" />
                                <Setter Property="MinHeight" Value="{StaticResource EventCueMinHeight}" />
                                <Setter Property="MinWidth" Value="{StaticResource EventCueMinWidth}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Grid>
                                                <Rectangle MinHeight="{Binding Path=MinHeight, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                                           VerticalAlignment="Stretch"
                                                           Fill="{Binding Path=Background, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
                                                <ContentPresenter VerticalAlignment="Center" />
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>

                            <Style x:Key="NotificationCueButtonStyle" TargetType="Button">
                                <Setter Property="HorizontalAlignment" Value="Center" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Grid x:Name="NotificationsResponsiveGrid"
                                                  MinWidth="50.5" MinHeight="40.5"
                                                  HorizontalAlignment="Center">

                                                <!--  Use Border for rounded corners, dynamically scale based on above grid width and height  -->
                                                <Border Width="{Binding ActualWidth, ElementName=NotificationsResponsiveGrid}"
                                                        Height="{Binding ActualHeight, ElementName=NotificationsResponsiveGrid}"
                                                        Background="{Binding Path=Background, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                                        CornerRadius="2" />

                                                <Border Width="{Binding ActualWidth, ElementName=NotificationsResponsiveGrid}"
                                                        Height="1.625"
                                                        HorizontalAlignment="Center" VerticalAlignment="Top"
                                                        Background="{DynamicResource SlideinObjectives_GoldenHighlight}" />
                                                <ContentPresenter />
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>

                            <Style x:Key="HUDDefaultEventCueTitleTextBlockStyle"
                                   BasedOn="{StaticResource nHUDBaseLargeTextBlockStyle}"
                                   TargetType="TextBlock">
                                <Setter Property="MaxWidth" Value="{StaticResource EventCueTextBlockMaxWidth}" />
                                <Setter Property="Padding" Value="{StaticResource EventCueTextBlockPadding}" />
                                <Setter Property="TextWrapping" Value="Wrap" />
                            </Style>

                            <Style x:Key="DefaultEventCueImageStyle" TargetType="Image">
                                <Setter Property="DockPanel.Dock" Value="Left" />
                                <Setter Property="Height" Value="{StaticResource EventCueImageHeight}" />
                                <Setter Property="Margin" Value="{StaticResource EventCueImageMargin}" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="Width" Value="{StaticResource EventCueImageWidth}" />
                            </Style>

                            <LinearGradientBrush x:Key="HighPriorityNegativeEventTitleBackground" StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Offset="0" Color="#00C22D24" />
                                <GradientStop Offset="0.15" Color="#C22D24" />
                                <GradientStop Offset="0.5" Color="#ED151824" />
                                <GradientStop Offset="0.8" Color="#DB151824" />
                                <GradientStop Offset="1" Color="#00151824" />
                            </LinearGradientBrush>

                            <LinearGradientBrush x:Key="HighPriorityEventTitleBackground" StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Offset="0" Color="#00151824" />
                                <GradientStop Offset="0.1" Color="#B8151824" />
                                <GradientStop Offset="0.2" Color="#151824" />
                                <GradientStop Offset="0.85" Color="#151824" />
                                <GradientStop Offset="1" Color="#00151824" />
                            </LinearGradientBrush>

                            <LinearGradientBrush x:Key="NotificationCueBackground" StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Offset="1" Color="#FF1D2D38" />
                                <GradientStop Color="#801D232A" />
                            </LinearGradientBrush>

                            <LinearGradientBrush x:Key="SlideinObjectives_GoldenHighlight" StartPoint="1,0" EndPoint="0,0">
                                <GradientStop Color="#00B07D37" />
                                <GradientStop Offset="0.5" Color="#FFFFDB88" />
                                <GradientStop Offset="1" Color="#00B07D37" />
                            </LinearGradientBrush>
                        </ContentControl.Resources>

                        <ContentControl.ContentTemplateSelector>
                            <esModels:DataTemplateSourceSelector DataTemplatePropertyName="DataTemplate" Optional="True">
                                <esModels:DataTemplateSourceSelector.Resources>
                                    <DataTemplate x:Key="high_priority_negative">
                                        <Button Background="{StaticResource HighPriorityNegativeEventTitleBackground}"
                                                Command="{Binding Focus}"
                                                IsTabStop="False"
                                                Opacity="{Binding Alpha}"
                                                Style="{StaticResource DefaultEventCueButtonStyle}"
                                                Visibility="{Binding Options[hide_event_cue], Converter={StaticResource InvBoolToVis}, FallbackValue=Visible, Source={x:Static platform:PlatformModel.Instance}}">
                                            <DockPanel>
                                                <Image>
                                                    <Image.Style>
                                                        <Style BasedOn="{StaticResource DefaultEventCueImageStyle}" TargetType="Image">
                                                            <Setter Property="Source" Value="{Binding Path=Icon}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Icon, Converter={StaticResource NullOrEmptyString}}" Value="True">
                                                                    <Setter Property="Source" Value="/WPFGUI;component/icons/event_queue_high_priority_large.png" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                </Image>

                                                <TextBlock DockPanel.Dock="Left"
                                                           Opacity="{Binding Alpha}"
                                                           Style="{StaticResource HUDDefaultEventCueTitleTextBlockStyle}"
                                                           Text="{Binding Title}" />
                                            </DockPanel>
                                        </Button>
                                    </DataTemplate>

                                    <DataTemplate x:Key="high_priority">
                                        <Button Background="{StaticResource HighPriorityEventTitleBackground}"
                                                Command="{Binding Focus}"
                                                IsTabStop="False"
                                                Opacity="{Binding Alpha}"
                                                Style="{StaticResource DefaultEventCueButtonStyle}">
                                            <DockPanel>
                                                <Image Height="26"
                                                       RenderTransformOrigin="0.5,0.5" Stretch="Uniform">
                                                    <Image.Style>
                                                        <Style BasedOn="{StaticResource DefaultEventCueImageStyle}" TargetType="Image">
                                                            <Setter Property="Source" Value="{Binding Path=Icon}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Icon, Converter={StaticResource NullOrEmptyString}}" Value="True">
                                                                    <Setter Property="RenderTransform">
                                                                        <Setter.Value>
                                                                            <ScaleTransform ScaleX="-1" />
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                    <Setter Property="Source" Value="/WPFGUI;component/icons/event_queue_medium_priority.png" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                </Image>

                                                <TextBlock DockPanel.Dock="Left"
                                                           Opacity="{Binding Alpha}"
                                                           Style="{StaticResource HUDDefaultEventCueTitleTextBlockStyle}"
                                                           Text="{Binding Title}" />
                                            </DockPanel>
                                        </Button>
                                    </DataTemplate>

                                    <DataTemplate x:Key="event_with_player_color">
                                        <Grid Opacity="{Binding Alpha}">
                                            <Button VerticalAlignment="Center"
                                                    Background="{StaticResource HighPriorityEventTitleBackground}"
                                                    Command="{Binding Focus}"
                                                    IsTabStop="False"
                                                    Style="{StaticResource DefaultEventCueButtonStyle}">
                                                <Grid>
                                                    <Rectangle VerticalAlignment="Stretch"
                                                               Opacity="{Binding Alpha}"
                                                               Visibility="{Binding HasSender, Converter={StaticResource InvBoolToVis}}">
                                                        <Rectangle.Fill>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                <GradientStop Offset="0" Color="#00FFFFFF" />
                                                                <GradientStop Offset="0.125" Color="#FFFFFFFF" />
                                                                <GradientStop Offset="0.425" Color="#00FFFFFF" />
                                                            </LinearGradientBrush>
                                                        </Rectangle.Fill>

                                                        <Rectangle.Effect>
                                                            <esEffects:TintEffect Tint="{Binding Color}" />
                                                        </Rectangle.Effect>
                                                    </Rectangle>

                                                    <Rectangle VerticalAlignment="Stretch"
                                                               Opacity="{Binding Alpha}"
                                                               Visibility="{Binding HasSender, Converter={StaticResource BoolToVis}}">
                                                        <Rectangle.Fill>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                <GradientStop Offset="0" Color="#00FFFFFF" />
                                                                <GradientStop Offset="0.125" Color="#FFFFFFFF" />
                                                                <GradientStop Offset="0.425" Color="#00FFFFFF" />
                                                            </LinearGradientBrush>
                                                        </Rectangle.Fill>

                                                        <Rectangle.Effect>
                                                            <esEffects:TintEffect Tint="{Binding SenderTeamColor}" />
                                                        </Rectangle.Effect>
                                                    </Rectangle>
                                                    <TextBlock Margin="100,8,0,8" VerticalAlignment="Center"
                                                               Opacity="{Binding Alpha}"
                                                               Style="{StaticResource HUDDefaultEventCueTitleTextBlockStyle}"
                                                               Text="{Binding Title}" />
                                                </Grid>
                                            </Button>
                                            <Image Height="56"
                                                   HorizontalAlignment="Left" VerticalAlignment="Center"
                                                   IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5"
                                                   Stretch="Uniform">
                                                <Image.Style>
                                                    <Style BasedOn="{StaticResource DefaultEventCueImageStyle}" TargetType="Image">
                                                        <Setter Property="Source" Value="{Binding Path=Icon}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Icon, Converter={StaticResource NullOrEmptyString}}" Value="True">
                                                                <Setter Property="Source" Value="/WPFGUI;component/icons/event_queue_medium_priority_large.png" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>
                                        </Grid>
                                    </DataTemplate>

                                    <DataTemplate x:Key="notificationCueWithBackground">
                                        <Button Background="{StaticResource NotificationCueBackground}"
                                                Command="{Binding Focus}"
                                                Focusable="False"
                                                Opacity="{Binding Alpha}"
                                                Style="{StaticResource NotificationCueButtonStyle}">
                                            <StackPanel HorizontalAlignment="Center" Orientation="Vertical">

                                                <Image Width="64" Height="64"
                                                       HorizontalAlignment="Center"
                                                       Source="{Binding Path=Icon}"
                                                       Visibility="{Binding Icon, Mode=OneWay, Converter={StaticResource NotNullOrEmptyStringToVis}, FallbackValue=Collapsed}">
                                                    <Image.Effect>
                                                        <esEffects:TintEffect x:Name="Effect" />
                                                    </Image.Effect>
                                                    <Image.Triggers>
                                                        <EventTrigger RoutedEvent="Image.Loaded">
                                                            <BeginStoryboard>
                                                                <Storyboard AutoReverse="True" RepeatBehavior="Forever">
                                                                    <ColorAnimationUsingKeyFrames Storyboard.TargetName="Effect" Storyboard.TargetProperty="Tint">
                                                                        <SplineColorKeyFrame KeyTime="0" Value="White" />
                                                                        <SplineColorKeyFrame KeyTime="0:0:0.375" Value="#afafaf" />
                                                                        <SplineColorKeyFrame KeyTime="0:0:0.75" Value="White" />
                                                                    </ColorAnimationUsingKeyFrames>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </EventTrigger>
                                                    </Image.Triggers>
                                                </Image>

                                                <TextBlock MaxWidth="500" MaxHeight="88"
                                                           Padding="10,8,10,8" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Opacity="{Binding Alpha}"
                                                           Style="{StaticResource nHUDBaseLargeTextBlockStyle}"
                                                           Text="{Binding Title}"
                                                           TextWrapping="Wrap" />

                                                <TextBlock Padding="10,8,10,8" HorizontalAlignment="Center"
                                                           Style="{StaticResource nHUDBodyTextBlockStyle}"
                                                           Text="{Binding Description}"
                                                           TextAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>

                                    <DataTemplate x:Key="boon_event">
                                        <Border MinWidth="{StaticResource EventCueMinWidth}"
                                                MinHeight="{StaticResource EventCueMinHeight}"
                                                Background="{StaticResource HighPriorityEventTitleBackground}"
                                                Opacity="{Binding Alpha}">
                                            <Grid Margin="50,0,50,0">
                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Style="{StaticResource HUDDefaultEventCueTitleTextBlockStyle}"
                                                           Text="{Binding Title}" />

                                                <ContentControl HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                Content="{Binding RogueModeBoons, Source={x:Static model:CardinalHUDModel.Instance}}"
                                                                ContentTemplate="{StaticResource RogueModeBoonWidgetTemplate}"
                                                                RenderTransformOrigin="0,0">
                                                    <ContentControl.RenderTransform>
                                                        <TranslateTransform />
                                                    </ContentControl.RenderTransform>
                                                    <ContentControl.Triggers>
                                                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation BeginTime="0:0:1"
                                                                                     EasingFunction="{StaticResource QuadEaseOut}"
                                                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="660"
                                                                                     Duration="0:0:1" />

                                                                    <DoubleAnimation BeginTime="0:0:1"
                                                                                     EasingFunction="{StaticResource QuadEaseOut}"
                                                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="-240"
                                                                                     Duration="0:0:1" />

                                                                    <DoubleAnimation BeginTime="0:0:1.2"
                                                                                     EasingFunction="{StaticResource QuadEaseOut}"
                                                                                     Storyboard.TargetProperty="Opacity" To="0"
                                                                                     Duration="0:0:0.8" />
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </EventTrigger>
                                                    </ContentControl.Triggers>
                                                </ContentControl>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </esModels:DataTemplateSourceSelector.Resources>

                                <esModels:DataTemplateSourceSelector.DefaultDataTemplate>
                                    <DataTemplate DataType="model:EventCueModel">
                                        <StackPanel MaxWidth="600"
                                                    Opacity="{Binding Alpha}"
                                                    Orientation="Vertical">
                                            <!--  Todo: Add margin converter on IsSubObjective to indent sub-objectives.  -->
                                            <wm:DIPUtil.DIPMargin>
                                                <MultiBinding Converter="{StaticResource EventCueTitleMarginConverter}" Mode="OneWay">
                                                    <Binding Mode="OneWay" Path="Alpha" />
                                                    <Binding Mode="OneWay" Path="IsFadingOut" />
                                                    <Binding Mode="OneTime">
                                                        <Binding.Source>
                                                            <!--
                                                                This is the translation offset on the margin, vertically
                                                                Comes from the bottom when fading in, then goes up when fading out
                                                            -->
                                                            <sys:Double>5</sys:Double>
                                                        </Binding.Source>
                                                    </Binding>
                                                </MultiBinding>
                                            </wm:DIPUtil.DIPMargin>

                                            <Image Width="64" Height="64"
                                                   HorizontalAlignment="Center"
                                                   Source="{Binding Path=Icon}">
                                                <Image.Effect>
                                                    <esEffects:TintEffect x:Name="Effect" />
                                                </Image.Effect>
                                                <Image.Triggers>
                                                    <EventTrigger RoutedEvent="Image.Loaded">
                                                        <BeginStoryboard>
                                                            <Storyboard AutoReverse="True" RepeatBehavior="Forever">
                                                                <ColorAnimationUsingKeyFrames Storyboard.TargetName="Effect" Storyboard.TargetProperty="Tint">
                                                                    <SplineColorKeyFrame KeyTime="0" Value="White" />
                                                                    <SplineColorKeyFrame KeyTime="0:0:0.375" Value="#afafaf" />
                                                                    <SplineColorKeyFrame KeyTime="0:0:0.75" Value="White" />
                                                                </ColorAnimationUsingKeyFrames>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </Image.Triggers>
                                            </Image>
                                            <TextBlock HorizontalAlignment="Center"
                                                       Background="{DynamicResource HUDBackgroundColorBrush}"
                                                       Foreground="{Binding Color, Converter={StaticResource SolidColorBrushConverter}}"
                                                       Style="{StaticResource HUDParentTitleTextBlock30ptItalicStyle}"
                                                       Text="{Binding Title}"
                                                       TextAlignment="Center" TextWrapping="Wrap" />
                                            <TextBlock HorizontalAlignment="Center"
                                                       Background="{DynamicResource HUDBackgroundColorBrush}"
                                                       Foreground="{Binding Color, Converter={StaticResource SolidColorBrushConverter}}"
                                                       Style="{StaticResource HUDParentBodyTextBlock14ptStyle}"
                                                       Text="{Binding Description}"
                                                       TextAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </esModels:DataTemplateSourceSelector.DefaultDataTemplate>
                            </esModels:DataTemplateSourceSelector>
                        </ContentControl.ContentTemplateSelector>
                    </ContentControl>

                    <Canvas>
                        <Canvas Canvas.Right="5" Canvas.Bottom="-5">

                            <!--  Minimap  -->
                            <Grid Canvas.Bottom="32"
                                  esControls:TagAdorner.AlignmentMode="Relative"
                                  esControls:TagAdorner.ArrowDataTemplate="{StaticResource TagArrowDataTemplate}"
                                  esControls:TagAdorner.DataTemplate="{StaticResource TagDataTemplate}"
                                  esControls:TagAdorner.HorizontalAnchor="Right" esControls:TagAdorner.HorizontalPlacement="Left"
                                  esControls:TagAdorner.TargetDataTemplate="{StaticResource EmptyTagDataTemplate}"
                                  esControls:TagAdorner.VerticalAnchor="Bottom" esControls:TagAdorner.VerticalPlacement="Top">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Canvas.Right" Value="30" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SettingValueLookup[MinimapZoomLevel], Source={x:Static sysConfigModels:SystemConfigModel.Instance}, Converter={StaticResource GreaterCompare}, ConverterParameter=1}" Value="True">
                                                <Setter Property="Canvas.Right" Value="15" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid>
                                    <Grid.LayoutTransform>
                                        <ScaleTransform ScaleX="{Binding SettingValueLookup[MinimapZoomLevel], Source={x:Static sysConfigModels:SystemConfigModel.Instance}}" ScaleY="{Binding SettingValueLookup[MinimapZoomLevel], Source={x:Static sysConfigModels:SystemConfigModel.Instance}}" />
                                    </Grid.LayoutTransform>
                                    <esControls:TagAdorner.IsTagged>
                                        <MultiBinding Converter="{StaticResource IsTaggedConverter}" ConverterParameter="Minimap">
                                            <Binding Path="TagVersion" />
                                        </MultiBinding>
                                    </esControls:TagAdorner.IsTagged>

                                    <esControls:TagAdorner.Data>
                                        <MultiBinding Converter="{StaticResource TagDataConverter}" ConverterParameter="Minimap">
                                            <Binding Path="TagVersion" />
                                        </MultiBinding>
                                    </esControls:TagAdorner.Data>

                                    <!--  Compass Background  -->
                                    <Ellipse Width="248" Height="248"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                             Fill="{StaticResource TertiaryColorDarkTransparent60}"
                                             IsHitTestVisible="False">
                                        <Ellipse.RenderTransform>
                                            <TranslateTransform X="-0.5" Y="-1" />
                                        </Ellipse.RenderTransform>
                                    </Ellipse>

                                    <!--  Compass Circle  -->
                                    <Image Width="274" Height="274"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5"
                                           Source="/WPFGUI;component/icons/HUD/minimap/minimap_circle_GIAL_150.png">
                                        <Image.RenderTransform>
                                            <RotateTransform Angle="45" />
                                        </Image.RenderTransform>
                                    </Image>

                                    <!--  Minimap Background (visible on non-square maps)  -->
                                    <Image Width="273" Height="273"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5"
                                           Source="/WPFGUI;component/icons/HUD/minimap/map_square_bg_150.png">
                                        <Image.RenderTransform>
                                            <RotateTransform Angle="{Binding Map.Angle, Converter={StaticResource AddOperator}, ConverterParameter=45}" />
                                        </Image.RenderTransform>
                                    </Image>

                                    <!--  Map Source  -->
                                    <Image x:Name="TheMinimapImage"
                                           Width="194" Height="194"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5"
                                           Source="{Binding Map.Minimap}"
                                           Stretch="Uniform">
                                        <Image.RenderTransform>
                                            <TransformGroup>
                                                <RotateTransform Angle="{Binding Map.Angle}" />
                                            </TransformGroup>
                                        </Image.RenderTransform>
                                        <Image.Effect>
                                            <esEffects:SaturateEffect Saturation="0.75" />
                                        </Image.Effect>
                                    </Image>

                                    <!--
                                        Main Map
                                        This visibility binding is because the image doesn't load immediately and sometime causes the marks to not display at all
                                        and the Width/Height bindings break and don't update after the image finally loads.
                                        With the visibility collapsed, the width/height bindings are not evaluated until it gets visible.
                                    -->
                                    <controls:MapControl x:Name="Minimap"
                                                         Width="{Binding ElementName=TheMinimapImage, Path=ActualWidth}"
                                                         Height="{Binding ElementName=TheMinimapImage, Path=ActualHeight}"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                                         Focusable="False" IsTabStop="False"
                                                         PlayableHeight="{Binding Map.PlayableHeight}"
                                                         PlayableWidth="{Binding Map.PlayableWidth}"
                                                         Visibility="{Binding ElementName=TheMinimapImage, Path=ActualWidth, Converter={StaticResource NumberToVis}}">
                                        <Grid Background="Transparent" RenderTransformOrigin="0.5,0.5">
                                            <Grid.RenderTransform>
                                                <TransformGroup>
                                                    <ScaleTransform ScaleY="-1" />
                                                    <RotateTransform Angle="{Binding Map.Angle}" />
                                                </TransformGroup>
                                            </Grid.RenderTransform>

                                            <!--  FOW  -->
                                            <Rectangle>
                                                <Rectangle.Fill>
                                                    <ImageBrush AlignmentX="Center" AlignmentY="Center"
                                                                ImageSource="pack://application:,,,/WPFGUI;component/Resources/FogOfWarTexture.png" Stretch="Fill"
                                                                TileMode="None" Viewport="0.0,0.0,1.0,1.0"
                                                                ViewportUnits="RelativeToBoundingBox">
                                                        <ImageBrush.RelativeTransform>
                                                            <ScaleTransform CenterX="0.5" CenterY="0.5"
                                                                            ScaleX="{Binding Map.FOWScaleX}"
                                                                            ScaleY="{Binding Map.FOWScaleY}" />
                                                        </ImageBrush.RelativeTransform>
                                                    </ImageBrush>
                                                </Rectangle.Fill>
                                            </Rectangle>

                                            <esControls:PositionCanvasItemsControl esControls:RecyclingItemsControl.RecyclingLimit="100" IsHitTestVisible="False"
                                                                                   IsTabStop="False"
                                                                                   ItemsSource="{Binding Map.MapIcons}"
                                                                                   PositionPropertyName="Position"
                                                                                   Version="{Binding Map.MapIcons.Version}">
                                                <esControls:PositionCanvasItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <eHUDControls:MapCanvas ChildHorizontalAlignment="Center" ChildVerticalAlignment="Center"
                                                                                PlayableHeight="{Binding Map.PlayableHeight}"
                                                                                PlayableWidth="{Binding Map.PlayableWidth}" />
                                                    </ItemsPanelTemplate>
                                                </esControls:PositionCanvasItemsControl.ItemsPanel>

                                                <esControls:PositionCanvasItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type model:MapIconModel}">
