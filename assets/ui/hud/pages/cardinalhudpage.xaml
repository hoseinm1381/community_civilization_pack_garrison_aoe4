                                                                                            <ScaleTransform ScaleX="1.0" ScaleY="1.0" />
                                                                                        </ContentPresenter.RenderTransform>
                                                                                    </ContentPresenter>
                                                                                    <TextBlock Style="{StaticResource nHUDBaseSmallTextBlockStyle}" Text="{Binding NumInHighlightedControlGroupOfType}">
                                                                                        <TextBlock.Visibility>
                                                                                            <Binding Converter="{StaticResource GreaterCompare}"
                                                                                                     ConverterParameter="1" FallbackValue="Collapsed"
                                                                                                     Path="NumInHighlightedControlGroupOfType" />
                                                                                        </TextBlock.Visibility>
                                                                                    </TextBlock>
                                                                                </Grid>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </ContentControl>
                                                            </ControlTemplate>
                                                        </ToolTip.Template>
                                                    </ToolTip>
                                                </Button.ToolTip>
                                            </Button>
                                            <TextBlock HorizontalAlignment="Left" VerticalAlignment="Top"
                                                       IsHitTestVisible="False"
                                                       Style="{StaticResource nHUDBaseTextBlockStyle}"
                                                       Text="{Binding Selection.Count, Mode=OneWay}"
                                                       TextAlignment="Center" />
                                            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                    Background="{DynamicResource HUDHotkeyBackgroundBrush}"
                                                    IsHitTestVisible="False">
                                                <TextBlock Margin="2"
                                                           Style="{StaticResource nHUDBaseHeavyTextBlockStyle}"
                                                           Text="{Binding Index, Mode=OneWay}"
                                                           TextAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!--  Global Abilities Panel  -->
                        <Grid x:Name="GlobalAbilitiesPanel"
                              Grid.Row="3"
                              Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ContentControl Grid.Column="1"
                                            Margin="-10,0,0,0" HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Content="{Binding LocalPlayer.GlobalAbilities}"
                                            ContentTemplate="{StaticResource GlobalAbilitiesTemplate}"
                                            IsTabStop="False"
                                            Visibility="{Binding LocalPlayer.GlobalAbilities.IsAvailable, Converter={StaticResource BoolToVis}}" />

                            <!--  Boon Widget  -->
                            <ContentControl>
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Value="True">
                                                <DataTrigger.Binding>
                                                    <MultiBinding Converter="{StaticResource MultiLogicalAnd}">
                                                        <Binding Converter="{StaticResource NotNullConverter}" Path="RogueModeBoons" />
                                                        <Binding Converter="{StaticResource EqualityCompare}"
                                                                 ConverterParameter="{x:Static Visibility.Visible}"
                                                                 Path="TaskbarVisibleVisibility" />
                                                    </MultiBinding>
                                                </DataTrigger.Binding>
                                                <Setter Property="Content" Value="{Binding RogueModeBoons}" />
                                                <Setter Property="ContentTemplate" Value="{StaticResource RogueModeBoonWidgetTemplate}" />
                                                <Setter Property="Visibility" Value="{Binding RogueModeBoons.AllBoonsPicked, Converter={StaticResource InvBoolToVis}}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                            </ContentControl>
                        </Grid>

                        <!--  Selection Card and Command Card area  -->
                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid x:Name="selectionCommandCardsGrid" Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" MinHeight="52" />
                                    <RowDefinition Height="243" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!--  Global Build Queue a.k.a. Global Unit Control (bottom-left instance)  -->
                                <ContentControl Grid.Row="0" Grid.ColumnSpan="3"
                                                Margin="11,0,20,8" HorizontalAlignment="Left"
                                                VerticalAlignment="Bottom"
                                                Content="{Binding}"
                                                ContentTemplate="{StaticResource GlobalBuildQueuePanelTemplate}"
                                                IsTabStop="False" />

                                <!--  Civ specific + build queue  -->

                                <!--  Delhi Sultanates Scholars  -->
                                <ContentControl Grid.Row="1" Grid.Column="0"
                                                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                Content="{Binding}"
                                                ContentTemplate="{StaticResource SultanateScholarsDisplay}"
                                                IsTabStop="False"
                                                Visibility="{Binding LocalPlayer.RaceID, Converter={StaticResource IsEqualVisibilityConverter}, ConverterParameter={StaticResource SultanateRaceID}}" />

                                <!--  Chinese Imperial Officers  -->
                                <ContentControl Grid.Row="1" Grid.Column="0"
                                                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                Content="{Binding}"
                                                IsTabStop="False">
                                    <ContentControl.Style>
                                        <Style TargetType="ContentControl">
                                            <Setter Property="ContentTemplate" Value="{StaticResource ChineseImperialOfficers}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LocalPlayer.ScarModel[vietnam_hud]}" Value="True">
                                                    <Setter Property="ContentTemplate" Value="{StaticResource VietnamBuffaloCounter}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContentControl.Style>
                                    <ContentControl.Visibility>
                                        <MultiBinding Converter="{StaticResource MultiLogicalOr}">
                                            <Binding Converter="{StaticResource IsEqualConverter}"
                                                     ConverterParameter="{StaticResource ChineseRaceID}"
                                                     Path="LocalPlayer.RaceID" />
                                            <Binding Converter="{StaticResource IsEqualConverter}"
                                                     ConverterParameter="{StaticResource HistoricChineseRaceID}"
                                                     Path="LocalPlayer.RaceID" />
                                            <Binding Converter="{StaticResource IsEqualConverter}"
                                                     ConverterParameter="{StaticResource SongDynastyRaceID}"
                                                     Path="LocalPlayer.RaceID" />
                                        </MultiBinding>
                                    </ContentControl.Visibility>
                                </ContentControl>

                                <!--  Jin Horses  -->
                                <ContentControl Grid.Row="1" Grid.Column="0"
                                                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                Content="{Binding}"
                                                ContentTemplate="{StaticResource JinHorseDisplay}"
                                                IsTabStop="False"
                                                Visibility="{Binding LocalPlayer.RaceID, Converter={StaticResource IsEqualVisibilityConverter}, ConverterParameter={StaticResource JinRaceID}}" />

                                <!--  HRE Prelates  -->
                                <ContentControl Grid.Row="1" Grid.Column="0"
                                                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                Content="{Binding}"
                                                ContentTemplate="{StaticResource HREPrelateDisplay}"
                                                IsTabStop="False"
                                                Visibility="{Binding LocalPlayer.RaceID, Converter={StaticResource IsEqualVisibilityConverter}, ConverterParameter={StaticResource HRERaceID}}" />

                                <!--  TUG Worker Elephants  -->
                                <ContentControl Grid.Row="1" Grid.Column="0"
                                                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                Content="{Binding}"
                                                ContentTemplate="{StaticResource WorkerElephantTemplate}"
                                                IsTabStop="False"
                                                Visibility="{Binding LocalPlayer.RaceID, Converter={StaticResource IsEqualVisibilityConverter}, ConverterParameter={StaticResource HistoricSultanateRaceID}}" />

                                <!--  Lancaster Manors and Lords  -->
                                <ContentControl Grid.Row="1" Grid.Column="0"
                                                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                Content="{Binding}"
                                                ContentTemplate="{StaticResource LancasterManorsAndLordsDisplay}"
                                                IsTabStop="False"
                                                Visibility="{Binding LocalPlayer.RaceID, Converter={StaticResource IsEqualVisibilityConverter}, ConverterParameter={StaticResource LancasterRaceID}}" />

                                <!--  Kights Templar Fortresses  -->
                                <ContentControl Grid.Row="1" Grid.Column="0"
                                                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                Content="{Binding}"
                                                ContentTemplate="{StaticResource TemplarFortressDisplay}"
                                                IsTabStop="False"
                                                Visibility="{Binding LocalPlayer.RaceID, Converter={StaticResource IsEqualVisibilityConverter}, ConverterParameter={StaticResource TemplarRaceID}}" />

                                <!--  Abbasid / Ayyubid Golden Age  -->
                                <ContentControl Grid.Row="1" Grid.Column="0"
                                                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                Content="{Binding}"
                                                ContentTemplate="{StaticResource AbbasidGoldenAgeDisplay}"
                                                IsTabStop="False">
                                    <ContentControl.Visibility>
                                        <MultiBinding Converter="{StaticResource MultiLogicalOr}">
                                            <Binding Converter="{StaticResource IsEqualConverter}"
                                                     ConverterParameter="{StaticResource AbbasidRaceID}"
                                                     Path="LocalPlayer.RaceID" />
                                            <Binding Converter="{StaticResource IsEqualConverter}"
                                                     ConverterParameter="{StaticResource HistoricAbbasidRaceID}"
                                                     Path="LocalPlayer.RaceID" />
                                        </MultiBinding>
                                    </ContentControl.Visibility>
                                </ContentControl>

                                <!--  Rus Bounty Display  -->
                                <ContentControl Grid.Row="1" Grid.Column="0"
                                                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                esControls:TagAdorner.AlignmentMode="Relative"
                                                esControls:TagAdorner.ArrowDataTemplate="{StaticResource TagArrowDataTemplate}"
                                                esControls:TagAdorner.DataTemplate="{StaticResource TagDataTemplate}"
                                                esControls:TagAdorner.HorizontalAnchor="Right" esControls:TagAdorner.HorizontalPlacement="Right"
                                                esControls:TagAdorner.TargetDataTemplate="{StaticResource EmptyTagDataTemplate}"
                                                esControls:TagAdorner.VerticalAnchor="Top" esControls:TagAdorner.VerticalPlacement="Center"
                                                Content="{Binding}"
                                                ContentTemplate="{StaticResource RusBountyDisplay}"
                                                IsTabStop="False"
                                                Visibility="{Binding LocalPlayer.RaceID, Converter={StaticResource IsEqualVisibilityConverter}, ConverterParameter={StaticResource RusRaceID}}">
                                    <esControls:TagAdorner.IsTagged>
                                        <MultiBinding Converter="{StaticResource IsTaggedConverter}" ConverterParameter="RusBountyTag">
                                            <Binding Path="TagVersion" Source="{x:Static model:HUDModel.Instance}" />
                                        </MultiBinding>
                                    </esControls:TagAdorner.IsTagged>
                                    <esControls:TagAdorner.Data>
                                        <MultiBinding Converter="{StaticResource TagDataConverter}" ConverterParameter="RusBountyTag">
                                            <Binding Path="TagVersion" Source="{x:Static model:HUDModel.Instance}" />
                                        </MultiBinding>
                                    </esControls:TagAdorner.Data>
                                </ContentControl>

                                <!--  Ottoman Imperial Council Button  -->
                                <ContentControl Grid.Row="1" Grid.Column="0"
                                                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                Content="{Binding}"
                                                ContentTemplate="{StaticResource OttomanImperialCouncilVisierTemplate}"
                                                IsTabStop="False"
                                                Visibility="{Binding LocalPlayer.RaceID, Converter={StaticResource IsEqualVisibilityConverter}, ConverterParameter={StaticResource OttomanRaceID}}" />

                                <!--  Ottoman Imperial Council Panel  -->
                                <ContentControl Grid.Row="1" Grid.Column="0"
                                                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                Content="{Binding}"
                                                ContentTemplate="{StaticResource OttomanImperialCouncilBonusTemplate}"
                                                IsTabStop="False"
                                                Visibility="{Binding LocalPlayer.RaceID, Converter={StaticResource IsEqualVisibilityConverter}, ConverterParameter={StaticResource OttomanRaceID}}" />

                                <!--  Daimyo  -->
                                <ContentControl Grid.Row="1" Grid.Column="0"
                                                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                Content="{Binding LocalPlayer.Daimyo}"
                                                ContentTemplate="{StaticResource DaimyoTemplate}"
                                                IsTabStop="False"
                                                Visibility="{Binding Content, RelativeSource={RelativeSource Self}, Converter={StaticResource NotNullToVis}}" />


                                <!--  Sengoku Daimyo  -->
                                <ContentControl Grid.Row="1" Grid.Column="0"
                                                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                Content="{Binding LocalPlayer.SengokuDaimyo}"
                                                ContentTemplate="{StaticResource SengokuDaimyoTemplate}"
                                                IsTabStop="False"
                                                Visibility="{Binding Content, RelativeSource={RelativeSource Self}, Converter={StaticResource NotNullToVis}}" />

                                <!--  Jeanne  -->
                                <ContentControl Grid.Row="1" Grid.Column="0"
                                                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                Content="{Binding}"
                                                ContentTemplate="{StaticResource JeanneTemplate}"
                                                IsTabStop="False"
                                                Visibility="{Binding LocalPlayer.RaceID, Converter={StaticResource IsEqualVisibilityConverter}, ConverterParameter={StaticResource HistoricFrenchRaceID}}" />

                                <!--  Build Queue  -->
                                <ContentControl Grid.Row="1"
                                                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                Content="{Binding}"
                                                ContentTemplate="{StaticResource BuildQueuePanelTemplate}"
                                                IsTabStop="False">
                                    <ContentControl.Style>
                                        <Style TargetType="ContentControl">
                                            <Setter Property="Grid.Column" Value="0" />
                                            <Setter Property="Grid.ColumnSpan" Value="4" />
                                            <Setter Property="Margin" Value="11,0,0,8" />
                                            <Style.Triggers>
                                                <DataTrigger Value="True">
                                                    <DataTrigger.Binding>
                                                        <MultiBinding Converter="{StaticResource MultiLogicalOr}">
                                                            <Binding Converter="{StaticResource IsEqualConverter}"
                                                                     ConverterParameter="{StaticResource SultanateRaceID}"
                                                                     Path="LocalPlayer.RaceID"
                                                                     Source="{x:Static model:HUDModel.Instance}" />
                                                            <Binding Converter="{StaticResource IsEqualConverter}"
                                                                     ConverterParameter="{StaticResource HRERaceID}"
                                                                     Path="LocalPlayer.RaceID"
                                                                     Source="{x:Static model:HUDModel.Instance}" />
                                                            <Binding Converter="{StaticResource IsEqualConverter}"
                                                                     ConverterParameter="{StaticResource LancasterRaceID}"
                                                                     Path="LocalPlayer.RaceID"
                                                                     Source="{x:Static model:HUDModel.Instance}" />
                                                            <Binding Converter="{StaticResource IsEqualConverter}"
                                                                     ConverterParameter="{StaticResource TemplarRaceID}"
                                                                     Path="LocalPlayer.RaceID"
                                                                     Source="{x:Static model:HUDModel.Instance}" />
                                                            <Binding Converter="{StaticResource IsEqualConverter}"
                                                                     ConverterParameter="{StaticResource AbbasidRaceID}"
                                                                     Path="LocalPlayer.RaceID"
                                                                     Source="{x:Static model:HUDModel.Instance}" />
                                                            <Binding Converter="{StaticResource IsEqualConverter}"
                                                                     ConverterParameter="{StaticResource HistoricAbbasidRaceID}"
                                                                     Path="LocalPlayer.RaceID"
                                                                     Source="{x:Static model:HUDModel.Instance}" />
                                                            <Binding Converter="{StaticResource IsEqualConverter}"
                                                                     ConverterParameter="{StaticResource RusRaceID}"
                                                                     Path="LocalPlayer.RaceID"
                                                                     Source="{x:Static model:HUDModel.Instance}" />
                                                            <Binding Converter="{StaticResource IsEqualConverter}"
                                                                     ConverterParameter="{StaticResource OttomanRaceID}"
                                                                     Path="LocalPlayer.RaceID"
                                                                     Source="{x:Static model:HUDModel.Instance}" />
                                                            <Binding Converter="{StaticResource IsEqualConverter}"
                                                                     ConverterParameter="{StaticResource JapaneseRaceID}"
                                                                     Path="LocalPlayer.RaceID"
                                                                     Source="{x:Static model:HUDModel.Instance}" />
                                                            <Binding Converter="{StaticResource IsEqualConverter}"
                                                                     ConverterParameter="{StaticResource HistoricFrenchRaceID}"
                                                                     Path="LocalPlayer.RaceID"
                                                                     Source="{x:Static model:HUDModel.Instance}" />
                                                            <Binding Converter="{StaticResource IsEqualConverter}"
                                                                     ConverterParameter="{StaticResource JinRaceID}"
                                                                     Path="LocalPlayer.RaceID"
                                                                     Source="{x:Static model:HUDModel.Instance}" />
                                                            <Binding Converter="{StaticResource IsEqualConverter}"
                                                                     ConverterParameter="{StaticResource HistoricalJapaneseRaceID}"
                                                                     Path="LocalPlayer.RaceID"
                                                                     Source="{x:Static model:HUDModel.Instance}" />
                                                            <Binding Converter="{StaticResource IsEqualConverter}"
                                                                     ConverterParameter="{StaticResource HistoricSultanateRaceID}"
                                                                     Path="LocalPlayer.RaceID"
                                                                     Source="{x:Static model:HUDModel.Instance}" />
                                                        </MultiBinding>
                                                    </DataTrigger.Binding>
                                                    <Setter Property="Grid.Column" Value="1" />
                                                    <Setter Property="Grid.ColumnSpan" Value="3" />
                                                </DataTrigger>
                                                <DataTrigger Value="True">
                                                    <DataTrigger.Binding>
                                                        <MultiBinding Converter="{StaticResource MultiLogicalOr}">
                                                            <Binding Converter="{StaticResource IsEqualConverter}"
                                                                     ConverterParameter="{StaticResource ChineseRaceID}"
                                                                     Path="LocalPlayer.RaceID"
                                                                     Source="{x:Static model:HUDModel.Instance}" />
                                                            <Binding Converter="{StaticResource IsEqualConverter}"
                                                                     ConverterParameter="{StaticResource HistoricChineseRaceID}"
                                                                     Path="LocalPlayer.RaceID"
                                                                     Source="{x:Static model:HUDModel.Instance}" />
                                                            <Binding Converter="{StaticResource IsEqualConverter}"
                                                                     ConverterParameter="{StaticResource SongDynastyRaceID}"
                                                                     Path="LocalPlayer.RaceID"
                                                                     Source="{x:Static model:HUDModel.Instance}" />
                                                        </MultiBinding>
                                                    </DataTrigger.Binding>
                                                    <Setter Property="Grid.Column" Value="1" />
                                                    <Setter Property="Grid.ColumnSpan" Value="3" />
                                                    <Setter Property="Margin" Value="100,0,0,8" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding LocalPlayer.RaceID, Source={x:Static model:HUDModel.Instance}, Converter={StaticResource IsEqualConverter}, ConverterParameter={StaticResource ByzantineRaceID}}" Value="True">
                                                    <Setter Property="Grid.Column" Value="2" />
                                                    <Setter Property="Grid.ColumnSpan" Value="2" />
                                                    <Setter Property="Margin" Value="0,0,0,8" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding LocalPlayer.RaceID, Source={x:Static model:HUDModel.Instance}, Converter={StaticResource IsEqualConverter}, ConverterParameter={StaticResource HistoricByzantineID}}" Value="True">
                                                    <Setter Property="Grid.Column" Value="2" />
                                                    <Setter Property="Grid.ColumnSpan" Value="2" />
                                                    <Setter Property="Margin" Value="0,0,0,8" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContentControl.Style>
                                </ContentControl>


                                <!--  Lower HUD  -->

                                <!--  Resources Panel  -->
                                <ContentControl Grid.Column="0" Grid.ColumnSpan="2"
                                                VerticalAlignment="Bottom"
                                                Content="{Binding}"
                                                ContentTemplate="{StaticResource ResourcesPanelTemplate}"
                                                IsTabStop="False">
                                    <ContentControl.Style>
                                        <Style TargetType="ContentControl">
                                            <Setter Property="Grid.Row" Value="2" />
                                            <Setter Property="Grid.RowSpan" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LocalPlayer.RaceID, Source={x:Static model:HUDModel.Instance}, Converter={StaticResource IsEqualConverter}, ConverterParameter={StaticResource ByzantineRaceID}}" Value="True">
                                                    <Setter Property="Grid.Row" Value="1" />
                                                    <Setter Property="Grid.RowSpan" Value="2" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding LocalPlayer.RaceID, Source={x:Static model:HUDModel.Instance}, Converter={StaticResource IsEqualConverter}, ConverterParameter={StaticResource HistoricByzantineID}}" Value="True">
                                                    <Setter Property="Grid.Row" Value="1" />
                                                    <Setter Property="Grid.RowSpan" Value="2" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContentControl.Style>
                                </ContentControl>

                                <!--  Selection Card and Command Card  -->
                                <Control Grid.Row="2" Grid.Column="2"
                                         Width="693"
                                         Margin="0,0,6,0"
                                         IsTabStop="False"
                                         Template="{StaticResource SelectionCardAndCommandCardDataTemplate}"
                                         Visibility="{Binding SelectionVisibility, FallbackValue=Hidden}" />

                                <!--  Build Menu  -->
                                <Control Grid.Row="2" Grid.Column="3"
                                         IsTabStop="False"
                                         Template="{StaticResource BuildMenuPanelTemplate}" />

                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </AdornerDecorator>

        <Grid Margin="0,60,0,0" KeyboardNavigation.TabNavigation="None">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="240" />
                <RowDefinition Height="Auto" MinHeight="100" />
                <RowDefinition Height="Auto" MinHeight="65" />
                <RowDefinition Height="Auto" MinHeight="326" />
            </Grid.RowDefinitions>

            <Rectangle Grid.Row="3"
                       Height="320"
                       VerticalAlignment="Bottom"
                       Fill="Transparent" IsHitTestVisible="False">
                <Rectangle.LayoutTransform>
                    <ScaleTransform ScaleY="{Binding SettingValueLookup[MinimapZoomLevel], Source={x:Static sysConfigModels:SystemConfigModel.Instance}}" />
                </Rectangle.LayoutTransform>
            </Rectangle>

            <Rectangle x:Name="ChatHeightProxy"
                       Grid.Row="0"
                       Width="100"
                       Margin="0,0,15,20" HorizontalAlignment="Right"
                       VerticalAlignment="Stretch"
                       Fill="Transparent" IsHitTestVisible="False" />

            <!--  Player scores  -->
            <ContentControl Name="PlayerScores"
                            Grid.Row="1"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Panel.ZIndex="1"
                            Content="{Binding}"
                            ContentTemplate="{StaticResource PlayerScoresTemplate}"
                            IsHitTestVisible="False" IsTabStop="False" />

            <!--  Event Cues  -->
            <esControls:AnimatedItemsControl Name="EventCues"
                                             Grid.Row="2"
                                             Width="900"
                                             Margin="0,10,0,0" HorizontalAlignment="Right"
                                             VerticalAlignment="Bottom" Panel.ZIndex="2"
                                             ClipToBounds="True" IsHitTestVisible="False"
                                             IsTabStop="False"
                                             ItemsSource="{Binding EventCues}"
                                             Visibility="{Binding TaskbarVisibleVisibility, FallbackValue=Collapsed}">
                <esControls:AnimatedItemsControl.Style>
                    <Style TargetType="esControls:AnimatedItemsControl">
                        <Setter Property="Height" Value="135" />
                        <!--  Reduce height with more players to account for height of players display  -->
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Players.Count, Converter={StaticResource GreaterCompare}, ConverterParameter=6}" Value="True" />
                                    <Condition Binding="{Binding ElementName=PlayerScores, Path=IsVisible}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Height" Value="100" />
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding SettingValueLookup[MinimapZoomLevel], Source={x:Static sysConfigModels:SystemConfigModel.Instance}, Converter={StaticResource GreaterCompare}, ConverterParameter=1.25}" Value="True" />
                                    <Condition Binding="{Binding Players.Count, Converter={StaticResource GreaterCompare}, ConverterParameter=6}" Value="True" />
                                    <Condition Binding="{Binding ElementName=PlayerScores, Path=IsVisible}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Height" Value="66" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </esControls:AnimatedItemsControl.Style>

                <ItemsControl.Resources>
                    <sys:Double x:Key="EvenCueHeight">34</sys:Double>
                    <sys:Double x:Key="EventCueMinHeight">30</sys:Double>
                    <sys:Double x:Key="EventCueMinWidth">270</sys:Double>
                    <sys:Double x:Key="EventCueTextBlockMaxHeight">30</sys:Double>
                    <Thickness x:Key="EventCueTextBlockPadding">78,0,12,0</Thickness>
                    <sys:Double x:Key="EventCueImageWidth">30</sys:Double>
                    <sys:Double x:Key="EventCueImageHeight">30</sys:Double>
                    <Thickness x:Key="EventCueImageMargin">0,0,14,0</Thickness>


                    <Style x:Key="DefaultEventCueButtonStyle" TargetType="Button">
                        <Setter Property="Height" Value="{StaticResource EvenCueHeight}" />
                        <Setter Property="HorizontalAlignment" Value="Right" />
                        <Setter Property="IsTabStop" Value="False" />
                        <Setter Property="MinHeight" Value="{StaticResource EventCueMinHeight}" />
                        <Setter Property="MinWidth" Value="{StaticResource EventCueMinWidth}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Grid>
                                        <Rectangle Height="{Binding Path=MinHeight, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                                   VerticalAlignment="Center"
                                                   Fill="{Binding Path=Background, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
                                        <ContentPresenter />
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <Style x:Key="PlayerColorEventCueButtonStyle" TargetType="Button">
                        <Setter Property="Height" Value="{StaticResource EvenCueHeight}" />
                        <Setter Property="HorizontalAlignment" Value="Right" />
                        <Setter Property="IsTabStop" Value="False" />
                        <Setter Property="MinHeight" Value="{StaticResource EventCueMinHeight}" />
                        <Setter Property="MinWidth" Value="{StaticResource EventCueMinWidth}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Grid>
                                        <ContentPresenter />
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <Style x:Key="HUDDefaultEventCueTextBlockStyle"
                           BasedOn="{StaticResource HUDEventQueueTextBlockStyle}"
                           TargetType="TextBlock">
                        <Setter Property="MaxHeight" Value="{StaticResource EventCueTextBlockMaxHeight}" />
                        <Setter Property="MaxWidth" Value="{StaticResource EventCueTextBlockMaxWidth}" />
                        <Setter Property="Padding" Value="{StaticResource EventCueTextBlockPadding}" />
                    </Style>

                    <Style x:Key="DefaultEventCueImageStyle" TargetType="Image">
                        <Setter Property="DockPanel.Dock" Value="Right" />
                        <Setter Property="Height" Value="{StaticResource EventCueImageHeight}" />
                        <Setter Property="Margin" Value="{StaticResource EventCueImageMargin}" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="Width" Value="{StaticResource EventCueImageWidth}" />
                    </Style>


                    <LinearGradientBrush x:Key="HighPriorityCueBackground" StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="#00151824" />
                        <GradientStop Offset="0.2" Color="#DB151824" />
                        <GradientStop Offset="0.70" Color="#ED151824" />
                        <GradientStop Offset="0.9" Color="#C22D24" />
                        <GradientStop Offset="1" Color="#00C22D24" />
                    </LinearGradientBrush>

                    <LinearGradientBrush x:Key="MediumPriorityCueBackground" StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="#00151824" />
                        <GradientStop Offset="0.25" Color="#151824" />
                        <GradientStop Offset="0.9" Color="#151824" />
                        <GradientStop Offset="0.97" Color="#B8151824" />
                        <GradientStop Offset="1" Color="#00151824" />
                    </LinearGradientBrush>

                    <LinearGradientBrush x:Key="CTAAlertCueBackground" StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="#00151824" />
                        <GradientStop Offset="0.2" Color="#DB151824" />
                        <GradientStop Offset="0.68" Color="#ED151824" />
