                                                            <Setter Property="Background">
                                                                <Setter.Value>
                                                                    <SolidColorBrush Color="#4D151824" />
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style.Setters>
                                                    </Style>
                                                </ProgressBar.Style>
                                            </ProgressBar>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </DataTemplate>

                            <!--  Rouge Boss Unit Healthbar  -->
                            <DataTemplate x:Key="RogueBossUnitDecoratorTemplate" DataType="{x:Type model:CardinalUnoptimizedSquadDecoratorModel}">
