                                            esControls:TagAdorner.VerticalAnchor="Bottom" esControls:TagAdorner.VerticalPlacement="Top"
                                            esUtility:AudioAttachedProperty.PreviewMouseLeftButtonUpSound="sfx_ui_hud_inGame_button_minimapZoom_play"
