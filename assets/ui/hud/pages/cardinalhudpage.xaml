                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:componentModel="clr-namespace:System.ComponentModel;assembly=PresentationFramework" xmlns:controls="clr-namespace:WPFGUI.HUD.Controls"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:eHUDControls="clr-namespace:WPFGUI.HUD.Controls;assembly=EngineUI"
                   xmlns:eHUDPages="clr-namespace:WPFGUI.HUD.Pages;assembly=EngineUI" xmlns:esActions="clr-namespace:WPFGUI.Shared.Actions;assembly=EngineUI"
                   xmlns:esControls="clr-namespace:WPFGUI.Shared.Controls;assembly=EngineUI" xmlns:esConverters="clr-namespace:WPFGUI.Shared.Converters;assembly=EngineUI"
                   xmlns:esEffects="clr-namespace:WPFGUI.Shared.Effects;assembly=EngineUI.Shaders" xmlns:esModels="clr-namespace:WPFGUI.Shared.Models;assembly=EngineUI"
                   xmlns:esPages="clr-namespace:WPFGUI.Shared.Pages;assembly=EngineUI" xmlns:esUtility="clr-namespace:WPFGUI.Shared.Utility;assembly=EngineUI"
                   xmlns:local="clr-namespace:WPFGUI.HUD.Pages" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   xmlns:model="clr-namespace:HUDModelTypes" xmlns:platform="clr-namespace:PlatformModelTypes"
                   xmlns:rogue="clr-namespace:RogueModeModelTypes" xmlns:sys="clr-namespace:System;assembly=mscorlib"
                   xmlns:sysConfigModels="clr-namespace:SystemConfigModelTypes" xmlns:targetingModel="clr-namespace:TargetingModelTypes"
                   xmlns:timedText="clr-namespace:Microsoft.Media.TimedText;assembly=Microsoft.Media.TimedText" xmlns:wm="clr-namespace:WPFGUI.Shared.MarkupExtensions;assembly=EngineUI"
                   x:Name="TheHUDPage" Title="HUDPage"
                   d:DesignHeight="1080" d:DesignWidth="1920"
                   DataContext="{x:Static model:CardinalHUDModel.Instance}"
                   FocusVisualStyle="{x:Null}"
                   Focusable="True" KeyboardNavigation.ControlTabNavigation="None"
                   KeyboardNavigation.DirectionalNavigation="None" KeyboardNavigation.TabNavigation="Continue"
                   mc:Ignorable="d">
    <eHUDPages:HUDPage.Resources>
        <ResourceDictionary>
            <!--  The TheHUDPageProxy must live in this file, it allows us to bind commands to ourself without creating a circular reference.  -->
            <esConverters:WeakReferenceObjectConverter x:Key="WeakReferenceObjectConverter" />
            <esModels:BindingProxy x:Key="TheHUDPageProxy" Data="{Binding ElementName=TheHUDPage, Converter={StaticResource WeakReferenceObjectConverter}}" />

            <sys:Double x:Key="FloatNegativeOne">-1</sys:Double>

            <sys:Int32 x:Key="SultanateScholarsMinNumberForHighAvailability">4</sys:Int32>

            <sys:Int32 x:Key="HKGroupNumber_0">0</sys:Int32>
            <sys:Int32 x:Key="HKGroupNumber_1">1</sys:Int32>
            <sys:Int32 x:Key="HKGroupNumber_2">2</sys:Int32>
            <sys:Int32 x:Key="HKGroupNumber_3">3</sys:Int32>
            <sys:Int32 x:Key="HKGroupNumber_4">4</sys:Int32>
            <sys:Int32 x:Key="HKGroupNumber_5">5</sys:Int32>
            <sys:Int32 x:Key="HKGroupNumber_6">6</sys:Int32>
            <sys:Int32 x:Key="HKGroupNumber_7">7</sys:Int32>
            <sys:Int32 x:Key="HKGroupNumber_8">8</sys:Int32>
            <sys:Int32 x:Key="HKGroupNumber_9">9</sys:Int32>

            <SineEase x:Key="SineEaseIn" EasingMode="EaseIn" />
            <SineEase x:Key="SineEaseOut" EasingMode="EaseOut" />

            <Duration x:Key="MapZoomAnimDuration">0:0:0.05</Duration>

            <!--  The CanIssueResultStoryboard must live in this file, the C++ code will find it and use it to animate CanIssueResult.  -->
            <Storyboard x:Key="CanIssueResultStoryboard" Storyboard.TargetProperty="Opacity">
                <DoubleAnimation From="1" To="1"
                                 Duration="0:0:1" />
                <DoubleAnimation BeginTime="0:0:1"
                                 From="1" To="0"
                                 Duration="0:0:0.5" />
            </Storyboard>


            <!--  Idle Villager Animation  -->
            <Storyboard x:Key="IdleVillagerAnimation">
                <DoubleAnimationUsingKeyFrames RepeatBehavior="Forever"
                                               Storyboard.TargetName="IdleVillager1" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.X)">
                    <SplineDoubleKeyFrame KeyTime="0" Value="0" />
                    <EasingDoubleKeyFrame KeyTime="0:0:0.9" Value="32.793">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <ExponentialEase EasingMode="EaseIn" Exponent="1" />
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                    <EasingDoubleKeyFrame KeyTime="0:0:2.1" Value="32.793">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <SineEase EasingMode="EaseOut" />
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames RepeatBehavior="Forever"
                                               Storyboard.TargetName="IdleVillager1" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)">
                    <SplineDoubleKeyFrame KeyTime="0" Value="0" />
                    <EasingDoubleKeyFrame KeyTime="0:0:0.9" Value="-28.593">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <ExponentialEase EasingMode="EaseIn" Exponent="1" />
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                    <EasingDoubleKeyFrame KeyTime="0:0:2.1" Value="-28.593">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <SineEase EasingMode="EaseOut" />
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames RepeatBehavior="Forever"
                                               Storyboard.TargetName="IdleVillager1" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)">
                    <SplineDoubleKeyFrame KeyTime="0" Value="0.8" />
                    <EasingDoubleKeyFrame KeyTime="0:0:0.9" Value="0.4">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <ExponentialEase EasingMode="EaseIn" Exponent="1" />
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                    <EasingDoubleKeyFrame KeyTime="0:0:2.1" Value="0.4">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <SineEase EasingMode="EaseOut" />
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames RepeatBehavior="Forever"
                                               Storyboard.TargetName="IdleVillager1" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)">
                    <SplineDoubleKeyFrame KeyTime="0" Value="0.8" />
                    <EasingDoubleKeyFrame KeyTime="0:0:0.9" Value="0.4">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <ExponentialEase EasingMode="EaseIn" Exponent="1" />
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                    <EasingDoubleKeyFrame KeyTime="0:0:2.1" Value="0.4">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <SineEase EasingMode="EaseOut" />
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames RepeatBehavior="Forever"
                                               Storyboard.TargetName="IdleVillager1" Storyboard.TargetProperty="(UIElement.Opacity)">
                    <SplineDoubleKeyFrame KeyTime="0" Value="1" />
                    <EasingDoubleKeyFrame KeyTime="0:0:0.4" Value="0.8">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                    <EasingDoubleKeyFrame KeyTime="0:0:0.9" Value="0.005">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <SineEase EasingMode="EaseOut" />
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                    <EasingDoubleKeyFrame KeyTime="0:0:2.1" Value="0" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames RepeatBehavior="Forever"
                                               Storyboard.TargetName="IdleVillager2" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.X)">
                    <SplineDoubleKeyFrame KeyTime="0:0:0.5" Value="0" />
                    <SplineDoubleKeyFrame KeyTime="0:0:0.6" Value="0" />
                    <EasingDoubleKeyFrame KeyTime="0:0:1.5" Value="32.793">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <ExponentialEase EasingMode="EaseIn" Exponent="1" />
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                    <EasingDoubleKeyFrame KeyTime="0:0:2.1" Value="32.793">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <SineEase EasingMode="EaseOut" />
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames RepeatBehavior="Forever"
                                               Storyboard.TargetName="IdleVillager2" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)">
                    <SplineDoubleKeyFrame KeyTime="0:0:0.5" Value="0" />
                    <SplineDoubleKeyFrame KeyTime="0:0:0.6" Value="0" />
                    <EasingDoubleKeyFrame KeyTime="0:0:1.5" Value="-28.593">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <ExponentialEase EasingMode="EaseIn" Exponent="1" />
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                    <EasingDoubleKeyFrame KeyTime="0:0:2.1" Value="-28.593">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <SineEase EasingMode="EaseOut" />
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames RepeatBehavior="Forever"
                                               Storyboard.TargetName="IdleVillager2" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)">
                    <SplineDoubleKeyFrame KeyTime="0:0:0.5" Value="0.8" />
                    <SplineDoubleKeyFrame KeyTime="0:0:0.6" Value="0.8" />
                    <EasingDoubleKeyFrame KeyTime="0:0:1.5" Value="0.4">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <ExponentialEase EasingMode="EaseIn" Exponent="1" />
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                    <EasingDoubleKeyFrame KeyTime="0:0:2.1" Value="0.4">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <SineEase EasingMode="EaseOut" />
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames RepeatBehavior="Forever"
                                               Storyboard.TargetName="IdleVillager2" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)">
                    <SplineDoubleKeyFrame KeyTime="0:0:0.5" Value="0.8" />
                    <SplineDoubleKeyFrame KeyTime="0:0:0.6" Value="0.8" />
                    <EasingDoubleKeyFrame KeyTime="0:0:1.5" Value="0.4">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <ExponentialEase EasingMode="EaseIn" Exponent="1" />
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                    <EasingDoubleKeyFrame KeyTime="0:0:2.1" Value="0.4">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <SineEase EasingMode="EaseOut" />
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames RepeatBehavior="Forever"
                                               Storyboard.TargetName="IdleVillager2" Storyboard.TargetProperty="(UIElement.Opacity)">
                    <SplineDoubleKeyFrame KeyTime="0" Value="0" />
                    <SplineDoubleKeyFrame KeyTime="0:0:0.5" Value="0" />
                    <SplineDoubleKeyFrame KeyTime="0:0:0.6" Value="1" />
                    <SplineDoubleKeyFrame KeyTime="0:0:1" Value="0.8" />
                    <EasingDoubleKeyFrame KeyTime="0:0:1.5" Value="0.005">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <SineEase EasingMode="EaseOut" />
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                    <EasingDoubleKeyFrame KeyTime="0:0:2.1" Value="0" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames RepeatBehavior="Forever"
                                               Storyboard.TargetName="IdleVillager3" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.X)">
                    <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="0" />
                    <EasingDoubleKeyFrame KeyTime="0:0:2" Value="32.793">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <ExponentialEase EasingMode="EaseIn" Exponent="1" />
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                    <SplineDoubleKeyFrame KeyTime="0:0:2.1" Value="32.793" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames RepeatBehavior="Forever"
                                               Storyboard.TargetName="IdleVillager3" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)">
                    <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="0" />
                    <EasingDoubleKeyFrame KeyTime="0:0:2" Value="-28.593">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <ExponentialEase EasingMode="EaseIn" Exponent="1" />
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                    <SplineDoubleKeyFrame KeyTime="0:0:2.1" Value="-28.593" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames RepeatBehavior="Forever"
                                               Storyboard.TargetName="IdleVillager3" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)">
                    <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="0.8" />
                    <EasingDoubleKeyFrame KeyTime="0:0:2" Value="0.4">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <ExponentialEase EasingMode="EaseIn" Exponent="1" />
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                    <SplineDoubleKeyFrame KeyTime="0:0:2.1" Value="0.4" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames RepeatBehavior="Forever"
                                               Storyboard.TargetName="IdleVillager3" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)">
                    <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="0.8" />
                    <EasingDoubleKeyFrame KeyTime="0:0:2" Value="0.4">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <ExponentialEase EasingMode="EaseIn" Exponent="1" />
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                    <SplineDoubleKeyFrame KeyTime="0:0:2.1" Value="0.4" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames RepeatBehavior="Forever"
                                               Storyboard.TargetName="IdleVillager3" Storyboard.TargetProperty="(UIElement.Opacity)">
                    <SplineDoubleKeyFrame KeyTime="0" Value="0" />
                    <EasingDoubleKeyFrame KeyTime="0:0:1.1" Value="0" />
                    <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="1" />
                    <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0.8" />
                    <EasingDoubleKeyFrame KeyTime="0:0:2" Value="0.005">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <SineEase EasingMode="EaseOut" />
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                    <EasingDoubleKeyFrame KeyTime="0:0:2.1" Value="0.005">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <SineEase EasingMode="EaseOut" />
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                </DoubleAnimationUsingKeyFrames>
                <ObjectAnimationUsingKeyFrames RepeatBehavior="Forever"
                                               Storyboard.TargetName="IdleVillager2" Storyboard.TargetProperty="(UIElement.Visibility)">
                    <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                    <DiscreteObjectKeyFrame KeyTime="0:0:2.1" Value="{x:Static Visibility.Visible}" />
                </ObjectAnimationUsingKeyFrames>
                <ObjectAnimationUsingKeyFrames RepeatBehavior="Forever"
                                               Storyboard.TargetName="IdleVillager3" Storyboard.TargetProperty="(UIElement.Visibility)">
                    <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                    <DiscreteObjectKeyFrame KeyTime="0:0:2.1" Value="{x:Static Visibility.Visible}" />
                </ObjectAnimationUsingKeyFrames>
                <ObjectAnimationUsingKeyFrames RepeatBehavior="Forever"
                                               Storyboard.TargetName="IdleVillager1" Storyboard.TargetProperty="(UIElement.Visibility)">
                    <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                    <DiscreteObjectKeyFrame KeyTime="0:0:2.1" Value="{x:Static Visibility.Visible}" />
                </ObjectAnimationUsingKeyFrames>
            </Storyboard>

            <Style x:Key="HUDHotkeyGroupTextStyle"
                   BasedOn="{StaticResource HUDGray80IssuableButtonCompletionsTextBlockStyle}"
                   TargetType="TextBlock">
                <Setter Property="Margin" Value="0,0,0,5" />
            </Style>

            <Style x:Key="IdleVillager" TargetType="Control">
                <Style.Setters>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Control" />
                        </Setter.Value>
                    </Setter>
                </Style.Setters>
                <Style.Triggers>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding SettingValueLookup[ShowIdleVillagerIcons], Source={x:Static sysConfigModels:SystemConfigModel.Instance}}" Value="True" />
                            <Condition Binding="{Binding IsIdleWorker}" Value="True" />
                            <Condition Binding="{Binding Owner.IsLocalPlayer}" Value="True" />
                        </MultiDataTrigger.Conditions>
                        <MultiDataTrigger.Setters>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Control">
                                        <Grid Name="IdleVillager" Visibility="Hidden">
                                            <Image Name="IdleVillager1"
                                                   Width="16" Height="20"
                                                   Source="pack://application:,,,/WPFGUI;component/icons/idle_zzz.png">
                                                <Image.RenderTransform>
                                                    <TransformGroup>
                                                        <ScaleTransform />
                                                        <TranslateTransform />
                                                    </TransformGroup>
                                                </Image.RenderTransform>
                                            </Image>
                                            <Image Name="IdleVillager2"
                                                   Width="16" Height="20"
                                                   Source="pack://application:,,,/WPFGUI;component/icons/idle_zzz.png">
                                                <Image.RenderTransform>
                                                    <TransformGroup>
                                                        <ScaleTransform />
                                                        <TranslateTransform />
                                                    </TransformGroup>
                                                </Image.RenderTransform>
                                            </Image>
                                            <Image Name="IdleVillager3"
                                                   Width="16" Height="20"
                                                   Source="pack://application:,,,/WPFGUI;component/icons/idle_zzz.png">
                                                <Image.RenderTransform>
                                                    <TransformGroup>
                                                        <ScaleTransform />
                                                        <TranslateTransform />
                                                    </TransformGroup>
                                                </Image.RenderTransform>
                                            </Image>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding SettingValueLookup[ShowIdleVillagerIcons], Source={x:Static sysConfigModels:SystemConfigModel.Instance}}" Value="True" />
                                                    <Condition Binding="{Binding IsIdleWorker}" Value="True" />
                                                    <Condition Binding="{Binding Owner.IsLocalPlayer}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <MultiDataTrigger.EnterActions>
                                                    <BeginStoryboard Name="IdleVillagerStoryboard" Storyboard="{StaticResource IdleVillagerAnimation}" />
                                                </MultiDataTrigger.EnterActions>
                                                <MultiDataTrigger.ExitActions>
                                                    <RemoveStoryboard BeginStoryboardName="IdleVillagerStoryboard" />
                                                </MultiDataTrigger.ExitActions>
                                                <MultiDataTrigger.Setters>
                                                    <Setter TargetName="IdleVillager" Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger.Setters>
                                            </MultiDataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </MultiDataTrigger.Setters>
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="DecoratorHeldSquads" TargetType="Control">
                <Style.Setters>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Control" />
                        </Setter.Value>
                    </Setter>
                </Style.Setters>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding HoldSlots, Converter={StaticResource GreaterCompare}, ConverterParameter=0}" Value="True">
                        <DataTrigger.Setters>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Control">
                                        <WrapPanel Margin="0,0,0,8" HorizontalAlignment="Center">
                                            <WrapPanel.Resources>
                                                <Style BasedOn="{StaticResource nHUDBodyTextBlockStyle}" TargetType="{x:Type TextBlock}" />
                                            </WrapPanel.Resources>
                                            <Image Width="14"
                                                   Margin="0,0,5,0"
                                                   Source="/WPFGUI;component/icons/garrisoned_unit.png" />
                                            <TextBlock>
                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{StaticResource LocalizedStringMultiConverter}" ConverterParameter="$11169094">
                                                        <Binding Path="HeldSquads" />
                                                        <Binding Path="HoldSlots" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </WrapPanel>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger.Setters>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="DecoratorIsBurning" TargetType="Control">
                <Style.Setters>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Control" />
                        </Setter.Value>
                    </Setter>
                </Style.Setters>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding SquadLeaderIsBurning}" Value="True">
                        <DataTrigger.Setters>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Control">
                                        <Decorator>
                                            <esControls:CircularProgressBar IsTabStop="False" Maximum="1"
                                                                            Minimum="0"
                                                                            Style="{StaticResource FireAttackIndicator}"
                                                                            Value="{Binding SquadLeaderBurnPercentage, Mode=OneWay}" />

                                        </Decorator>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger.Setters>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="DecoratorIsOnFire" TargetType="Control">
                <Style.Setters>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Control" />
                        </Setter.Value>
                    </Setter>
                </Style.Setters>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding SquadLeaderIsOnFire}" Value="True">
                        <DataTrigger.Setters>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Control">
                                        <Decorator>
                                            <esControls:CircularProgressBar IsTabStop="False" Maximum="1"
                                                                            Minimum="0"
                                                                            Style="{StaticResource BuildingOnFireIndicator}" />
                                        </Decorator>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger.Setters>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ResourceToolTipStyle" TargetType="ToolTip">
                <Setter Property="DataContext">
                    <Setter.Value>
                        <Binding Path="PlacementTarget.DataContext" RelativeSource="{RelativeSource Self}" />
                    </Setter.Value>
                </Setter>
                <Setter Property="HasDropShadow" Value="True" />
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="Placement" Value="Top" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToolTip">
                            <ContentPresenter />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <local:EventCueTitleMarginConverter x:Key="EventCueTitleMarginConverter" />

            <DataTemplate x:Key="HoldCapacity">
                <WrapPanel Margin="0,0,0,8" HorizontalAlignment="Center"
                           Visibility="{Binding HoldCapacityVisibility}">
                    <WrapPanel.Resources>
                        <Style BasedOn="{StaticResource nHUDBodyTextBlockStyle}" TargetType="{x:Type TextBlock}" />
                    </WrapPanel.Resources>
                    <WrapPanel.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0" Color="{StaticResource TertiaryColorDarkTransparent}" />
                            <GradientStop Offset="0.21" Color="{StaticResource TertiaryColorDark}" />
                            <GradientStop Offset="0.66" Color="{StaticResource TertiaryColorDark}" />
                            <GradientStop Offset="1.0" Color="{StaticResource TertiaryColorDarkTransparent}" />
                        </LinearGradientBrush>
                    </WrapPanel.Background>
                    <Image Width="{DynamicResource GarrisonIconWidth}"
                           Margin="17,0,5,0" VerticalAlignment="Center"
                           Source="{DynamicResource GarrisonIcon}" />
                    <TextBlock Margin="0,0,19,0" VerticalAlignment="Center">
                        <TextBlock.Text>
