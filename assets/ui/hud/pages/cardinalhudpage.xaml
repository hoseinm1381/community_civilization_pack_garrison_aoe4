                                                            ContentTemplate="{StaticResource GenericCallToAction}"
                                                            IsTabStop="False">
                                                <ContentControl.Resources>
                                                    <ImageSource x:Key="ImageTopCTA">../../icons/cta/warning_top.png</ImageSource>
                                                    <ImageSource x:Key="ImageBottomCTA">../../icons/cta/warning_bottom.png</ImageSource>
                                                </ContentControl.Resources>
                                            </ContentControl>
                                        </DataTemplate>
                                        <DataTemplate x:Key="cta_raised_stakes">
                                            <ContentControl Content="{Binding}"
                                                            ContentTemplate="{StaticResource GenericCallToAction}"
                                                            IsTabStop="False">
                                                <ContentControl.Resources>
                                                    <ImageSource x:Key="ImageTopCTA">../../icons/cta/raisedstakes_top.png</ImageSource>
                                                    <ImageSource x:Key="ImageBottomCTA">../../icons/cta/raisedstakes_bottom.png</ImageSource>
                                                </ContentControl.Resources>
                                            </ContentControl>
                                        </DataTemplate>
                                        <DataTemplate x:Key="cta_celebration">
                                            <ContentControl Content="{Binding}"
                                                            ContentTemplate="{StaticResource GenericCallToAction}"
                                                            IsTabStop="False">
