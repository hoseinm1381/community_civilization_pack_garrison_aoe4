                                                    <ImageSource x:Key="ImageTopCTA">../../icons/cta/celebration_top.png</ImageSource>
                                                    <ImageSource x:Key="ImageBottomCTA">../../icons/cta/celebration_bottom.png</ImageSource>
                                                </ContentControl.Resources>
                                            </ContentControl>
                                        </DataTemplate>
                                        <DataTemplate x:Key="cta_focus_change">
                                            <ContentControl Content="{Binding}"
                                                            ContentTemplate="{StaticResource GenericCallToAction}"
                                                            IsTabStop="False">
                                                <ContentControl.Resources>
                                                    <ImageSource x:Key="ImageTopCTA">../../icons/cta/focuschange_top.png</ImageSource>
                                                    <ImageSource x:Key="ImageBottomCTA">../../icons/cta/focuschange_bottom.png</ImageSource>
                                                </ContentControl.Resources>
                                            </ContentControl>
                                        </DataTemplate>
                                    </esModels:DataTemplateSourceSelector.Resources>
                                </esModels:DataTemplateSourceSelector>
                            </ContentPresenter.ContentTemplateSelector>
                        </ContentPresenter>

                        <!--  Auto Groups  -->
                        <ItemsControl IsTabStop="False" ItemsSource="{Binding AutoGroups}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style>
                                    <Setter Property="Canvas.Left" Value="-20" />
                                    <Setter Property="Canvas.Top" Value="-100" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button HorizontalAlignment="Center" VerticalAlignment="Top"
                                            esControls:ButtonHelper.DoubleClickCommand="{Binding Focus}"
                                            esControls:ButtonHelper.MouseEnterCommand="{Binding SetHovered}"
                                            esControls:ButtonHelper.MouseLeaveCommand="{Binding UnsetHovered}"
                                            esUtility:AudioAttachedProperty.PreviewMouseLeftButtonUpSound="sfx_ui_hud_inGame_button_play"
                                            Command="{Binding Select}"
                                            IsTabStop="False"
                                            Style="{StaticResource HUDBaseButtonStyle}"
                                            ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="86400000"
                                            ToolTipService.ShowOnDisabled="True">
                                        <esControls:ButtonHelper.CommandParameter>
                                            <model:PickCommandParameter PickType="{x:Static model:PickType.UserSetting}" />
                                        </esControls:ButtonHelper.CommandParameter>
                                        <Button.RenderTransform>
                                            <TranslateTransform X="{Binding Path=CentroidX}" Y="{Binding Path=Bounds.Y}" />
                                        </Button.RenderTransform>
                                        <Grid Width="{StaticResource HUDCommandCardUnitSize}" Height="{StaticResource HUDCommandCardUnitSize}">
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Style="{StaticResource HUDPrimaryColorLightTitleTextBlock18ptStyle}"
                                                       Text="{Binding Selection.Count, Mode=OneWay}"
                                                       TextAlignment="Center" />
                                        </Grid>
                                        <Button.ToolTip>
                                            <ToolTip Placement="Right" RenderTransformOrigin="0.0,0.5"
                                                     Style="{StaticResource ResourceToolTipStyle}">
                                                <ToolTip.Template>
                                                    <ControlTemplate>
                                                        <Border Padding="8,8,4,4" Background="{DynamicResource SecondaryColorDarkBrush}">
                                                            <ItemsControl VerticalAlignment="Top" ItemsSource="{Binding GroupedSelection}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <WrapPanel MaxWidth="200"
                                                                                   IsItemsHost="True" Orientation="Horizontal" />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Grid Width="{StaticResource HUDCommandCardUnitSize}"
                                                                              Height="{StaticResource HUDCommandCardUnitSize}"
                                                                              Margin="{StaticResource HUDIssuableMarginRightBelow}"
                                                                              Background="{StaticResource ButtonBackgroundBrush}">
                                                                            <Image Source="{Binding UIInfo.Icon}" />
                                                                            <TextBlock Style="{StaticResource HUDCommandCardButtonTextBlockStyle}" Text="{Binding UIInfo.Debug}" />
                                                                            <TextBlock Style="{StaticResource HUDCommandCardButtonTextBlockStyle}" Text="{Binding NumInHighlightedAutoGroupOfType}">
                                                                                <TextBlock.Visibility>
                                                                                    <Binding Converter="{StaticResource GreaterCompare}"
                                                                                             ConverterParameter="1" FallbackValue="Collapsed"
                                                                                             Path="NumInHighlightedAutoGroupOfType" />
                                                                                </TextBlock.Visibility>
                                                                            </TextBlock>
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </Border>
                                                    </ControlTemplate>
                                                </ToolTip.Template>
                                            </ToolTip>
                                        </Button.ToolTip>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel x:Name="DebugChallenges"
                                    Margin="20,300,0,0"
                                    Visibility="{Binding DebugShowingChallenges, Converter={StaticResource BoolToVis}}">
                            <TextBlock>Challenges:</TextBlock>
                            <ScrollViewer Height="400" Style="{StaticResource DefaultScrollViewerStyle}">
                                <ItemsControl Background="#33333333" IsHitTestVisible="False"
                                              IsTabStop="False"
                                              ItemsSource="{Binding LocalPlayer.ChallengeProgress}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Foreground="White">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="Challenge: {0} (id: {1}, complete: {2})">
                                                            <Binding FallbackValue="UnknownName" Path="Challenge.Name" />
                                                            <Binding Path="ProgressID" />
                                                            <Binding Path="Complete" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                                <ItemsControl Background="#66333333" IsHitTestVisible="False"
                                                              ItemsSource="{Binding Counters}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel>
                                                                <TextBlock Foreground="Cyan" Visibility="{Binding Enabled, Converter={StaticResource BoolToVis}}">
                                                                    <TextBlock.Text>
                                                                        <MultiBinding StringFormat="-&gt; Progress: {0} (enabled: {1}, complete: {2}, progress: {3})">
                                                                            <Binding FallbackValue="UnknownName" Path="Name" />
                                                                            <Binding Path="Enabled" />
                                                                            <Binding Path="Complete" />
                                                                            <Binding Path="Progress" />
                                                                        </MultiBinding>
                                                                    </TextBlock.Text>
                                                                </TextBlock>
                                                                <TextBlock Foreground="White" Visibility="{Binding Enabled, Converter={StaticResource InvBoolToVis}}">
                                                                    <TextBlock.Text>
                                                                        <MultiBinding StringFormat="-&gt; Progress: {0} (enabled: {1}, complete: {2}, progress: {3})">
                                                                            <Binding FallbackValue="UnknownName" Path="Name" />
                                                                            <Binding Path="Enabled" />
                                                                            <Binding Path="Complete" />
                                                                            <Binding Path="Progress" />
                                                                        </MultiBinding>
                                                                    </TextBlock.Text>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Canvas>

                    <!--  Objectives, Squads, Selection Cards and Command Cards  -->
