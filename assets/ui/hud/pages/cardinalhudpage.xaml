                                                               Visibility="{Binding RewardIteration, Converter={StaticResource GEqualCompare}, ConverterParameter=0, FallbackValue=Collapsed}" />

                                                        <Image x:Name="GoldProgress1"
                                                               Source="pack://application:,,,/WPFGUI;component/icons/objectives/s10_cc_gold_02.png"
                                                               Visibility="{Binding RewardIteration, Converter={StaticResource GEqualCompare}, ConverterParameter=1, FallbackValue=Collapsed}" />

                                                        <Image x:Name="GoldProgress2"
                                                               Source="pack://application:,,,/WPFGUI;component/icons/objectives/s10_cc_gold_03.png"
                                                               Visibility="{Binding RewardIteration, Converter={StaticResource GEqualCompare}, ConverterParameter=2, FallbackValue=Collapsed}" />

                                                        <Image x:Name="GoldProgress3"
                                                               Source="pack://application:,,,/WPFGUI;component/icons/objectives/s10_cc_gold_04.png"
                                                               Visibility="{Binding RewardIteration, Converter={StaticResource GEqualCompare}, ConverterParameter=3, FallbackValue=Collapsed}" />

                                                        <Image x:Name="GoldProgress4"
                                                               Source="pack://application:,,,/WPFGUI;component/icons/objectives/s10_cc_gold_05.png"
