                    <DataTemplate x:Key="event_with_player_color">
                        <Button Command="{Binding Focus}"
                                IsTabStop="False"
                                Opacity="{Binding Alpha}"
                                Style="{StaticResource PlayerColorEventCueButtonStyle}">
                            <Grid>
                                <Rectangle Height="{StaticResource EventCueMinHeight}" VerticalAlignment="Center">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Offset="0" Color="#00151824" />
                                            <GradientStop Offset="0.2" Color="#DB151824" />
                                            <GradientStop Offset="0.60" Color="#ED151824" />
                                            <GradientStop Offset="1" Color="#00151824" />
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>

                                <!--  Setting the TintEffect and changing it's color via a style creates rendering bugs in the event queue, this is why this method is used here.  -->
                                <Rectangle Height="{StaticResource EventCueMinHeight}"
                                           VerticalAlignment="Center"
                                           Opacity="{Binding Alpha}"
                                           Visibility="{Binding HasSender, Converter={StaticResource InvBoolToVis}}">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Offset="0" Color="#00FFFFFF" />
                                            <GradientStop Offset="0.54" Color="#00FFFFFF" />
                                            <GradientStop Offset="0.9" Color="#FFFFFFFF" />
                                            <GradientStop Offset="1" Color="#00FFFFFF" />
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>

                                    <Rectangle.Effect>
                                        <esEffects:TintEffect Tint="{Binding Color}" />
                                    </Rectangle.Effect>
                                </Rectangle>

                                <Rectangle Height="{StaticResource EventCueMinHeight}"
                                           VerticalAlignment="Center"
                                           Opacity="{Binding Alpha}"
                                           Visibility="{Binding HasSender, Converter={StaticResource BoolToVis}}">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Offset="0" Color="#00FFFFFF" />
                                            <GradientStop Offset="0.54" Color="#00FFFFFF" />
                                            <GradientStop Offset="0.9" Color="#FFFFFFFF" />
                                            <GradientStop Offset="1" Color="#00FFFFFF" />
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>

                                    <Rectangle.Effect>
                                        <esEffects:TintEffect Tint="{Binding SenderTeamColor}" />
                                    </Rectangle.Effect>
                                </Rectangle>

                                <DockPanel>
                                    <Image DockPanel.Dock="Right">
                                        <Image.Style>
                                            <Style BasedOn="{StaticResource DefaultEventCueImageStyle}" TargetType="Image">
                                                <Setter Property="Source" Value="{Binding Path=Icon}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Icon, Converter={StaticResource NullOrEmptyString}}" Value="True">
                                                        <Setter Property="Source" Value="/WPFGUI;component/icons/event_queue_medium_priority.png" />
                                                        <Setter Property="Stretch" Value="Uniform" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                    <TextBlock Opacity="{Binding Alpha}"
                                               Style="{StaticResource HUDDefaultEventCueTextBlockStyle}"
                                               Text="{Binding Title}" />
                                </DockPanel>
                            </Grid>
                        </Button>
                    </DataTemplate>

                    <DataTemplate x:Key="boon_event">
                        <Border HorizontalAlignment="Right"
                                Background="{StaticResource MediumPriorityCueBackground}"
                                Opacity="{Binding Alpha}">
                            <DockPanel>
                                <ContentControl Content="{Binding RogueModeBoons, Source={x:Static model:CardinalHUDModel.Instance}}"
                                                ContentTemplate="{StaticResource RogueModeBoonWidgetTemplate}"
                                                DockPanel.Dock="Right" IsHitTestVisible="True"
                                                RenderTransformOrigin="0,0">
                                    <ContentControl.RenderTransform>
                                        <TranslateTransform />
                                    </ContentControl.RenderTransform>
                                    <ContentControl.Triggers>
                                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                            <EventTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard TargetProperty="Opacity">
                                                        <DoubleAnimation To="0" Duration="0:0:0.5" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger.EnterActions>
                                        </EventTrigger>
                                    </ContentControl.Triggers>
                                </ContentControl>
                                <TextBlock Opacity="{Binding Alpha}"
                                           Style="{StaticResource HUDDefaultEventCueTextBlockStyle}"
                                           Text="{Binding Title}" />
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.Resources>

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <esControls:AnimatedPanel AnimationDuration="0:0:0.15" EasingFunction="{StaticResource QuadEaseInOut}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplateSelector>
                    <esModels:DataTemplateSourceSelector>
                        <esModels:DataTemplateSourceSelector.DefaultDataTemplate>
                            <DataTemplate>
                                <Button x:Name="upgrade_complete"
                                        Background="{StaticResource MediumPriorityCueBackground}"
                                        Command="{Binding Focus}"
                                        IsTabStop="False"
                                        Opacity="{Binding Alpha}"
                                        Style="{StaticResource DefaultEventCueButtonStyle}">
                                    <DockPanel>
                                        <Image DockPanel.Dock="Right">
                                            <Image.Style>
                                                <Style BasedOn="{StaticResource DefaultEventCueImageStyle}" TargetType="Image">
                                                    <Setter Property="Source" Value="{Binding Path=Icon}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Icon, Converter={StaticResource NullOrEmptyString}}" Value="True">
                                                            <Setter Property="Source" Value="/WPFGUI;component/icons/event_queue_medium_priority.png" />
                                                            <Setter Property="Stretch" Value="Uniform" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                        <TextBlock Foreground="{DynamicResource PrimaryColorLightBrush}"
                                                   Opacity="{Binding Alpha}"
                                                   Style="{StaticResource HUDDefaultEventCueTextBlockStyle}"
                                                   Text="{Binding Title}" />
                                    </DockPanel>
                                </Button>
                            </DataTemplate>
                        </esModels:DataTemplateSourceSelector.DefaultDataTemplate>
                    </esModels:DataTemplateSourceSelector>
                </ItemsControl.ItemTemplateSelector>
            </esControls:AnimatedItemsControl>

            <!--  Subtitles  -->
            <!--  Must appear on top of (ZIndex) the event cues, but below the chat.  -->
            <ContentControl Grid.Row="0" Grid.RowSpan="3"
                            Margin="240,0,240,0" HorizontalAlignment="Center"
                            VerticalAlignment="Bottom" Panel.ZIndex="3"
                            IsHitTestVisible="False" IsTabStop="False">
                <ContentControl.Style>
                    <Style BasedOn="{StaticResource TornEdgeContentControlStyle}" TargetType="ContentControl">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <!--  Game speech subtile on. Search for "SubtitleVisibility" in //cardinal/ui/root/sysconfig.lua for details  -->
                            <DataTrigger Binding="{Binding SettingValueLookup[SubtitleVisibility], Source={x:Static sysConfigModels:SystemConfigModel.Instance}}">
                                <DataTrigger.Value>
                                    <sys:UInt32>0</sys:UInt32>
                                </DataTrigger.Value>
                                <Setter Property="Visibility" Value="{Binding Titles.SubtitleSpeechVisibility}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Titles.SubtitleSpeechIsCharacter}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <Trigger Property="componentModel:DesignerProperties.IsInDesignMode" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
                <TextBlock VerticalAlignment="Center"
                           Opacity="{Binding Titles.SubtitleSpeechAlpha}"
                           Text="{Binding Titles.SubtitleSpeechText, Mode=OneWay}"
                           TextAlignment="Center" TextWrapping="Wrap">
                    <!--  Scale FontSize by user setting  -->
                    <TextBlock.FontSize>
                        <Binding Converter="{StaticResource MultiplyOperator}"
                                 ConverterParameter="20" Path="SettingValueLookup[CaptionScale]"
                                 Source="{x:Static sysConfigModels:SystemConfigModel.Instance}" />
                    </TextBlock.FontSize>
                    <TextBlock.LineHeight>
                        <Binding Converter="{StaticResource MultiplyOperator}"
                                 ConverterParameter="24" Path="SettingValueLookup[CaptionScale]"
                                 Source="{x:Static sysConfigModels:SystemConfigModel.Instance}" />
                    </TextBlock.LineHeight>
                    <TextBlock.Style>
                        <Style BasedOn="{StaticResource nHUDBaseTextBlockStyle}" TargetType="TextBlock">
                            <Setter Property="Margin" Value="4,0,4,3" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Path=SettingValueLookup[CaptionScale], Source={x:Static sysConfigModels:SystemConfigModel.Instance}}" Value="1.25">
                                    <Setter Property="Margin" Value="4,0,4,4" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Path=SettingValueLookup[CaptionScale], Source={x:Static sysConfigModels:SystemConfigModel.Instance}}" Value="1.5">
                                    <Setter Property="Margin" Value="4,0,4,7" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </ContentControl>

            <!--  Character Subtitles  -->
            <Grid Grid.Row="0" Grid.RowSpan="3"
                  HorizontalAlignment="Center" VerticalAlignment="Top"
                  Panel.ZIndex="3"
                  IsHitTestVisible="False">
                <Grid.Style>
                    <Style TargetType="{x:Type Grid}">
                        <Setter Property="Margin" Value="0,36,0,0" />
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Setter Property="Width" Value="800" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Titles.SubtitleSpeechIsCharacter}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <Trigger Property="componentModel:DesignerProperties.IsInDesignMode" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </Trigger>
                            <DataTrigger Binding="{Binding Path=SettingValueLookup[CaptionScale], Source={x:Static sysConfigModels:SystemConfigModel.Instance}}" Value="1.25">
                                <Setter Property="Width" Value="950" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Path=SettingValueLookup[CaptionScale], Source={x:Static sysConfigModels:SystemConfigModel.Instance}}" Value="1.5">
                                <Setter Property="Width" Value="1100" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsVisible, ElementName=Letterbox}" Value="True">
                                <Setter Property="Margin" Value="0,152,0,0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="1" Margin="-64,0,0,0">
                        <Grid Height="Auto"
                              HorizontalAlignment="Stretch" VerticalAlignment="Top"
                              Opacity="{Binding Titles.SubtitleSpeechAlpha}">
                            <Rectangle RenderTransformOrigin="0.5,0.5">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Offset="0" Color="{DynamicResource TertiaryColorDarkTransparent}" />
                                        <GradientStop Offset="0.2" Color="{DynamicResource TertiaryColorDarkTransparent80Color}" />
                                        <GradientStop Offset="0.6" Color="{DynamicResource TertiaryColorDarkTransparent80Color}" />
                                        <GradientStop Offset="1" Color="{DynamicResource TertiaryColorDarkTransparent}" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                                <Rectangle.RenderTransform>
                                    <ScaleTransform ScaleX="{Binding Titles.SubtitleSpeechAlpha}" />
                                </Rectangle.RenderTransform>
                            </Rectangle>

                            <Rectangle Height="2"
                                       Margin="0,-1,0,0" VerticalAlignment="Top"
                                       RenderTransformOrigin="0.5,0.5">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Offset="0" Color="{DynamicResource PrimaryColorDark}" />
                                        <GradientStop Offset="0.3" Color="{DynamicResource PrimaryColor}" />
                                        <GradientStop Offset="0.65" Color="{DynamicResource PrimaryColor}" />
                                        <GradientStop Offset="1" Color="{DynamicResource PrimaryColorTransparent}" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                                <Rectangle.RenderTransform>
                                    <ScaleTransform ScaleX="{Binding Titles.SubtitleSpeechAlpha}" />
                                </Rectangle.RenderTransform>
                            </Rectangle>

                            <StackPanel Margin="84,16,14,14" Orientation="Vertical">
                                <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center"
                                           Style="{StaticResource nHUDHeaderSmallTextBlockStyle}"
                                           Text="{Binding Titles.SubtitleSpeechName, Mode=OneWay}"
                                           TextAlignment="Center" TextWrapping="Wrap">
                                    <TextBlock.FontSize>
                                        <Binding Converter="{StaticResource MultiplyOperator}"
                                                 ConverterParameter="27" Path="SettingValueLookup[CaptionScale]"
                                                 Source="{x:Static sysConfigModels:SystemConfigModel.Instance}" />
                                    </TextBlock.FontSize>
                                    <TextBlock.LineHeight>
                                        <Binding Converter="{StaticResource MultiplyOperator}"
                                                 ConverterParameter="32" Path="SettingValueLookup[CaptionScale]"
                                                 Source="{x:Static sysConfigModels:SystemConfigModel.Instance}" />
                                    </TextBlock.LineHeight>
                                </TextBlock>

                                <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center"
                                           Style="{StaticResource nHUDBaseTextBlockStyle}"
                                           Text="{Binding Titles.SubtitleSpeechText, Mode=OneWay}"
                                           TextAlignment="Left" TextWrapping="Wrap">
                                    <TextBlock.FontSize>
                                        <Binding Converter="{StaticResource MultiplyOperator}"
                                                 ConverterParameter="20" Path="SettingValueLookup[CaptionScale]"
                                                 Source="{x:Static sysConfigModels:SystemConfigModel.Instance}" />
                                    </TextBlock.FontSize>
                                    <TextBlock.LineHeight>
                                        <Binding Converter="{StaticResource MultiplyOperator}"
                                                 ConverterParameter="24" Path="SettingValueLookup[CaptionScale]"
                                                 Source="{x:Static sysConfigModels:SystemConfigModel.Instance}" />
                                    </TextBlock.LineHeight>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Image Grid.Column="0"
                           Width="200" Height="200"
                           Margin="-40" VerticalAlignment="Top"
                           Opacity="{Binding Titles.SubtitleSpeechAlpha}"
                           RenderTransformOrigin="0.5,0.5"
                           Source="{Binding Titles.SubtitleSpeechIcon}">
                        <Image.RenderTransform>
                            <ScaleTransform>
                                <ScaleTransform.ScaleX>
                                    <MultiBinding Converter="{StaticResource MultiAddOperator}">
                                        <Binding Converter="{StaticResource MultiplyOperator}"
                                                 ConverterParameter="0.5" Path="Titles.SubtitleSpeechAlpha" />
                                        <Binding Mode="OneTime">
                                            <Binding.Source>
                                                <sys:Double>0.5</sys:Double>
                                            </Binding.Source>
                                        </Binding>
                                    </MultiBinding>
                                </ScaleTransform.ScaleX>
                                <ScaleTransform.ScaleY>
                                    <MultiBinding Converter="{StaticResource MultiAddOperator}">
                                        <Binding Converter="{StaticResource MultiplyOperator}"
                                                 ConverterParameter="0.5" Path="Titles.SubtitleSpeechAlpha" />
                                        <Binding Mode="OneTime">
                                            <Binding.Source>
                                                <sys:Double>0.5</sys:Double>
                                            </Binding.Source>
                                        </Binding>
                                    </MultiBinding>
                                </ScaleTransform.ScaleY>
                            </ScaleTransform>
                        </Image.RenderTransform>
                    </Image>
                </Grid>
            </Grid>
        </Grid>

        <!--  Scar  -->
        <Grid x:Name="Scar"
              d:IsHidden="True" KeyboardNavigation.TabNavigation="None">
            <Grid Visibility="{Binding TaskbarVisibleVisibility, FallbackValue=Collapsed}">
                <Grid x:Name="ScarDefault" />
                <Grid x:Name="ScarNotReplay" Visibility="{Binding IsReplay, Converter={StaticResource InvBoolToVis}, FallbackValue=Collapsed}" />
                <Grid x:Name="ScarReplay" Visibility="{Binding IsReplay, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}" />
            </Grid>
            <Grid x:Name="ScarAlwaysVisible" />
        </Grid>

        <!--  Age Up Menu and custom data contexts for specific menus  -->
        <Grid x:Name="AgeUpMenuAndDataContexts">
            <!--  Templar Age Up Data Context  -->
            <Grid x:Name="TemplarAgeUpDataContext" />

            <ContentControl x:Name="AgeUpModal"
                            Content="{Binding ModalIssuables}"
                            ContentTemplate="{StaticResource AgeUpModal}"
                            IsTabStop="False" KeyboardNavigation.TabNavigation="None"
                            Style="{StaticResource FlowControl}"
                            Visibility="{Binding ModalIssuables.Issuing, FallbackValue=Collapsed, Converter={StaticResource InvBoolToVis}}" />
        </Grid>

        <ContentControl x:Name="RogueBoonModal"
                        IsTabStop="False" KeyboardNavigation.TabNavigation="None"
                        Tag="{Binding RogueModeBoons.EventsTriggered, NotifyOnTargetUpdated=True}">
            <ContentControl.Triggers>
                <esActions:CallCommandTrigger Command="{Binding RogueModeBoons.Open, Source={x:Static model:CardinalHUDModel.Instance}}" RoutedEvent="Binding.TargetUpdated" />
            </ContentControl.Triggers>
            <ContentControl.Style>
                <Style BasedOn="{StaticResource FlowControl}" TargetType="ContentControl">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding RogueModeBoons, Converter={StaticResource NotNullConverter}}" Value="True">
                            <Setter Property="Content" Value="{Binding RogueModeBoons}" />
                            <Setter Property="ContentTemplate" Value="{StaticResource RogueModeModal}" />
                            <Setter Property="Visibility" Value="{Binding RogueModeBoons.IsOpened, Converter={StaticResource BooleanToHiddenVisibilityConverter}}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>

        <!--  top right corner stuff  -->
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top"
                    KeyboardNavigation.TabNavigation="None" Orientation="Horizontal">
            <!--
                The saving game indicator - this is supposed to appear to the left of the diplomacy button only
                when it is being shown but that's hard since it's created by scar ui (above), so for now always
                showing to the left of a grid with the right size and will figure out movement in phase two
            -->
            <Grid Visibility="{Binding IsSaving, Converter={StaticResource BoolToVisDesignModeOn}}">
                <Ellipse Width="56"
                         Height="{Binding Width, RelativeSource={RelativeSource Self}}"
                         HorizontalAlignment="Center" VerticalAlignment="Top"
                         Fill="{StaticResource ScrimBrush}" />
                <esControls:CircularProgressBar Width="48"
                                                Margin="4" HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                InnerRadius="21" IsTabStop="False"
                                                Maximum="100" Minimum="0"
                                                OuterRadius="24"
                                                Style="{StaticResource Spinner}" />
            </Grid>
            <!--  spacer only shows in design mode as demonstrates where the diplomacy button would appear  -->
            <Grid HorizontalAlignment="Right" VerticalAlignment="Top"
                  Background="Cyan">
                <Grid Width="80" Height="40"
                      Margin="0,10,30,2"
                      Background="Magenta">
                    <Image Width="42"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Source="pack://application:,,,/WPFGUI;component/icons/diplomacy.png" />
                </Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Hidden" />
                        <Style.Triggers>
                            <Trigger Property="componentModel:DesignerProperties.IsInDesignMode" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
            </Grid>
        </StackPanel>

        <!--
            Victory/Defeat/Elimination Stinger Blend Animation.
            This decides which animation is to be used.
            The Localised text Victory/defeat is set directly from the StingerItemModel within ContentTemplate.
            We use a frame and set the source to avoid loading the banners during gameplay to save memory.
        -->
        <Frame Focusable="False">
            <Frame.Style>
                <Style TargetType="{x:Type Frame}">
                    <Setter Property="Source" Value="{x:Null}" />
                    <Style.Triggers>
                        <!--  Victory stinger  -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Stingers.HasStinger}" Value="True" />
                                <Condition Binding="{Binding Stingers.CurrentStinger.DataTemplate}" Value="stinger_victory" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Source" Value="/WPFGUI;component/HUD/Controls/XboxVictoryStingerControl.xaml" />
                        </MultiDataTrigger>

                        <!--  Defeat stinger  -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Stingers.HasStinger}" Value="True" />
                                <Condition Binding="{Binding Stingers.CurrentStinger.DataTemplate}" Value="stinger_defeat" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Source" Value="/WPFGUI;component/HUD/Controls/XboxDefeatStingerControl.xaml" />
                        </MultiDataTrigger>

                        <!--  Endless mode stinger  -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Stingers.HasStinger}" Value="True" />
                                <Condition Binding="{Binding Stingers.CurrentStinger.DataTemplate}" Value="RogueModeEndlessModeStinger" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Source" Value="/WPFGUI;component/HUD/Controls/XboxRogueEndlessModeStingerControl.xaml" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Frame.Style>
        </Frame>

        <!--  Continue Button  -->
        <Grid Height="1080"
              HorizontalAlignment="Center"
              KeyboardNavigation.TabNavigation="Continue"
              Visibility="{Binding IsSpectatingMap, Converter={StaticResource BoolToVis}}">
            <Ellipse Width="350" Height="175"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Opacity="0">
                <Ellipse.RenderTransform>
                    <TransformGroup>
                        <TranslateTransform Y="-430" />
                    </TransformGroup>
                </Ellipse.RenderTransform>
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.5,0.5">
                        <GradientStop Offset="0" Color="{DynamicResource PrimaryColorLight}" />
                        <GradientStop Offset="1" Color="{DynamicResource TertiaryColorExtraLightTransparent}" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.Style>
                    <Style TargetType="{x:Type FrameworkElement}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsVisible, RelativeSource={RelativeSource Self}}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <!--  Opacity fade in and out  -->
                                            <DoubleAnimation BeginTime="0:0:1"
                                                             Storyboard.TargetProperty="Opacity" From="0"
                                                             To="1" Duration="0:0:0.4" />
                                            <DoubleAnimation BeginTime="0:0:1.4"
                                                             Storyboard.TargetProperty="Opacity" From="1"
                                                             To="0" Duration="0:0:0.8" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Ellipse.Style>
            </Ellipse>

            <!--  DisableEnterChatToggleWhenKeyboardFocused tag is used by the HUDPage to avoid any conflit with the chat toggle  -->
            <esControls:ScreenReader Style="{StaticResource DefaultScreenReaderStyle}">
                <Button x:Name="ContinueButton"
                        MinWidth="180"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        AutomationProperties.ItemType="{esUtility:LocString $11192481}"
                        AutomationProperties.Name="{esUtility:LocString $11220587}"
                        Command="{Binding Commands.ContinueToPostGameScreen}"
                        Content="{esUtility:LocString $11220587}"
                        Opacity="0" RenderTransformOrigin="0.5,0.5"
                        Tag="DisableEnterChatToggleWhenKeyboardFocused">
                    <Button.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="2" ScaleY="2" />
                            <TranslateTransform Y="-430" />
                        </TransformGroup>
                    </Button.RenderTransform>
                    <Button.Style>
                        <Style BasedOn="{StaticResource HUDPrimaryRaisedTextButton}" TargetType="{x:Type Button}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsVisible, RelativeSource={RelativeSource Self}}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <!--  Scale  -->
                                                <DoubleAnimation BeginTime="0:0:1"
                                                                 Storyboard.TargetProperty="RenderTransform.(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" From="2"
                                                                 To="1" Duration="0:0:0.25">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CircleEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation BeginTime="0:0:1"
                                                                 Storyboard.TargetProperty="RenderTransform.(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" From="2"
                                                                 To="1" Duration="0:0:0.25">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CircleEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>

                                                <!--  Opacity  -->
                                                <DoubleAnimation BeginTime="0:0:1"
                                                                 Storyboard.TargetProperty="Opacity" From="0"
                                                                 To="1" Duration="0:0:0.20" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </esControls:ScreenReader>
        </Grid>

        <!--  Replay  -->
        <Grid Visibility="{Binding IsReplay, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
            <Decorator Visibility="{Binding ReplayControlVisibility}">
                <!--  Stat viewer  -->
                <!--  The Replay stats viewer get its own DataContext via code, keep the visibility binding on the decorator above.  -->
                <ContentControl x:Name="ReplayStatViewer"
                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                Content="{Binding}"
                                ContentTemplate="{StaticResource ReplayStatViewerDataTemplate}" />
            </Decorator>

            <ContentControl Name="ReplayControl"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Content="{Binding}"
                            ContentTemplate="{StaticResource PlaybackControlTemplate}" />
        </Grid>

        <Grid x:Name="CaptureToolParent" d:IsHidden="True" />


        <esControls:Letterbox x:Name="Letterbox"
                              AspectRatio="{Binding Titles.LetterboxFadeAspectRatio}"
                              Fill="{Binding Titles.LetterboxFadeColor, Converter={StaticResource SolidColorBrushConverter}}"
                              Opacity="{Binding Titles.LetterboxFadeAlpha}"
                              Visibility="{Binding Titles.LetterboxFadeVisibility, FallbackValue=Collapsed}" />

        <Grid Background="{Binding Titles.ScreenFadeColor, Converter={StaticResource SolidColorBrushConverter}}"
              Opacity="{Binding Titles.ScreenFadeAlpha}"
              Visibility="{Binding Titles.ScreenFadeVisibility, FallbackValue=Collapsed}" />

        <esControls:VideoPlayerControl x:Name="HUDVideoPlayerControl"
                                       HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                       Visibility="Collapsed">
            <esControls:VideoPlayerControl.Style>
                <Style TargetType="{x:Type esControls:VideoPlayerControl}">
                    <Style.Setters>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type esControls:VideoPlayerControl}">
                                    <Grid Background="Black">
                                        <!--  The video itself  -->
                                        <MediaElement Name="PART_MediaElement"
                                                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                      LoadedBehavior="Play"
                                                      Source="{TemplateBinding SourceFilePath}" />

                                        <!--  Subtitles  -->
                                        <timedText:TimedTextCaptions Name="PART_Captions"
                                                                     HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                                     Style="{StaticResource DefaultTimedTextCaptionsStyle}" />
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style.Setters>
                </Style>
            </esControls:VideoPlayerControl.Style>
        </esControls:VideoPlayerControl>

        <!--  This is shared by normal game and replay. Disable chat input and change postion and size for replay  -->
        <esControls:ScreenReader Height="{Binding ActualHeight, ElementName=ChatHeightProxy}"
                                 Margin="0,60,15,20" HorizontalAlignment="Right"
                                 VerticalAlignment="Top" Panel.ZIndex="4"
                                 Style="{StaticResource DefaultScreenReaderStyle}">
            <eHUDControls:ChatControl x:Name="Chat"
                                      Width="{wm:UserDIP 400}"
                                      esUtility:Telemetry.Name="ChatInGame" AlternationCount="9999999"
                                      AutoHideTimerInterval="5" AutoScrollResetPeriod="5.0"
                                      DataContext="{Binding}"
                                      Focusable="False"
                                      ItemTemplate="{StaticResource HUDChatMessageDataTemplate}"
                                      ItemsSource="{Binding Chat}">
                <eHUDControls:ChatControl.Visibility>
                    <MultiBinding Converter="{StaticResource MultiLogicalNot}"
                                  ConverterParameter="False" FallbackValue="Collapsed">
                        <Binding Path="IsReplay" />
                        <Binding Path="IsMatchStatsModalActive" />
                    </MultiBinding>
                </eHUDControls:ChatControl.Visibility>
                <eHUDControls:ChatControl.Triggers>
                    <EventTrigger RoutedEvent="eHUDControls:ChatControl.Unloaded">
                        <esActions:SilenceChannelTextToSpeechAction SpeechChannelID="{StaticResource MatchSpeechChannel}" />
                    </EventTrigger>

                    <EventTrigger RoutedEvent="eHUDControls:ChatControl.Loaded">
                        <esActions:ChatControlLoadedAction />
                    </EventTrigger>

                    <EventTrigger RoutedEvent="eHUDControls:ChatControl.ChannelChanged">
                        <!--  $11203742: %1Channel% chat  -->
                        <esActions:TextToSpeechAction Setting="UIElementNarration" Text="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=eHUDControls:ChatControl}, Path=Channel, Converter={StaticResource LocalizedStringConverter}, ConverterParameter=$11203742}" />
                    </EventTrigger>
                </eHUDControls:ChatControl.Triggers>
                <eHUDControls:ChatControl.Style>
                    <Style BasedOn="{StaticResource HUDChatControlStyle}" TargetType="eHUDControls:ChatControl">
                        <Style.Triggers>
                            <Trigger Property="IsChatInputActive" Value="True">
                                <Trigger.EnterActions>
                                    <!--  $11203743: Chat window opened. %1Channel% chat.  -->
                                    <esActions:TextToSpeechAction Setting="UIElementNarration"
                                                                  StringFormat="{esUtility:LocString $11203743}"
                                                                  TextPropertyName="Channel" />
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <!--  $11203744: Chat window closed  -->
                                    <esActions:TextToSpeechAction Setting="UIElementNarration" Text="{esUtility:LocString $11203744}" />
                                </Trigger.ExitActions>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </eHUDControls:ChatControl.Style>
            </eHUDControls:ChatControl>
        </esControls:ScreenReader>

        <Grid Margin="0,-1,0,1"
              d:IsHidden="True" Background="Transparent"
              IsHitTestVisible="{Binding IsInputBlockerEnabled}" />

        <Grid Margin="0,-1,0,1"
              d:IsHidden="True" Background="Transparent"
              IsHitTestVisible="True"
              Visibility="{Binding MPPause.PauseExecutorInfo, Converter={StaticResource NotNullToVis}, FallbackValue=Collapsed}">
            <Rectangle Fill="{DynamicResource TertiaryColorGradientAngledBrush}"
                       Focusable="False" Opacity="0.8" />
            <ContentControl HorizontalAlignment="Center" VerticalAlignment="Center"
                            Content="{Binding MPPause}"
                            IsTabStop="False"
                            Style="{StaticResource MultiplayerPausePanel}" />
        </Grid>

        <Decorator VerticalAlignment="Bottom"
                   d:IsHidden="True" IsHitTestVisible="False"
                   Style="{StaticResource FlowControl}">
            <Grid x:Name="NIS"
                  Margin="0,0,48,48" HorizontalAlignment="Right"
                  Background="{StaticResource DualFadeGradientBackground}"
                  RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="0.75" ScaleY="0.75" />
                        <TranslateTransform Y="100" />
                    </TransformGroup>
                </Grid.RenderTransform>

                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="Visibility" Value="Hidden" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Path=SkipNISIndicatorVisibility, ElementName=TheHUDPage, Converter={StaticResource IsEqualConverter}, ConverterParameter={x:Static Visibility.Visible}}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard Storyboard="{StaticResource SkipButtonInAnimation}" />
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard Storyboard="{StaticResource SkipButtonOutAnimation}" />
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <StackPanel Margin="24,8" Orientation="Horizontal">
                    <TextBlock Margin="0,0,16,0" VerticalAlignment="Center"
                               Style="{StaticResource HUDWhiteSubtitleAltTextBlock18ptStyle}"
                               Text="{esUtility:LocString $11195919}" />

                    <esControls:CircularProgressBar VerticalAlignment="Center"
                                                    InnerRadius="18" IsTabStop="False"
                                                    Maximum="1.0" Minimum="0"
                                                    OuterRadius="22"
                                                    Style="{StaticResource FrontEndCircularProgressBarNoText}"
                                                    Value="{Binding SkipNISProgress, ElementName=TheHUDPage, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </Decorator>

        <!--  System Messages triggered when game paused or UI_SystemMessageShow  -->
        <Grid IsHitTestVisible="False">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility">
                        <Setter.Value>
                            <MultiBinding Converter="{StaticResource MultiLogicalOr}" FallbackValue="Collapsed">
                                <Binding Converter="{StaticResource NotNullOrEmptyString}" Path="Message" />
                                <Binding Converter="{StaticResource NotNullOrEmptyString}" Path="ReplayMessage" />
                            </MultiBinding>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMessageVisible}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <ContentControl HorizontalAlignment="Center" VerticalAlignment="Center"
                            IsTabStop="False"
                            Style="{StaticResource TornEdgeContentControlStyle}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Orientation="Vertical">
                    <TextBlock MaxWidth="720" MaxHeight="110"
                               HorizontalAlignment="Left" VerticalAlignment="Center"
                               Style="{StaticResource nHUDBaseLargeTextBlockStyle}"
                               Text="{Binding Message}"
                               TextAlignment="Center" TextTrimming="CharacterEllipsis"
                               TextWrapping="Wrap" />
                    <TextBlock MaxWidth="720" MaxHeight="110"
                               HorizontalAlignment="Left" VerticalAlignment="Center"
                               Style="{StaticResource nHUDBaseLargeTextBlockStyle}"
                               Text="{Binding ReplayMessage}"
                               TextAlignment="Center" TextTrimming="CharacterEllipsis"
                               TextWrapping="Wrap" />
                </StackPanel>
            </ContentControl>
        </Grid>
        <Grid x:Name="Dialogs" d:IsHidden="True" />

        <!--  Debug Relic Radial Menu  -->
        <ContentControl Content="{Binding RelicRadialMenuGroups[contextual_menu]}"
                        ContentTemplate="{StaticResource DebugRelicRadialMenuTemplate}"
                        Visibility="{esUtility:CommandArgumentToVis debug_relic_radial_menu}" />



    </Grid>

</eHUDPages:HUDPage>
