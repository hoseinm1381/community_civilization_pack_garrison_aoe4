        <esPages:PlatKeyBinding Binding="rotate_cw_45"
                                Command="{Binding Commands.Orbit, Source={x:Static model:HUDModel.Instance}}"
                                CommandParameter="{StaticResource FloatNegativeOne}"
                                CommandSound="sfx_ui_hud_inGame_button_mapRotateRight_play" Group="camera" />
        <esPages:PlatKeyBinding Binding="zoom_in"
                                Command="{Binding Commands.ZoomIn, Source={x:Static model:HUDModel.Instance}}"
                                CommandSound="" Group="camera" />
        <esPages:PlatKeyBinding Binding="zoom_out"
                                Command="{Binding Commands.ZoomOut, Source={x:Static model:HUDModel.Instance}}"
                                CommandSound="" Group="camera" />


        <!--  handled by CameraStateMachine - pan, orbit, pan_left, pan_right, pan_up, pan_down, screen_pan_left, etc  -->

        <!--  SALISBURY-XBOX-PROTOTYPE  -->
        <esPages:PlatKeyBinding Binding="contextual_command"
                                Command="{Binding Commands.ContextualCommand, Source={x:Static model:HUDModel.Instance}}"
                                Group="hud_unit_control" />
        <esPages:PlatKeyBinding Binding="add_automated_town_center"
                                Command="{Binding Commands.AddAutomatedTownCenter, Source={x:Static model:HUDModel.Instance}}"
                                Group="hud_unit_control" />
        <esPages:PlatKeyBinding Binding="remove_automated_town_center"
                                Command="{Binding Commands.RemoveAutomatedTownCenter, Source={x:Static model:HUDModel.Instance}}"
                                Group="hud_unit_control" />
        <esPages:PlatKeyBinding Binding="cycle_formation"
                                Command="{Binding Commands.CycleFormation, Source={x:Static model:HUDModel.Instance}}"
                                Group="hud_unit_control" />
        <esPages:PlatKeyBinding Binding="snap_to_alert"
                                Command="{Binding Commands.SnapToAlert, Source={x:Static model:HUDModel.Instance}}"
                                Group="hud_unit_control" />
        <!--  SALISBURY-XBOX-PROTOTYPE - Automate Villagers Binding  -->
        <esPages:PlatKeyBinding Binding="automate_villagers"
                                Command="{Binding Commands.AutomateVillagers, Source={x:Static model:HUDModel.Instance}}"
                                Group="hud_unit_control" />

        <esPages:PlatKeyBinding Binding="global_ability_1"
                                Command="{Binding LocalPlayer.GlobalAbilities.Abilities[0].Issue, Source={x:Static model:HUDModel.Instance}}"
                                Group="hud_game"
                                IsEnabled="{Binding LocalPlayer.GlobalAbilities.IsAvailable, Source={x:Static model:HUDModel.Instance}}" />


        <esPages:PlatKeyBinding Binding="global_ability_2"
                                Command="{Binding LocalPlayer.GlobalAbilities.Abilities[1].Issue, Source={x:Static model:HUDModel.Instance}}"
                                Group="hud_game"
                                IsEnabled="{Binding LocalPlayer.GlobalAbilities.IsAvailable, Source={x:Static model:HUDModel.Instance}}" />


        <esPages:PlatKeyBinding Binding="global_ability_3"
                                Command="{Binding LocalPlayer.GlobalAbilities.Abilities[2].Issue, Source={x:Static model:HUDModel.Instance}}"
                                Group="hud_game"
                                IsEnabled="{Binding LocalPlayer.GlobalAbilities.IsAvailable, Source={x:Static model:HUDModel.Instance}}" />


        <esPages:PlatKeyBinding Binding="global_ability_4"
                                Command="{Binding LocalPlayer.GlobalAbilities.Abilities[3].Issue, Source={x:Static model:HUDModel.Instance}}"
                                Group="hud_game"
                                IsEnabled="{Binding LocalPlayer.GlobalAbilities.IsAvailable, Source={x:Static model:HUDModel.Instance}}" />

    </eHUDPages:HUDPage.PlatKeyBindings>

    <Grid>

        <!--  change CustomClampMargin for defining the clamping area of training TagAdorner  -->
        <AdornerDecorator esControls:TagAdornerHelper.CustomClampMargin="0,0,150,330" KeyboardNavigation.TabNavigation="None">
            <Grid>
                <!--  Issuable error messages  -->
                <Grid x:Name="CanIssueResult"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      Panel.ZIndex="1"
                      IsHitTestVisible="False" Opacity="0"
                      Visibility="{Binding SettingValueLookup[ShowCanIssueResult], Source={x:Static sysConfigModels:SystemConfigModel.Instance}, Converter={StaticResource BoolToVis}}">
                    <Border MinWidth="320" MaxWidth="640"
                            Padding="8">
                        <Border.Background>
                            <LinearGradientBrush>
                                <GradientStop Offset="0" Color="{DynamicResource ErrorColorBrightTransparent}" />
                                <GradientStop Offset="0.3" Color="{DynamicResource ErrorColorBright}" />
                                <GradientStop Offset="0.5" Color="{DynamicResource TertiaryColorDark}" />
                                <GradientStop Offset="0.85" Color="{DynamicResource TertiaryColorDark}" />
                                <GradientStop Offset="1" Color="{DynamicResource TertiaryColorDarkTransparent}" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <DockPanel>
                            <Image Width="56"
                                   Margin="-10,-12,10,-12" HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   DockPanel.Dock="Left" Source="../../icons/high_priority_large_cant.png" />
                            <TextBlock x:Name="CanIssueResultText"
                                       MaxWidth="820"
                                       HorizontalAlignment="Left" VerticalAlignment="Center"
                                       DockPanel.Dock="Right"
                                       Style="{StaticResource nHUDBaseLargeTextBlockStyle}"
                                       TextAlignment="Left" TextTrimming="CharacterEllipsis"
                                       TextWrapping="Wrap" />
                        </DockPanel>

                    </Border>
                </Grid>


                <Canvas x:Name="ScreenLeft"
                        esControls:TagAdorner.AlignmentMode="Relative"
                        esControls:TagAdorner.ArrowDataTemplate="{StaticResource TagArrowDataTemplate}"
                        esControls:TagAdorner.DataTemplate="{StaticResource TagDataTemplate}"
                        esControls:TagAdorner.HorizontalAnchor="Left" esControls:TagAdorner.HorizontalPlacement="Right"
                        esControls:TagAdorner.TargetDataTemplate="{StaticResource EmptyTagDataTemplate}"
                        esControls:TagAdorner.VerticalAnchor="Center" esControls:TagAdorner.VerticalPlacement="Center">
                    <esControls:TagAdorner.IsTagged>
                        <MultiBinding Converter="{StaticResource IsTaggedConverter}" ConverterParameter="ScreenLeft">
                            <Binding Path="TagVersion" />
                        </MultiBinding>
                    </esControls:TagAdorner.IsTagged>
                    <esControls:TagAdorner.Data>
                        <MultiBinding Converter="{StaticResource TagDataConverter}" ConverterParameter="ScreenLeft">
                            <Binding Path="TagVersion" />
                        </MultiBinding>
                    </esControls:TagAdorner.Data>
                </Canvas>

                <Canvas x:Name="ScreenRight"
                        esControls:TagAdorner.AlignmentMode="Relative"
                        esControls:TagAdorner.ArrowDataTemplate="{StaticResource TagArrowDataTemplate}"
                        esControls:TagAdorner.DataTemplate="{StaticResource TagDataTemplate}"
                        esControls:TagAdorner.HorizontalAnchor="Right" esControls:TagAdorner.HorizontalPlacement="Left"
                        esControls:TagAdorner.TargetDataTemplate="{StaticResource EmptyTagDataTemplate}"
                        esControls:TagAdorner.VerticalAnchor="Center" esControls:TagAdorner.VerticalPlacement="Center">
                    <esControls:TagAdorner.IsTagged>
                        <MultiBinding Converter="{StaticResource IsTaggedConverter}" ConverterParameter="ScreenRight">
                            <Binding Path="TagVersion" />
                        </MultiBinding>
                    </esControls:TagAdorner.IsTagged>
                    <esControls:TagAdorner.Data>
                        <MultiBinding Converter="{StaticResource TagDataConverter}" ConverterParameter="ScreenRight">
                            <Binding Path="TagVersion" />
                        </MultiBinding>
                    </esControls:TagAdorner.Data>
                </Canvas>

                <Canvas x:Name="ScreenUp"
                        esControls:TagAdorner.AlignmentMode="Relative"
                        esControls:TagAdorner.ArrowDataTemplate="{StaticResource TagArrowDataTemplate}"
                        esControls:TagAdorner.DataTemplate="{StaticResource TagDataTemplate}"
                        esControls:TagAdorner.HorizontalAnchor="Center" esControls:TagAdorner.HorizontalPlacement="Center"
                        esControls:TagAdorner.TargetDataTemplate="{StaticResource EmptyTagDataTemplate}"
                        esControls:TagAdorner.VerticalAnchor="Top" esControls:TagAdorner.VerticalPlacement="Bottom">
                    <esControls:TagAdorner.IsTagged>
                        <MultiBinding Converter="{StaticResource IsTaggedConverter}" ConverterParameter="ScreenUp">
                            <Binding Path="TagVersion" />
                        </MultiBinding>
                    </esControls:TagAdorner.IsTagged>
                    <esControls:TagAdorner.Data>
                        <MultiBinding Converter="{StaticResource TagDataConverter}" ConverterParameter="ScreenUp">
                            <Binding Path="TagVersion" />
                        </MultiBinding>
                    </esControls:TagAdorner.Data>
                </Canvas>

                <Canvas x:Name="ScreenDown"
                        esControls:TagAdorner.AlignmentMode="Relative"
                        esControls:TagAdorner.ArrowDataTemplate="{StaticResource TagArrowDataTemplate}"
                        esControls:TagAdorner.DataTemplate="{StaticResource TagDataTemplate}"
                        esControls:TagAdorner.HorizontalAnchor="Center" esControls:TagAdorner.HorizontalPlacement="Center"
                        esControls:TagAdorner.TargetDataTemplate="{StaticResource EmptyTagDataTemplate}"
                        esControls:TagAdorner.VerticalAnchor="Bottom" esControls:TagAdorner.VerticalPlacement="Top">
                    <esControls:TagAdorner.IsTagged>
                        <MultiBinding Converter="{StaticResource IsTaggedConverter}" ConverterParameter="ScreenDown">
                            <Binding Path="TagVersion" />
                        </MultiBinding>
                    </esControls:TagAdorner.IsTagged>
                    <esControls:TagAdorner.Data>
                        <MultiBinding Converter="{StaticResource TagDataConverter}" ConverterParameter="ScreenDown">
                            <Binding Path="TagVersion" />
                        </MultiBinding>
                    </esControls:TagAdorner.Data>
                </Canvas>

                <Canvas x:Name="Input"
                        esControls:TagAdorner.AlignmentMode="Cursor"
                        esControls:TagAdorner.ArrowDataTemplate="{StaticResource TagArrowDataTemplate}"
                        esControls:TagAdorner.ClampMode="Custom"
                        esControls:TagAdorner.DataTemplate="{StaticResource TagDataTemplate}"
                        esControls:TagAdorner.HorizontalAnchor="Left" esControls:TagAdorner.HorizontalPlacement="Right"
                        esControls:TagAdorner.TargetDataTemplate="{StaticResource EmptyTagDataTemplate}"
                        esControls:TagAdorner.VerticalAnchor="Center" esControls:TagAdorner.VerticalPlacement="Center"
                        Background="Transparent"
                        FocusVisualStyle="{x:Null}"
                        Focusable="True">
                    <esControls:TagAdorner.IsTagged>
                        <MultiBinding Converter="{StaticResource IsTaggedConverter}" ConverterParameter="Cursor">
                            <Binding Path="TagVersion" />
                        </MultiBinding>
                    </esControls:TagAdorner.IsTagged>
                    <esControls:TagAdorner.Data>
                        <MultiBinding Converter="{StaticResource TagDataConverter}" ConverterParameter="Cursor">
                            <Binding Path="TagVersion" />
                        </MultiBinding>
                    </esControls:TagAdorner.Data>
                </Canvas>

                <Grid x:Name="Simulation">
                    <eHUDControls:CompassControl IsHitTestVisible="False" IsTabStop="False"
                                                 ItemsSource="{Binding ThreatGroups}"
                                                 PositionPropertyName="ProjectedPosition"
                                                 Version="{Binding ThreatGroups.Version}">
                        <eHUDControls:CompassControl.Resources>
                            <Style x:Key="ThreatGroupArrow" TargetType="FrameworkElement">
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="{Binding Angle, RelativeSource={RelativeSource FindAncestor, AncestorType=eHUDControls:CompassItem}, Mode=OneWay}" />
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Path=IsOnScreen, RelativeSource={RelativeSource FindAncestor, AncestorType=eHUDControls:CompassItem}, Mode=OneWay}" Value="true">
                                        <!--  Do not use Collapsed. Otherwise, it could change the size of compass item and casue trouble calculating on-screen information near the screen edges  -->
                                        <Setter Property="Visibility" Value="Hidden" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </eHUDControls:CompassControl.Resources>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <eHUDControls:CompassCanvas Padding="242,84,-165,291" ChildVerticalAlignment="Bottom" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplateSelector>
                            <esModels:DataTemplateSourceSelector Optional="True">
                                <esModels:DataTemplateSourceSelector.DefaultDataTemplate>
                                    <DataTemplate>
                                        <Image Width="70" Height="70"
                                               Margin="-25,-25,0,0"
                                               Source="../../icons/threat_group_arrow.png"
                                               Style="{StaticResource ThreatGroupArrow}" />
                                    </DataTemplate>
                                </esModels:DataTemplateSourceSelector.DefaultDataTemplate>
                            </esModels:DataTemplateSourceSelector>
                        </ItemsControl.ItemTemplateSelector>
                    </eHUDControls:CompassControl>

                    <esControls:PositionCanvasItemsControl esControls:RecyclingItemsControl.RecyclingLimit="300"
                                                           IsHitTestVisible="{Binding DecoratorsAreHitTestVisible}"
                                                           IsTabStop="False"
                                                           ItemsSource="{Binding UnoptimizedDecorators}"
                                                           PositionPropertyName="ProjectedPosition"
                                                           Version="{Binding UnoptimizedDecorators.Version}">
                        <ItemsControl.Resources>
                            <!--  Default Garrison icon for garrison units UI  -->
                            <ImageSource x:Key="GarrisonIcon">/WPFGUI;component/icons/garrisoned_unit.png</ImageSource>
                            <sys:Double x:Key="GarrisonIconWidth">14</sys:Double>
                            <Thickness x:Key="GarrisonIconMargin">0,0,5,0</Thickness>

                            <DataTemplate DataType="{x:Type model:SquadDecoratorModel}" />

                            <!--  Shared by structure decorator and its derived models  -->
                            <DataTemplate x:Key="EntityStructureDecoratorTemplate" DataType="{x:Type model:EntityStructureDecoratorModel}">
                                <StackPanel Orientation="Vertical">
                                    <!--  Healing indicator  -->
                                    <Image Width="52" Source="pack://application:,,,/WPFGUI;component/icons/buffs/buff_generator_heal.png">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Entity.StateModel.Int[healing_count], Converter={StaticResource GreaterCompare}, ConverterParameter=0}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard Storyboard="{StaticResource BuffPulseAnimation}" />
                                                        </DataTrigger.EnterActions>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                    <!--  Influence Bonus  -->
                                    <Image Source="pack://application:,,,/WPFGUI;component/icons/influence_decorator.png" Visibility="{Binding Entity.Influenced, Converter={StaticResource BoolToVis}}" />
                                    <!--  Control Group Number  -->
                                    <TextBlock Margin="0,0,0,5" HorizontalAlignment="Center"
                                               Style="{StaticResource nHUDBaseSmallTextBlockStyle}"
                                               Text="{Binding Entity.HotkeyGroups}" />
                                    <Grid>
                                        <!--  fire attack indicator  -->
                                        <Decorator Visibility="{Binding Entity.IsSmouldering, Converter={StaticResource BoolToVis}}">
                                            <esControls:CircularProgressBar IsTabStop="False" Maximum="1"
                                                                            Minimum="0"
                                                                            Style="{StaticResource FireAttackIndicator}"
                                                                            Value="{Binding Entity.BurnPercentage, Mode=OneWay}" />

                                        </Decorator>

                                        <!--  building on fire indicator  -->
                                        <Decorator Visibility="{Binding Entity.IsOnFire, Converter={StaticResource BoolToVis}}">
                                            <esControls:CircularProgressBar IsTabStop="False" Maximum="1"
                                                                            Minimum="0"
                                                                            Style="{StaticResource BuildingOnFireIndicator}" />
                                        </Decorator>

                                        <!--  Self-repair  -->
                                        <Decorator Visibility="{Binding Entity.StateModel.Float[show_self_repairing_ui], Converter={StaticResource NumberToVis}, FallbackValue=Collapsed}">
                                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource SelfRepair}" />
                                        </Decorator>
                                    </Grid>

                                    <ContentControl Content="{Binding Entity}"
                                                    ContentTemplate="{StaticResource HoldCapacity}"
                                                    IsTabStop="False"
                                                    Visibility="{Binding Entity.HoldEnabled, Converter={StaticResource BoolToVis}}" />
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      Content="{Binding}"
                                                      ContentTemplate="{StaticResource MonasteryRelicDecoratorTemplate}" />
                                    <ProgressBar Width="{StaticResource BuildingHealthbarWidth}" Style="{StaticResource HealthBarDecoratorStyle}" />
                                    <ProgressBar Width="{StaticResource BuildingHealthbarWidth}"
                                                 Height="{StaticResource BuildingHealthbarHeight}"
                                                 Opacity="{Binding SelectionOpacity}"
                                                 Template="{StaticResource ConstructionProgressBar}"
                                                 Visibility="{Binding ProductionVisibility, FallbackValue=Collapsed}"
                                                 Value="{Binding ProductionProgress, Mode=OneWay}" />
                                    <ProgressBar Width="{StaticResource BuildingHealthbarWidth}"
                                                 Height="{StaticResource BuildingHealthbarHeight}"
                                                 Template="{StaticResource ConstructionProgressBar}"
                                                 Visibility="{Binding Entity.StateModel.Float[UI_Progress], Converter={StaticResource NumberToVis}, FallbackValue=Collapsed}"
                                                 Value="{Binding Entity.StateModel.Float[UI_Progress], Mode=OneWay}" />
                                </StackPanel>
                            </DataTemplate>

                            <DataTemplate DataType="{x:Type model:EntityAbandonedRecrewableDecoratorModel}">
                                <TextBlock Opacity="{Binding SelectionOpacity}" Text="{Binding RecrewCount}" />
                            </DataTemplate>

                            <DataTemplate DataType="{x:Type model:EntityDecoratorModel}">
                                <StackPanel>
                                    <Grid Opacity="{Binding SelectionOpacity}" Visibility="{Binding HealthBarVisibility, FallbackValue=Collapsed}">
                                        <ProgressBar Style="{StaticResource HealthBarDecoratorStyle}" />
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>

                            <DataTemplate DataType="{x:Type model:EntityDemolitionChargeDecoratorModel}">
                                <Button Command="{Binding Issue}"
                                        Content="{esUtility:LocString $11168171}"
                                        IsTabStop="False"
                                        Opacity="{Binding SelectionOpacity}" />
                            </DataTemplate>

                            <DataTemplate DataType="{x:Type model:EntityInProductionDecoratorModel}">
                                <StackPanel>
                                    <TextBlock HorizontalAlignment="Center"
                                               Style="{StaticResource nHUDBaseSmallTextBlockStyle}"
                                               Text="{Binding Entity.HotkeyGroups}" />
                                    <ProgressBar Width="{StaticResource BuildingHealthbarWidth}"
                                                 Height="{StaticResource BuildingHealthbarHeight}"
                                                 Opacity="{Binding SelectionOpacity}"
                                                 Template="{StaticResource ConstructionProgressBar}"
                                                 Visibility="{Binding ProductionVisibility, FallbackValue=Collapsed}"
                                                 Value="{Binding ProductionProgress, Mode=OneWay}" />
                                </StackPanel>
                            </DataTemplate>

                            <DataTemplate DataType="{x:Type model:EntityPickupDecoratorModel}">
                                <Image Width="16" Height="16"
                                       Opacity="{Binding SelectionOpacity}"
                                       Source="{Binding PickupIcon}" />
                            </DataTemplate>

                            <DataTemplate DataType="{x:Type model:EntityProjectileDecoratorModel}">
                                <TextBlock Foreground="Red"
                                           Opacity="{Binding SelectionOpacity}"
                                           Text="{Binding DetonationDelay}" />
                            </DataTemplate>

                            <!--  Sacred Site decorator  -->
                            <DataTemplate DataType="{x:Type model:EntityStrategicPointDecoratorModel}">
                                <Grid Width="54" Height="84">
                                    <Grid.Resources>
                                        <Style x:Key="DecoratorCircularProgressBar"
                                               BasedOn="{StaticResource FrontEndCircularProgressBar}"
                                               TargetType="{x:Type esControls:CircularProgressBar}">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="{x:Type esControls:CircularProgressBar}">
                                                        <Grid MinWidth="{TemplateBinding MinHeight}"
                                                              MinHeight="{TemplateBinding MinHeight}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <esControls:Ring EndAngle="270"
                                                                             Fill="{DynamicResource PrimaryColorBrush}"
                                                                             InnerRadius="{TemplateBinding InnerRadius}"
                                                                             Opacity="0.2"
                                                                             OuterRadius="{TemplateBinding OuterRadius}"
                                                                             StartAngle="-90" Stretch="None" />
                                                            <esControls:Ring x:Name="PART_Indicator"
                                                                             EndAngle="270"
                                                                             Fill="{Binding Color, Converter={StaticResource SolidColorBrushConverter}}"
                                                                             InnerRadius="{TemplateBinding InnerRadius}"
                                                                             OuterRadius="{TemplateBinding OuterRadius}"
                                                                             StartAngle="-90" Stretch="None" />
                                                        </Grid>
                                                        <ControlTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding CaptureState}" Value="{x:Static model:StrategicPointCaptureState.Capturing}">
                                                                <Setter TargetName="PART_Indicator" Property="Fill" Value="{Binding CapturingTeamColour, Converter={StaticResource SolidColorBrushConverter}}" />
                                                            </DataTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>

                                        <sys:Double x:Key="DecoratorMiddleContentBoxStaticHeight">42</sys:Double>
                                        <sys:Double x:Key="DecoratorMiddleContentBoxStaticWidth">32</sys:Double>
                                        <ImageBrush x:Key="DecoratorBannerBrush" ImageSource="pack://application:,,,/WPFGUI;component/icons/sacred_site_state_banner.png" />

                                        <sys:Double x:Key="TopEllipseDiameter">48</sys:Double>
                                        <Thickness x:Key="TopEllipseMarginFromBottom">0,0,0,-6</Thickness>
                                        <sys:Double x:Key="ProgressBarOuterRadius">20</sys:Double>
                                        <sys:Double x:Key="ProgressBarInnerRadius">16</sys:Double>

                                        <sys:Double x:Key="OwnerIconSize">26</sys:Double>
                                        <Thickness x:Key="OwnerIconMargin">-10</Thickness>
                                    </Grid.Resources>

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid x:Name="BottomBannerInfo"
                                          Grid.Row="1"
                                          Width="{DynamicResource DecoratorMiddleContentBoxStaticWidth}"
                                          Height="{DynamicResource DecoratorMiddleContentBoxStaticHeight}"
                                          Background="{DynamicResource DecoratorBannerBrush}"
                                          Visibility="{Binding Entity.Owner, Converter={StaticResource NotNullToVis}}">

                                        <Image Height="{DynamicResource OwnerIconSize}"
                                               Margin="{DynamicResource OwnerIconMargin}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Source="/WPFGUI;component/icons/objectives/objective_complete.png"
                                               Visibility="{Binding Entity.Owner.IsAlly, Converter={StaticResource BoolToVis}, FallbackValue=Hidden}" />

                                        <Image Height="{DynamicResource OwnerIconSize}"
                                               Margin="{DynamicResource OwnerIconMargin}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Source="/WPFGUI;component/icons/captured_by_enemy.png"
                                               Visibility="{Binding Entity.Owner.IsEnemy, Converter={StaticResource BoolToVis}, FallbackValue=Hidden}" />
                                    </Grid>

