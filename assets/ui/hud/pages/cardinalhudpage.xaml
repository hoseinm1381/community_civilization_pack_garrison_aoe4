                                        </StackPanel>
                                        <StackPanel HorizontalAlignment="Stretch">
                                            <TextBlock Margin="0,0,0,10" HorizontalAlignment="Center"
                                                       Style="{StaticResource nHUDBodyTextBlockStyle}"
                                                       Text="{utility:LocString $11194862}" />

                                            <ProgressBar Width="134" Height="4"
                                                         Margin="0,0,0,12"
                                                         Minimum="0" RenderTransformOrigin="0.5, 0.5"
                                                         Template="{StaticResource MonkConversionProgressBarTemplate}"
                                                         Value="{Binding Progress, Mode=OneWay}">
                                                <ProgressBar.Background>
                                                    <SolidColorBrush Color="{Binding Owner.RelationshipColor}" />
                                                </ProgressBar.Background>
                                            </ProgressBar>
                                        </StackPanel>
                                    </Grid>-->

                                    <!--  held squads indicator  -->
