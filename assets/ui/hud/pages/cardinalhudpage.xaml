                                                            <Binding Path="PlacementTarget.DataContext" RelativeSource="{RelativeSource Self}" />
                                                        </ToolTip.Content>
                                                        <ToolTip.ContentTemplate>
                                                            <StaticResource ResourceKey="UnitTooltipTemplate" />
                                                        </ToolTip.ContentTemplate>
                                                    </ToolTip>
                                                </Button.ToolTip>
