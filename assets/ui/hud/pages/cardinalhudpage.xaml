                                            <MultiBinding Converter="{StaticResource IsTaggedConverter}" ConverterParameter="RotateCameraRightButton">
                                                <Binding Path="TagVersion" />
                                            </MultiBinding>
                                        </esControls:TagAdorner.IsTagged>
                                        <esControls:TagAdorner.Data>
                                            <MultiBinding Converter="{StaticResource TagDataConverter}" ConverterParameter="RotateCameraRightButton">
